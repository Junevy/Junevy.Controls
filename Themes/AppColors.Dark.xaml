<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 程序主背景色 -->
    <Color x:Key="Theme.BackgroundColor">#0B1220</Color>
    <!-- 卡片和控件主表面色 -->
    <Color x:Key="Theme.SurfaceColor">#111A2B</Color>
    <!-- 次级表面色 -->
    <Color x:Key="Theme.SurfaceAltColor">#162133</Color>
    <!-- 悬浮态背景色 -->
    <Color x:Key="Theme.SurfaceHoverColor">#1A2940</Color>
    <!-- 按下态背景色 -->
    <Color x:Key="Theme.SurfacePressedColor">#223451</Color>
    <!-- 选中态背景色 -->
    <Color x:Key="Theme.SurfaceSelectedColor">#1B3152</Color>
    <!-- 主品牌色 -->
    <Color x:Key="Theme.PrimaryColor">#60A5FA</Color>
    <!-- 主品牌悬浮色 -->
    <Color x:Key="Theme.PrimaryHoverColor">#3B82F6</Color>
    <!-- 主品牌按下色 -->
    <Color x:Key="Theme.PrimaryPressedColor">#2563EB</Color>
    <!-- 主品牌浅底色 -->
    <Color x:Key="Theme.PrimarySubtleColor">#15263F</Color>
    <!-- 辅助强调色 -->
    <Color x:Key="Theme.SecondaryColor">#A78BFA</Color>
    <!-- 常规边框色 -->
    <Color x:Key="Theme.BorderColor">#24344D</Color>
    <!-- 强调边框色 -->
    <Color x:Key="Theme.BorderStrongColor">#38506E</Color>
    <!-- 焦点高亮色 -->
    <Color x:Key="Theme.FocusColor">#93C5FD</Color>
    <!-- 主文本色 -->
    <Color x:Key="Theme.TextPrimaryColor">#E5EEF9</Color>
    <!-- 次文本色 -->
    <Color x:Key="Theme.TextSecondaryColor">#A5B4C7</Color>
    <!-- 弱化文本色 -->
    <Color x:Key="Theme.TextTertiaryColor">#7E90A8</Color>
    <!-- 主色背景上的文本色 -->
    <Color x:Key="Theme.TextOnPrimaryColor">#08111F</Color>
    <!-- 禁用背景色 -->
    <Color x:Key="Theme.DisabledSurfaceColor">#162131</Color>
    <!-- 禁用边框色 -->
    <Color x:Key="Theme.DisabledBorderColor">#223149</Color>
    <!-- 禁用文本色 -->
    <Color x:Key="Theme.DisabledForegroundColor">#72839A</Color>
    <!-- 成功状态色 -->
    <Color x:Key="Theme.SuccessColor">#4ADE80</Color>
    <!-- 成功悬浮色 -->
    <Color x:Key="Theme.SuccessHoverColor">#22C55E</Color>
    <!-- 警告状态色 -->
    <Color x:Key="Theme.WarningColor">#FBBF24</Color>
    <!-- 警告悬浮色 -->
    <Color x:Key="Theme.WarningHoverColor">#F59E0B</Color>
    <!-- 危险状态色 -->
    <Color x:Key="Theme.DangerColor">#F87171</Color>
    <!-- 危险悬浮色 -->
    <Color x:Key="Theme.DangerHoverColor">#EF4444</Color>
    <!-- 阴影颜色 -->
    <Color x:Key="Theme.ShadowColor">#50040A13</Color>

    <SolidColorBrush x:Key="Theme.BackgroundBrush" Color="{StaticResource Theme.BackgroundColor}" />
    <SolidColorBrush x:Key="Theme.SurfaceBrush" Color="{StaticResource Theme.SurfaceColor}" />
    <SolidColorBrush x:Key="Theme.SurfaceAltBrush" Color="{StaticResource Theme.SurfaceAltColor}" />
    <SolidColorBrush x:Key="Theme.SurfaceHoverBrush" Color="{StaticResource Theme.SurfaceHoverColor}" />
    <SolidColorBrush x:Key="Theme.SurfacePressedBrush" Color="{StaticResource Theme.SurfacePressedColor}" />
    <SolidColorBrush x:Key="Theme.SurfaceSelectedBrush" Color="{StaticResource Theme.SurfaceSelectedColor}" />
    <SolidColorBrush x:Key="Theme.PrimaryBrush" Color="{StaticResource Theme.PrimaryColor}" />
    <SolidColorBrush x:Key="Theme.PrimaryHoverBrush" Color="{StaticResource Theme.PrimaryHoverColor}" />
    <SolidColorBrush x:Key="Theme.PrimaryPressedBrush" Color="{StaticResource Theme.PrimaryPressedColor}" />
    <SolidColorBrush x:Key="Theme.PrimarySubtleBrush" Color="{StaticResource Theme.PrimarySubtleColor}" />
    <SolidColorBrush x:Key="Theme.SecondaryBrush" Color="{StaticResource Theme.SecondaryColor}" />
    <SolidColorBrush x:Key="Theme.BorderBrush" Color="{StaticResource Theme.BorderColor}" />
    <SolidColorBrush x:Key="Theme.BorderStrongBrush" Color="{StaticResource Theme.BorderStrongColor}" />
    <SolidColorBrush x:Key="Theme.FocusBrush" Color="{StaticResource Theme.FocusColor}" />
    <SolidColorBrush x:Key="Theme.TextPrimaryBrush" Color="{StaticResource Theme.TextPrimaryColor}" />
    <SolidColorBrush x:Key="Theme.TextSecondaryBrush" Color="{StaticResource Theme.TextSecondaryColor}" />
    <SolidColorBrush x:Key="Theme.TextTertiaryBrush" Color="{StaticResource Theme.TextTertiaryColor}" />
    <SolidColorBrush x:Key="Theme.TextOnPrimaryBrush" Color="{StaticResource Theme.TextOnPrimaryColor}" />
    <SolidColorBrush x:Key="Theme.DisabledSurfaceBrush" Color="{StaticResource Theme.DisabledSurfaceColor}" />
    <SolidColorBrush x:Key="Theme.DisabledBorderBrush" Color="{StaticResource Theme.DisabledBorderColor}" />
    <SolidColorBrush x:Key="Theme.DisabledForegroundBrush" Color="{StaticResource Theme.DisabledForegroundColor}" />
    <SolidColorBrush x:Key="Theme.SuccessBrush" Color="{StaticResource Theme.SuccessColor}" />
    <SolidColorBrush x:Key="Theme.SuccessHoverBrush" Color="{StaticResource Theme.SuccessHoverColor}" />
    <SolidColorBrush x:Key="Theme.WarningBrush" Color="{StaticResource Theme.WarningColor}" />
    <SolidColorBrush x:Key="Theme.WarningHoverBrush" Color="{StaticResource Theme.WarningHoverColor}" />
    <SolidColorBrush x:Key="Theme.DangerBrush" Color="{StaticResource Theme.DangerColor}" />
    <SolidColorBrush x:Key="Theme.DangerHoverBrush" Color="{StaticResource Theme.DangerHoverColor}" />
    <SolidColorBrush x:Key="Theme.ShadowBrush" Color="{StaticResource Theme.ShadowColor}" />

    <CornerRadius x:Key="Theme.SmallCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="Theme.ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="Theme.LargeCornerRadius">12</CornerRadius>
    <Thickness x:Key="Theme.ControlPadding">12,6</Thickness>
    <Thickness x:Key="Theme.ContentMargin">8,4</Thickness>

    <DropShadowEffect x:Key="Theme.PopupShadow"
                      BlurRadius="20"
                      Direction="270"
                      Opacity="0.32"
                      ShadowDepth="8"
                      Color="{StaticResource Theme.ShadowColor}" />

    <SolidColorBrush x:Key="AppColor" Color="{StaticResource Theme.PrimaryColor}" />
    <SolidColorBrush x:Key="SubAppColor" Color="{StaticResource Theme.PrimarySubtleColor}" />
    <SolidColorBrush x:Key="BoderIndicatorcolor" Color="{StaticResource Theme.PrimaryHoverColor}" />
    <SolidColorBrush x:Key="BorderBrushColor" Color="{StaticResource Theme.BorderColor}" />
    <SolidColorBrush x:Key="TextFillColor" Color="{StaticResource Theme.TextPrimaryColor}" />
    <SolidColorBrush x:Key="SubTextFillColor" Color="{StaticResource Theme.TextSecondaryColor}" />
    <SolidColorBrush x:Key="DarkTextFillColor" Color="{StaticResource Theme.TextOnPrimaryColor}" />
    <SolidColorBrush x:Key="IndicatorColor" Color="{StaticResource Theme.SurfaceHoverColor}" />
    <SolidColorBrush x:Key="DangerousOptionColor" Color="{StaticResource Theme.DangerColor}" />
    <SolidColorBrush x:Key="WarnColor" Color="{StaticResource Theme.WarningColor}" />
    <SolidColorBrush x:Key="DisabledColor" Color="{StaticResource Theme.DisabledBorderColor}" />
    <SolidColorBrush x:Key="DisabledBackgroundColor" Color="{StaticResource Theme.DisabledSurfaceColor}" />
    <SolidColorBrush x:Key="DisabledForegroundColor" Color="{StaticResource Theme.DisabledForegroundColor}" />
    <SolidColorBrush x:Key="ControlsForeground" Color="{StaticResource Theme.BorderStrongColor}" />
    <SolidColorBrush x:Key="PressedBackground" Color="{StaticResource Theme.SurfacePressedColor}" />
    <SolidColorBrush x:Key="SubBackground" Color="{StaticResource Theme.SurfaceColor}" />
    <SolidColorBrush x:Key="MainBackground" Color="{StaticResource Theme.BackgroundColor}" />
</ResourceDictionary>
