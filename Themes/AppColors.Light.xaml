    <SolidColorBrush x:Key="Theme.Brush.Surface.Raised" Color="{StaticResource Palette.Chalk.0}" />
    <SolidColorBrush x:Key="Theme.Brush.Surface.Sunken" Color="{StaticResource Palette.Chalk.100}" />
    <SolidColorBrush x:Key="Theme.Brush.Surface.Overlay" Color="{StaticResource Palette.Chalk.0}" />
    <SolidColorBrush x:Key="Theme.Brush.Surface.Hover" Color="{StaticResource Palette.Chalk.75}" />
    <SolidColorBrush x:Key="Theme.Brush.Surface.Pressed" Color="{StaticResource Palette.Chalk.100}" />
