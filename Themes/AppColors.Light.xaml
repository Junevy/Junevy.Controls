    <Color x:Key="Theme.Color.Border.Subtle">#D5DFE9</Color>  <!--  = Palette.Chalk.150  -->
    <Color x:Key="Theme.Color.Border.Strong">#5C7089</Color>  <!--  = Palette.Chalk.550  -->
