    <Color x:Key="Palette.Green.200">#C0E8C9</Color>
    <Color x:Key="Palette.Green.300">#6DD38C</Color>
    <Color x:Key="Palette.Green.400">#58C278</Color>
    <Color x:Key="Palette.Green.500">#159A51</Color>
    <Color x:Key="Palette.Green.600">#057E42</Color>
    <Color x:Key="Palette.Green.700">#126A39</Color>
    <Color x:Key="Palette.Green.950">#173823</Color>

