    <SolidColorBrush x:Key="Theme.Brush.Status.SuccessHover" Color="{StaticResource Palette.Green.700}" />
    <SolidColorBrush x:Key="Theme.Brush.Status.SuccessSubtle" Color="{StaticResource Palette.Green.100}" />
    <SolidColorBrush x:Key="Theme.Brush.Status.Warning" Color="{StaticResource Palette.Amber.600}" />
    <SolidColorBrush x:Key="Theme.Brush.Status.WarningHover" Color="{StaticResource Palette.Amber.700}" />
