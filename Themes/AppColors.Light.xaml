    <SolidColorBrush x:Key="Theme.Brush.Text.OnAccent" Color="{StaticResource Palette.Chalk.0}" />

    <!--  边框  -->
    <SolidColorBrush x:Key="Theme.Brush.Border.Default" Color="{StaticResource Palette.Chalk.400}" />
    <SolidColorBrush x:Key="Theme.Brush.Border.Subtle" Color="{StaticResource Palette.Chalk.150}" />
    <SolidColorBrush x:Key="Theme.Brush.Border.Strong" Color="{StaticResource Palette.Chalk.550}" />
    <SolidColorBrush x:Key="Theme.Brush.Border.Focus" Color="{StaticResource Palette.Coating.600}" />

    <!--  主色 / 次色  -->
    <SolidColorBrush x:Key="Theme.Brush.Accent.Primary" Color="{StaticResource Palette.Cobalt.600}" />
    <SolidColorBrush x:Key="Theme.Brush.Accent.PrimaryHover" Color="{StaticResource Palette.Cobalt.700}" />
    <SolidColorBrush x:Key="Theme.Brush.Accent.PrimaryPressed" Color="{StaticResource Palette.Cobalt.800}" />
