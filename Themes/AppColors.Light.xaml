    <Color x:Key="Palette.Chalk.300">#B0B7BE</Color>
    <Color x:Key="Palette.Chalk.400">#8C939C</Color>
    <Color x:Key="Palette.Chalk.500">#808891</Color>
    <Color x:Key="Palette.Chalk.550">#686F79</Color>
    <Color x:Key="Palette.Chalk.600">#60666E</Color>
