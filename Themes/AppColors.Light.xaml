    <Color x:Key="Palette.Red.300">#EE7B7B</Color>
    <Color x:Key="Palette.Red.350">#F29C9C</Color>
    <Color x:Key="Palette.Red.400">#E4646A</Color>
    <Color x:Key="Palette.Red.500">#C33A3A</Color>
    <Color x:Key="Palette.Red.600">#A82828</Color>
    <Color x:Key="Palette.Red.700">#8A1F1F</Color>
    <Color x:Key="Palette.Red.950">#4E1C1C</Color>

    <!--  投影、遮罩与禁用蒙层的载体色带 alpha，且两主题取值不同，故同属原语层  -->
    <Color x:Key="Palette.Effect.Shadow">#26070B10</Color>
    <Color x:Key="Palette.Overlay.Backdrop">#99070B10</Color>
    <Color x:Key="Palette.State.DisabledVeil">#A0FFFFFF</Color>

    <!--
        ============================================================
        角色色 Theme.Color.* — 兼容层，逐条镜像 Chalk 原语
        ============================================================
    -->

    <!--  背景  -->
    <Color x:Key="Theme.Color.Background.App">#EEF3F9</Color>  <!--  = Palette.Chalk.50  -->
    <Color x:Key="Theme.Color.Background.Subtle">#EAF1F7</Color>  <!--  = Palette.Chalk.75  -->
    <Color x:Key="Theme.Color.Background.Second">#DFE7EF</Color>  <!--  = Palette.Chalk.100  -->
