    <Color x:Key="Theme.Color.TransparentBackground.Alt">#D5DFE9</Color>  <!--  = Palette.Chalk.150  -->
    <Color x:Key="Theme.Color.Effect.Shadow">#26070B10</Color>  <!--  = Palette.Effect.Shadow  -->
    <Color x:Key="Theme.Color.Overlay.Backdrop">#99070B10</Color>  <!--  = Palette.Overlay.Backdrop  -->
