    <Color x:Key="Palette.Green.700">#0F6036</Color>
    <Color x:Key="Palette.Green.950">#0E3526</Color>

    <!--  Amber — 警告态。  -->
    <Color x:Key="Palette.Amber.100">#FCF0D6</Color>
    <Color x:Key="Palette.Amber.200">#F7DDA6</Color>
    <Color x:Key="Palette.Amber.300">#EDC066</Color>
    <Color x:Key="Palette.Amber.400">#DFA432</Color>
    <Color x:Key="Palette.Amber.500">#C08412</Color>
    <Color x:Key="Palette.Amber.600">#916308</Color>
    <Color x:Key="Palette.Amber.700">#7A4A04</Color>
    <Color x:Key="Palette.Amber.950">#3E2A08</Color>

    <!--  Red — 危险态。  -->
