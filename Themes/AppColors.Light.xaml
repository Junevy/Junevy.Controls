    <Color x:Key="Palette.Chalk.25">#FAFCFE</Color>
    <Color x:Key="Palette.Chalk.50">#EEF3F9</Color>
    <Color x:Key="Palette.Chalk.75">#EAF1F7</Color>
    <Color x:Key="Palette.Chalk.100">#DFE7EF</Color>
    <Color x:Key="Palette.Chalk.150">#D5DFE9</Color>
    <Color x:Key="Palette.Chalk.200">#C3D0DE</Color>
    <Color x:Key="Palette.Chalk.300">#A7B8CB</Color>
    <Color x:Key="Palette.Chalk.400">#8294AB</Color>
    <Color x:Key="Palette.Chalk.500">#75899F</Color>
    <Color x:Key="Palette.Chalk.550">#5C7089</Color>
    <Color x:Key="Palette.Chalk.600">#56677B</Color>
    <Color x:Key="Palette.Chalk.700">#3E5065</Color>
    <Color x:Key="Palette.Chalk.800">#1C2937</Color>
    <Color x:Key="Palette.Chalk.900">#111A24</Color>
    <Color x:Key="Palette.Chalk.1000">#070B10</Color>

    <!--  Slate — 与 Chalk 同一条线的另一端读起：Slate.0 与 Chalk.1000 是同一滴墨。  -->
    <Color x:Key="Palette.Slate.0">#070B10</Color>
    <Color x:Key="Palette.Slate.25">#0D1218</Color>
    <Color x:Key="Palette.Slate.50">#121922</Color>
    <Color x:Key="Palette.Slate.75">#1A222D</Color>
    <Color x:Key="Palette.Slate.100">#212B38</Color>
    <Color x:Key="Palette.Slate.125">#283340</Color>
    <Color x:Key="Palette.Slate.150">#2E3A48</Color>
    <Color x:Key="Palette.Slate.175">#3D4B5C</Color>
    <Color x:Key="Palette.Slate.200">#4B5A6C</Color>
    <Color x:Key="Palette.Slate.250">#5F7185</Color>
    <Color x:Key="Palette.Slate.400">#8D9CB1</Color>
    <Color x:Key="Palette.Slate.500">#A2B1C4</Color>
    <Color x:Key="Palette.Slate.700">#C2CFDE</Color>
    <Color x:Key="Palette.Slate.800">#D8E1EC</Color>
    <Color x:Key="Palette.Slate.900">#EEF3F9</Color>
    <Color x:Key="Palette.Slate.1000">#FFFFFF</Color>

    <!--  Cobalt — 主色 — 光学蓝。按钮、选中、进度、活动指示。  -->
    <Color x:Key="Palette.Cobalt.50">#EFF6FF</Color>
    <Color x:Key="Palette.Cobalt.100">#DCEBFD</Color>
    <Color x:Key="Palette.Cobalt.200">#BFD8FA</Color>
    <Color x:Key="Palette.Cobalt.300">#93BFF3</Color>
    <Color x:Key="Palette.Cobalt.400">#639BE9</Color>
    <Color x:Key="Palette.Cobalt.450">#4E90E8</Color>
    <Color x:Key="Palette.Cobalt.500">#3E82D6</Color>
    <Color x:Key="Palette.Cobalt.600">#1F5FC4</Color>
    <Color x:Key="Palette.Cobalt.700">#174CA4</Color>
    <Color x:Key="Palette.Cobalt.800">#123C82</Color>
    <Color x:Key="Palette.Cobalt.900">#0D2A5C</Color>
    <Color x:Key="Palette.Cobalt.950">#16304D</Color>

    <!--  Coating — 次色 — 镜头镀膜的青。只承担「信息」与「焦点」，绝不当第二个主色。  -->
    <Color x:Key="Palette.Coating.50">#ECF8FB</Color>
    <Color x:Key="Palette.Coating.100">#D3EFF5</Color>
    <Color x:Key="Palette.Coating.200">#A9E0EB</Color>
    <Color x:Key="Palette.Coating.300">#74CBDC</Color>
    <Color x:Key="Palette.Coating.400">#3FB4CB</Color>
    <Color x:Key="Palette.Coating.500">#1795B0</Color>
    <Color x:Key="Palette.Coating.600">#0B7C91</Color>
    <Color x:Key="Palette.Coating.700">#086475</Color>
    <Color x:Key="Palette.Coating.800">#07505E</Color>
