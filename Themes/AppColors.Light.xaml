    <Color x:Key="Theme.Color.Status.Disable">#A7B8CB</Color>  <!--  = Palette.Chalk.300  -->

    <!--
        ============================================================
        角色画刷 Theme.Brush.* — 控件模板只认这一层
        ============================================================
    -->

    <!--  背景  -->
    <SolidColorBrush x:Key="Theme.Brush.Background.App" Color="{StaticResource Palette.Chalk.50}" />
    <SolidColorBrush x:Key="Theme.Brush.Background.Subtle" Color="{StaticResource Palette.Chalk.75}" />
    <SolidColorBrush x:Key="Theme.Brush.Background.Second" Color="{StaticResource Palette.Chalk.100}" />
    <SolidColorBrush x:Key="Theme.Brush.Background.Third" Color="{StaticResource Palette.Chalk.150}" />

