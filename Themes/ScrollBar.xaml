<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        主题滚动条：细长、圆角滑块、无箭头按钮，避免暗色背景上出现系统白色滚动条。

        两个方向必须分别处理，依据是 WPF 官方约定（ScrollBar.OnScrollCommand 只认本方向的命令，
        ScrollBar 的 Track 方向与 IsDirectionReversed 也按方向不同）：
          · 竖向 —— 减小端在上、增大端在下，Track.IsDirectionReversed=True， 命令 PageUp  / PageDown；
          · 横向 —— 减小端在左、增大端在右，Track.IsDirectionReversed=False，命令 PageLeft/PageRight。
        因此不做「一套竖模板 + LayoutTransform 翻转」这类取巧，两个方向各有一套官方式的模板。
    -->

    <ControlTemplate x:Key="DefaultScrollBarThumbTemplate" TargetType="Thumb">
        <Border
            x:Name="ThumbBorder"
            Background="{DynamicResource Theme.Brush.ScrollBar.Thumb}"
            CornerRadius="4"
            SnapsToDevicePixels="True" />
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource Theme.Brush.ScrollBar.ThumbHover}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource Theme.Brush.ScrollBar.ThumbHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource Theme.Brush.State.DisabledSurface}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  轨道空白处的翻页热区：透明但仍参与命中测试  -->
    <ControlTemplate x:Key="DefaultScrollBarPageButtonTemplate" TargetType="RepeatButton">
        <Border Background="Transparent" SnapsToDevicePixels="True" />
    </ControlTemplate>

    <ControlTemplate x:Key="DefaultVerticalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                <Track.DecreaseRepeatButton>
                    <RepeatButton
                        Command="{x:Static ScrollBar.PageUpCommand}"
                        Focusable="False"
                        Template="{StaticResource DefaultScrollBarPageButtonTemplate}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb x:Name="Thumb" Template="{StaticResource DefaultScrollBarThumbTemplate}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton
                        Command="{x:Static ScrollBar.PageDownCommand}"
                        Focusable="False"
                        Template="{StaticResource DefaultScrollBarPageButtonTemplate}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="DefaultHorizontalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" IsDirectionReversed="False" Orientation="Horizontal">
                <Track.DecreaseRepeatButton>
                    <RepeatButton
                        Command="{x:Static ScrollBar.PageLeftCommand}"
                        Focusable="False"
                        Template="{StaticResource DefaultScrollBarPageButtonTemplate}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb x:Name="Thumb" Template="{StaticResource DefaultScrollBarThumbTemplate}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton
                        Command="{x:Static ScrollBar.PageRightCommand}"
                        Focusable="False"
                        Template="{StaticResource DefaultScrollBarPageButtonTemplate}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template" Value="{StaticResource DefaultVerticalScrollBarTemplate}" />
        <!--
            宽度/高度以及对应的 Min* 都要写入：系统主题样式同样会设置这几个属性
            （竖向 MinWidth、横向 MinHeight 均为系统滚动条厚度），只设 Width/Height 会被 Min* 顶掉。
        -->
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="8" />
                <Setter Property="MinWidth" Value="8" />
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Template" Value="{StaticResource DefaultHorizontalScrollBarTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
