<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        悬停/按压统一透明度反馈资源（控件库通用）。
        背景暴露给用户的按钮/卡片类控件（CardButton、ToolBarItem、ToolboxItem、ToolItem 等）
        悬停/按压不再覆盖固定底色，而是整体降低透明度，避免鲜艳背景（如红色）被灰底覆盖；
        中性表面上的列表/菜单项（MenuBar、ContextMenu、ListBox、TreeMenu 等）仍使用
        Surface.Hover 灰底高亮作为悬停 affordance，不参与本方案。
        Button 控件使用独立的 Button.Hover.Opacity / Button.Pressed.Opacity / Button.Disabled.Opacity。
    -->
    <sys:Double x:Key="Control.Hover.Opacity">0.8</sys:Double>
    <sys:Double x:Key="Control.Pressed.Opacity">0.65</sys:Double>

</ResourceDictionary>
