<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Menu">

    <!--
        TreeView：节点由 TreeMenuItem（POCO 数据模型）+ HierarchicalDataTemplate 驱动。
        共享样式 DefaultTreeViewStyle 以官方 TreeView 为 TargetType：合并 Themes/Generic.xaml 后，
        官方 <TreeView> 与库内 jv:TreeView 经各自的隐式样式继承同一份外观。
        jv 专有能力（DisplayMode / NavigateCommand / 悬停与选中画刷）经 atc:TreeViewAssist 附加属性承载，
        两类实例经同一绑定路径读取；展开图标为 ExpanderPanel 同款旋转箭头（iconfont 字形，非开关控件）。
        IconFont.xaml / DefaultFocusStyle.xaml 经 DynamicResource 使用，由 Themes/Generic.xaml 统一提供，不再重复合并。
    -->

    <!--  Normal 模式条目模板：图标 + 标题。字体与前景色继承自宿主 TreeView，图标字体取 atc:Icon.FontFamily。  -->
    <HierarchicalDataTemplate x:Key="TreeViewNormalItemTemplate" ItemsSource="{Binding Children}">
        <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ContentPresenter
                x:Name="Icon"
                Grid.Column="0"
                Margin="5"
                VerticalAlignment="Center"
                Content="{Binding Icon}"
                TextElement.FontFamily="{Binding (atc:Icon.FontFamily), RelativeSource={RelativeSource AncestorType=TreeView}}" />

            <TextBlock
                x:Name="Title"
                Grid.Column="1"
                Margin="5"
                VerticalAlignment="Center"
                Text="{Binding Title}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <HierarchicalDataTemplate.Triggers>
            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Title}" Value="{x:Null}">
                <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Title}" Value="">
                <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>

    <!--  Icon 模式条目模板：图标字号取 atc:Icon.IconSize，标题间距与 Normal 模式一致。  -->
    <HierarchicalDataTemplate x:Key="TreeViewIconItemTemplate" ItemsSource="{Binding Children}">
        <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ContentPresenter
                x:Name="Icon"
                Grid.Column="0"
                Margin="5"
                VerticalAlignment="Center"
                Content="{Binding Icon}"
                TextElement.FontFamily="{Binding (atc:Icon.FontFamily), RelativeSource={RelativeSource AncestorType=TreeView}}"
                TextElement.FontSize="{Binding (atc:Icon.IconSize), RelativeSource={RelativeSource AncestorType=TreeView}}" />

            <TextBlock
                x:Name="Title"
                Grid.Column="1"
                Margin="10"
                VerticalAlignment="Center"
                Text="{Binding Title}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <HierarchicalDataTemplate.Triggers>
            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Title}" Value="{x:Null}">
                <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Title}" Value="">
                <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>

    <!--
        容器样式（Normal / Icon 两模式共用一套模板，经 DataTrigger 切换）：
        - IsExpanded / IsSelected 与 TreeMenuItem 同名属性双向绑定，状态落在数据模型上，虚拟化后不丢失；
        - ItemsPanel 换成 VirtualizingStackPanel，使嵌套层级与根级一样参与虚拟化；
          VirtualizationMode 用 Standard——TreeViewItem 自带展开/选中状态，Recycling 复用容器时
          TwoWay 绑定会把上一节点的状态串写到新节点（实测初始展开状态被改写），WPF 官方树形虚拟化亦不推荐 Recycling；
        - ItemsPresenter 的 MaxWidth 绑定本级内容 Border 宽度，子级不会向上撑大 TreeView，超出部分被截断。
    -->
    <Style x:Key="TreeViewItemContainerStyle" TargetType="TreeViewItem">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <!--  条目前景跟随宿主 TreeView.Foreground（默认样式给宿主的是随主题的 Text.Secondary，宿主在
              实例上覆盖时条目同步跟随）。系统 TreeViewItem 默认样式钉死恒黑 ControlTextBrush 且优先级
              高于属性继承，必须显式设值才能盖过它；经 AncestorType 绑定宿主与模板触发器同一模式。  -->
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeView}}" />
        <Setter Property="atc:ExpanderBehavior.Enable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Standard" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  展开图标：ExpanderPanel 同款旋转箭头（iconfont 字形 E650，展开旋转 90°），
                                  宿主为 WPF 基类 ToggleButton（无开关外观），点击切换展开状态。  -->
                            <ToggleButton
                                x:Name="ExpanderButton"
                                Grid.Column="0"
                                Width="16"
                                Height="16"
                                Margin="2,0"
                                VerticalAlignment="Center"
                                ClickMode="Press"
                                Focusable="False"
                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <TextBlock
                                            x:Name="Chevron"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{DynamicResource IconFont}"
                                            FontSize="10"
                                            Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                                            RenderTransformOrigin="0.5,0.5"
                                            Text="&#xE650;">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Border
                                x:Name="Indicator"
                                Grid.Column="0"
                                Width="3"
                                Margin="1,0"
                                Background="{DynamicResource Theme.Brush.Accent.Primary}"
                                CornerRadius="{DynamicResource Theme.SmallCornerRadius}"
                                Visibility="Collapsed" />

                            <Border
                                x:Name="Root"
                                Grid.Column="1"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Theme.SmallCornerRadius}">
                                <ContentPresenter
                                    ContentSource="Header"
                                    RecognizesAccessKey="True"
                                    TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </Grid>

                        <ItemsPresenter
                            x:Name="ItemHost"
                            MaxWidth="{Binding ElementName=Root, Path=ActualWidth}"
                            ClipToBounds="True" />
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <!--  悬停高亮：IsMouseOver 会沿可视子树向上传染（子行是父 TreeViewItem 的视觉后代，
                              悬停子行时父/祖先的 IsMouseOver 也为真），叠加「子级承载区 ItemHost 不悬停」条件
                              过滤——鼠标在子行上时父行的 ItemHost 必然处于悬停中，父/祖先行不再误高亮  -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding ElementName=ItemHost, Path=IsMouseOver}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="{Binding (atc:TreeViewAssist.ItemHoverBackground), RelativeSource={RelativeSource AncestorType=TreeView}}" />
                        </MultiDataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{Binding (atc:TreeViewAssist.SelectedItemBackground), RelativeSource={RelativeSource AncestorType=TreeView}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.Brush.State.DisabledSurface}" />
                        </Trigger>

                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="ExpanderButton" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <!--  Icon 模式折叠展开箭头，所有行隐藏占位指示条槽位（预留宽度，选中时不跳动）；
                              accent 指示条仅标示「选中的带子项节点」——蓝色提示 = 真实选中，非选中分支不显示，
                              避免整组分支同时带蓝条被误读为子级全部选中。  -->
                        <DataTrigger Binding="{Binding (atc:TreeViewAssist.DisplayMode), RelativeSource={RelativeSource AncestorType=TreeView}}" Value="Icon">
                            <Setter TargetName="ExpanderButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Hidden" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding (atc:TreeViewAssist.DisplayMode), RelativeSource={RelativeSource AncestorType=TreeView}}" Value="Icon" />
                                <Condition Binding="{Binding HasItems, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        共享默认样式（TargetType=官方 TreeView）：宿主 DP 由 atc:TreeViewAssist 附加属性承载，
        经样式 Setter 提供主题默认值，官方实例与 jv:TreeView 实例均可逐实例覆盖。
    -->
    <Style x:Key="DefaultTreeViewStyle" TargetType="{x:Type TreeView}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Secondary}" />
        <Setter Property="atc:TreeViewAssist.ItemHoverBackground" Value="{DynamicResource Theme.Brush.Surface.Hover}" />
        <Setter Property="atc:TreeViewAssist.SelectedItemBackground" Value="{DynamicResource Theme.Brush.Surface.Sunken}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Standard" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource TreeViewItemContainerStyle}" />
        <Setter Property="ItemTemplate" Value="{StaticResource TreeViewNormalItemTemplate}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeView}">
                    <ScrollViewer
                        CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                        Focusable="False"
                        HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                        VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                        <Border
                            Background="{DynamicResource Theme.Brush.Surface.Base}"
                            BorderBrush="{DynamicResource Theme.Brush.Border.Default}"
                            BorderThickness="1"
                            ClipToBounds="True"
                            CornerRadius="{DynamicResource Theme.ControlCornerRadius}">
                            <ItemsPresenter />
                        </Border>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <!--  DisplayMode 经附加属性承载，官方 TreeView 与 jv:TreeView 均可切换 Icon 模式  -->
            <Trigger Property="atc:TreeViewAssist.DisplayMode" Value="Icon">
                <Setter Property="ItemTemplate" Value="{StaticResource TreeViewIconItemTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  隐式样式（官方类型）：合并 Generic.xaml 后，<TreeView> 自动获得本库样式  -->
    <Style BasedOn="{StaticResource DefaultTreeViewStyle}" TargetType="{x:Type TreeView}" />

    <!--  隐式样式（派生类型）：jv:TreeView 复用同一模板，由实例依赖属性驱动扩展能力  -->
    <Style BasedOn="{StaticResource DefaultTreeViewStyle}" TargetType="{x:Type local:TreeView}" />

</ResourceDictionary>
