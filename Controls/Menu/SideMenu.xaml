<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties"
    xmlns:cvt="clr-namespace:Junevy.Controls.Converters"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Menu">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls;component/Resources/Font/IconFont.xaml" />
        <ResourceDictionary Source="/Junevy.Controls;component/Generic/Style/DefaultFocusStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <cvt:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <cvt:SideMenuIconFontFamilyConverter x:Key="SideMenuIconFontFamilyConverter" />

    <Style x:Key="SideMenuIconPresenterStyle" TargetType="{x:Type ContentControl}">
        <Setter Property="Width"
                Value="{Binding RelativeSource={RelativeSource AncestorType=local:SideMenu}, Path=(atc:Icon.IconSize)}" />
        <Setter Property="Height"
                Value="{Binding RelativeSource={RelativeSource AncestorType=local:SideMenu}, Path=(atc:Icon.IconSize)}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Content" Value="{Binding Icon}" />
        <Setter Property="FontFamily">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource SideMenuIconFontFamilyConverter}">
                    <Binding RelativeSource="{RelativeSource AncestorType=local:SideMenu}" />
                    <Binding RelativeSource="{RelativeSource AncestorType=local:SideMenu}"
                             Path="FontFamily" />
                    <Binding RelativeSource="{RelativeSource AncestorType=local:SideMenu}"
                             Path="(atc:Icon.FontFamily)" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="FontSize"
                Value="{Binding RelativeSource={RelativeSource AncestorType=local:SideMenu}, Path=(atc:Icon.IconSize)}" />
        <Setter Property="Foreground"
                Value="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" />
        <Setter Property="Visibility"
                Value="{Binding Icon, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Style>

    <!--  horizontal mode / normal style  -->
    <DataTemplate x:Key="DefaultSideMenuStyle" DataType="{x:Type local:MenuItem}">
        <Grid>
            <!-- The indicator overlays the item so it does not offset content. -->
            <Border
                Width="3"
                Margin="0,4"
                HorizontalAlignment="Left"
                Background="{DynamicResource Theme.Brush.Accent.Primary}"
                CornerRadius="2"
                Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <StackPanel
                Margin="8,0"
                VerticalAlignment="Center"
                Orientation="{Binding Orientation}">
                <ContentControl
                    Margin="5"
                    Style="{StaticResource SideMenuIconPresenterStyle}" />

                <TextBlock
                    Margin="5"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    FontSize="{Binding RelativeSource={RelativeSource AncestorType=local:SideMenu}, Path=FontSize}"
                    Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                    Text="{Binding Title}"
                    Visibility="{Binding Title, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!--  icon mode / vertical mode  -->
    <DataTemplate x:Key="IconMenuStyle" DataType="{x:Type local:MenuItem}">
        <Grid>
            <!-- Keep this out of the content layout so an icon stays centered. -->
            <Border
                Width="3"
                Margin="0,4"
                HorizontalAlignment="Left"
                Background="{DynamicResource Theme.Brush.Accent.Primary}"
                CornerRadius="2"
                Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <ContentControl Style="{StaticResource SideMenuIconPresenterStyle}" />

                <TextBlock
                    Margin="0,2,0,0"
                    HorizontalAlignment="Center"
                    FontSize="{Binding RelativeSource={RelativeSource AncestorType=local:SideMenu}, Path=FontSize}"
                    Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                    Text="{Binding Title}"
                    Visibility="{Binding Title, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!--  style  -->
    <Style x:Key="DefaultSideMenu" TargetType="{x:Type local:SideMenu}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="Width" Value="150" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface.Base}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />

        <!--  SideMenu容器  -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SideMenu}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer
                            x:Name="PART_ScrollViewer"
                            CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                            Focusable="False"
                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!--  Items布局  -->
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="{Binding RelativeSource={RelativeSource AncestorType=local:SideMenu}, Path=Orientation}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>

        <!--  Items 容器样式  -->
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="2" />
                    <Setter Property="Height" Value="{Binding RelativeSource={RelativeSource AncestorType=local:SideMenu}, Path=ItemHeight}" />
                    <Setter Property="Background" Value="Transparent" />

                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border
                                    x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{DynamicResource Theme.SmallCornerRadius}">
                                    <ContentPresenter
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        RecognizesAccessKey="True" />
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Hover}" />
                                    </Trigger>

                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Selected}" />
                                    </Trigger>

                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.Brush.State.DisabledSurface}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DefaultSideMenu}" TargetType="{x:Type local:SideMenu}">
        <Style.Triggers>
            <Trigger Property="DisplayMode" Value="Horizontal">
                <Setter Property="ItemTemplate" Value="{StaticResource DefaultSideMenuStyle}" />
            </Trigger>
            <Trigger Property="DisplayMode" Value="Vertical">
                <Setter Property="ItemTemplate" Value="{StaticResource IconMenuStyle}" />
                <Setter Property="Width" Value="60" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
