<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties"
    xmlns:cvt="clr-namespace:Junevy.Controls.Converters"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Menu">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls;component/Resources/Font/IconFont.xaml" />
        <ResourceDictionary Source="/Junevy.Controls;component/Generic/Style/DefaultFocusStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <cvt:BoolToVisibilityConverter x:Key="SideMenuVisibilityConverter" />
    <cvt:SideMenuIconFontFamilyConverter x:Key="SideMenuIconFontFamilyConverter" />

    <!--  图标槽：Min 尺寸随 IconSize（字形按 FontSize 渲染自然占位），非字形图标（Image/Path 等）
          大于 IconSize 时槽位随之撑大、不再被钉死裁切；Foreground 走属性继承（ListBoxItem 触发器
          选中/禁用改前景时自动跟随）。  -->
    <Style x:Key="SideMenuIconPresenterStyle" TargetType="{x:Type ContentControl}">
        <Setter Property="MinWidth"
                Value="{Binding RelativeSource={RelativeSource AncestorType=local:SideMenu}, Path=(atc:Icon.IconSize)}" />
        <Setter Property="MinHeight"
                Value="{Binding RelativeSource={RelativeSource AncestorType=local:SideMenu}, Path=(atc:Icon.IconSize)}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Content" Value="{Binding Icon}" />
        <Setter Property="FontFamily">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource SideMenuIconFontFamilyConverter}">
                    <Binding RelativeSource="{RelativeSource AncestorType=local:SideMenu}" />
                    <Binding RelativeSource="{RelativeSource AncestorType=local:SideMenu}"
                             Path="FontFamily" />
                    <Binding RelativeSource="{RelativeSource AncestorType=local:SideMenu}"
                             Path="(atc:Icon.FontFamily)" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="FontSize"
                Value="{Binding RelativeSource={RelativeSource AncestorType=local:SideMenu}, Path=(atc:Icon.IconSize)}" />
        <Setter Property="Visibility"
                Value="{Binding Icon, Converter={StaticResource SideMenuVisibilityConverter}}" />
    </Style>

    <!--  horizontal mode / normal style：图标与标题横向排列（条目 Orientation 默认）。
          横排用 DockPanel 让标题占满剩余宽度——横向 StackPanel 给子元素的测宽约束是无穷大，
          TextTrimming 永远不会生效；条目 Orientation=Vertical 时经 DataTemplate.Triggers
          切换为纵排 StackPanel（纵排对子元素有宽度约束，截断同样生效）。  -->
    <DataTemplate x:Key="SideMenuHorizontalItemTemplate" DataType="{x:Type local:MenuItem}">
        <Grid>
            <!-- The indicator overlays the item so it does not offset content. -->
            <Border
                Width="3"
                Margin="0,4"
                HorizontalAlignment="Left"
                Background="{DynamicResource Theme.Brush.Accent.Primary}"
                CornerRadius="2"
                Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Converter={StaticResource SideMenuVisibilityConverter}}" />

            <DockPanel
                x:Name="HorizontalHost"
                Margin="8,0"
                VerticalAlignment="Center"
                LastChildFill="True">
                <ContentControl
                    Margin="5"
                    DockPanel.Dock="Left"
                    Style="{StaticResource SideMenuIconPresenterStyle}" />

                <TextBlock
                    Margin="5"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Text="{Binding Title}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding Title, Converter={StaticResource SideMenuVisibilityConverter}}" />
            </DockPanel>

            <StackPanel
                x:Name="VerticalHost"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical"
                Visibility="Collapsed">
                <ContentControl Style="{StaticResource SideMenuIconPresenterStyle}" />

                <TextBlock
                    Margin="0,2,0,0"
                    HorizontalAlignment="Center"
                    Text="{Binding Title}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding Title, Converter={StaticResource SideMenuVisibilityConverter}}" />
            </StackPanel>
        </Grid>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Orientation}" Value="Vertical">
                <Setter TargetName="HorizontalHost" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="VerticalHost" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--  icon mode / vertical mode：图标在上、标题在下。标题超宽省略号截断；
          Title 为空时标题折叠、图标保持居中（图标导航用法）。  -->
    <DataTemplate x:Key="SideMenuVerticalItemTemplate" DataType="{x:Type local:MenuItem}">
        <Grid>
            <!-- Keep this out of the content layout so an icon stays centered. -->
            <Border
                Width="3"
                Margin="0,4"
                HorizontalAlignment="Left"
                Background="{DynamicResource Theme.Brush.Accent.Primary}"
                CornerRadius="2"
                Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Converter={StaticResource SideMenuVisibilityConverter}}" />

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <ContentControl Style="{StaticResource SideMenuIconPresenterStyle}" />

                <TextBlock
                    Margin="0,2,0,0"
                    HorizontalAlignment="Center"
                    Text="{Binding Title}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding Title, Converter={StaticResource SideMenuVisibilityConverter}}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!--  style  -->
    <Style x:Key="DefaultSideMenu" TargetType="{x:Type local:SideMenu}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <!--  像素滚动：偏移不再吸附到条目边界，滚轮补间（SmoothScrolling）才能连续滑动；
              预生成前后各一页容器消除补间中的实体化顿挫；
              平滑滚轮默认开启，实例上设 atc:SmoothScrolling.IsEnabled=False 可单独关闭  -->
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="VirtualizingPanel.CacheLength" Value="1,1" />
        <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page" />
        <Setter Property="atc:SmoothScrolling.IsEnabled" Value="True" />
        <Setter Property="Width" Value="150" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <!--  菜单项文字默认次级（常规导航项),选中项由触发器升为一级——对应
              「标题=一级 / 常规项=次级 / 分组头=三级」的三档文字层级  -->
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Secondary}" />
        <Setter Property="ItemHoverBackground" Value="{DynamicResource Theme.Brush.Surface.Base}" />
        <Setter Property="SelectedItemBackground" Value="{DynamicResource Theme.Brush.Surface.Sunken}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface.Base}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <!--  竖向导航禁用横向滚动：测宽约束自视口逐层传入条目，超宽标题以省略号截断，
              不再把整条导航栏撑出横向滚动条；横向丝带菜单（Orientation=Horizontal）由触发器恢复 Auto  -->
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />

        <!--  SideMenu容器  -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SideMenu}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer
                            x:Name="PART_ScrollViewer"
                            CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                            Focusable="False"
                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!--  Items布局  -->
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="{Binding RelativeSource={RelativeSource AncestorType=local:SideMenu}, Path=Orientation}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>

        <!--  Items 容器样式  -->
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="2" />
                    <Setter Property="Height" Value="{Binding RelativeSource={RelativeSource AncestorType=local:SideMenu}, Path=ItemHeight}" />
                    <Setter Property="Background" Value="Transparent" />
                    <!--  悬停提示与自动化名称随 Title（纯图标导航项的语义来源）；Title 为空时
                          不显示空 ToolTip（ToolTip 置 null，见模板后的 Style.Triggers）  -->
                    <Setter Property="ToolTip" Value="{Binding Title}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />

                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <!--  Root 只做背景层，阴影挂在它身上；内容与其同级，避免 Effect 让文字退出 ClearType  -->
                                <Grid>
                                    <Border
                                        x:Name="Root"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="{DynamicResource Theme.SmallCornerRadius}" />
                                    <ContentPresenter
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        RecognizesAccessKey="True" />
                                </Grid>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{Binding ItemHoverBackground, RelativeSource={RelativeSource AncestorType=local:SideMenu}}" />
                                    </Trigger>

                                    <!--  选中背景经 ItemHoverBackground/SelectedItemBackground 可自定义;
                                          不再有选中阴影(Effect 已移除)  -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{Binding SelectedItemBackground, RelativeSource={RelativeSource AncestorType=local:SideMenu}}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
                                    </Trigger>

                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.Brush.State.DisabledSurface}" />
                                        <Setter TargetName="Root" Property="Effect" Value="{x:Null}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>

                    <!--  Title 为空/null 时不显示空 ToolTip；Icon 与 Title 双空的条目
                          不产生可点击的空白行  -->
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Title}" Value="{x:Null}">
                            <Setter Property="ToolTip" Value="{x:Null}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Title}" Value="">
                            <Setter Property="ToolTip" Value="{x:Null}" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Icon}" Value="{x:Null}" />
                                <Condition Binding="{Binding Title}" Value="" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Icon}" Value="{x:Null}" />
                                <Condition Binding="{Binding Title}" Value="{x:Null}" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>

        <!--  横向丝带菜单（Orientation=Horizontal）恢复横向滚动：条目横向超出视口时滚动而非截断；
              竖向导航保持 Disabled，使超宽标题以省略号截断  -->
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource DefaultSideMenu}" TargetType="{x:Type local:SideMenu}">
        <Style.Triggers>
            <Trigger Property="DisplayMode" Value="Horizontal">
                <Setter Property="ItemTemplate" Value="{StaticResource SideMenuHorizontalItemTemplate}" />
            </Trigger>
            <Trigger Property="DisplayMode" Value="Vertical">
                <Setter Property="ItemTemplate" Value="{StaticResource SideMenuVerticalItemTemplate}" />
                <Setter Property="Width" Value="60" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
