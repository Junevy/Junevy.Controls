<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties"
    xmlns:bt="clr-namespace:Junevy.Controls.Controls.Button"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Menu">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls.Resources;component/Font/IconFont.xaml" />
        <ResourceDictionary Source="/Junevy.Controls;component/Themes/AppColors.xaml" />
        <ResourceDictionary Source="/Junevy.Controls;component/Controls/Menu/SideMenu.xaml" />
        <ResourceDictionary Source="/Junevy.Controls;component/Generic/Style/DefaultFocusStyle.xaml" />
        <ResourceDictionary Source="/Junevy.Controls;component/Controls/Button/Button.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <DataTemplate x:Key="ToolBarStyle" DataType="{x:Type local:MenuItem}">
        <bt:Button
            Width="{Binding Width}"
            Height="{Binding Height}"
            MinWidth="{Binding MinWidth}"
            MinHeight="{Binding MinHeight}"
            Margin="5,0,5,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="Transparent"
            Command="{Binding Command}"
            CommandParameter="{Binding CommandParameter}"
            Content="{Binding Icon}"
            FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:ToolBar}, Path=(atc:Icon.FontFamily)}"
            FontSize="{Binding FontSize}"
            Foreground="{Binding Foreground}"
            ToolTip="{Binding ToolTip}">

            <bt:Button.Template>
                <ControlTemplate>
                    <ContentPresenter
                        x:Name="ContentPresenter"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="{Binding RelativeSource={RelativeSource AncestorType=bt:Button}, Path=Content}"
                        TextElement.FontFamily="{TemplateBinding FontFamily}"
                        TextElement.Foreground="{TemplateBinding Foreground}" />
                </ControlTemplate>
            </bt:Button.Template>
        </bt:Button>
    </DataTemplate>


    <Style
        x:Key="DefaultToolMenu"
        BasedOn="{StaticResource DefaultSideMenu}"
        TargetType="{x:Type local:ToolBar}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Background" Value="{StaticResource SubBackground}" />
        <Setter Property="Foreground" Value="{StaticResource TextFillColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="ItemTemplate" Value="{StaticResource ToolBarStyle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultControlFocusVisualStyle}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ToolBar}">
                    <ScrollViewer
                        Focusable="False"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Hidden">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                            <ItemsPresenter />
                        </Border>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="2" />
                    <Setter Property="Background" Value="Transparent" />

                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border
                                    x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="5">
                                    <ContentPresenter />
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{StaticResource IndicatorColor}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource DefaultToolMenu}" TargetType="{x:Type local:ToolBar}" />

</ResourceDictionary>