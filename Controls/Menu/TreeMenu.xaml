<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties"
    xmlns:bt="clr-namespace:Junevy.Controls.Controls.Button"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Menu">

    <!--
        TreeMenu：节点由 TreeMenuItem（POCO 数据模型）+ HierarchicalDataTemplate 驱动。
        ExpanderButton 样式以 StaticResource 引用，因此保留对 ToggleButton.xaml 的合并；
        DefaultFocusStyle.xaml 经 DynamicResource 使用，由 Themes/Generic.xaml 统一提供，不再重复合并。
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls;component/Controls/Button/ToggleButton.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  Normal 模式条目模板：图标 + 标题。字体与前景色继承自 TreeMenu，图标字体取 atc:Icon.FontFamily。  -->
    <HierarchicalDataTemplate x:Key="TreeMenuNormalItemTemplate" ItemsSource="{Binding Children}">
        <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ContentPresenter
                x:Name="Icon"
                Grid.Column="0"
                Margin="5"
                VerticalAlignment="Center"
                Content="{Binding Icon}"
                TextElement.FontFamily="{Binding (atc:Icon.FontFamily), RelativeSource={RelativeSource AncestorType=local:TreeMenu}}" />

            <TextBlock
                x:Name="Title"
                Grid.Column="1"
                Margin="5"
                VerticalAlignment="Center"
                Text="{Binding Title}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <HierarchicalDataTemplate.Triggers>
            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Title}" Value="{x:Null}">
                <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Title}" Value="">
                <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>

    <!--  Icon 模式条目模板：图标字号取 atc:Icon.IconSize，标题间距与旧版 IconLayout 一致。  -->
    <HierarchicalDataTemplate x:Key="TreeMenuIconItemTemplate" ItemsSource="{Binding Children}">
        <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ContentPresenter
                x:Name="Icon"
                Grid.Column="0"
                Margin="5"
                VerticalAlignment="Center"
                Content="{Binding Icon}"
                TextElement.FontFamily="{Binding (atc:Icon.FontFamily), RelativeSource={RelativeSource AncestorType=local:TreeMenu}}"
                TextElement.FontSize="{Binding (atc:Icon.IconSize), RelativeSource={RelativeSource AncestorType=local:TreeMenu}}" />

            <TextBlock
                x:Name="Title"
                Grid.Column="1"
                Margin="10"
                VerticalAlignment="Center"
                Text="{Binding Title}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <HierarchicalDataTemplate.Triggers>
            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Title}" Value="{x:Null}">
                <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Title}" Value="">
                <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>

    <!--
        容器样式（Normal / Icon 两模式共用一套模板，经 DataTrigger 切换）：
        - IsExpanded / IsSelected 与 TreeMenuItem 同名属性双向绑定，状态落在数据模型上，容器回收后不丢失；
        - ItemsPanel 换成 VirtualizingStackPanel，使嵌套层级与根级一样参与虚拟化（旧版只有第一层虚拟化）；
        - ItemsPresenter 的 MaxWidth 绑定本级内容 Border 宽度，子级不会向上撑大 TreeMenu，超出部分被截断。
    -->
    <Style x:Key="TreeMenuItemContainerStyle" TargetType="TreeViewItem">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="atc:ExpanderBehavior.Enable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <bt:ToggleButton
                                x:Name="ExpanderButton"
                                Grid.Column="0"
                                Width="16"
                                Height="16"
                                Margin="2,0"
                                VerticalAlignment="Center"
                                ClickMode="Press"
                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                Style="{StaticResource ExpanderButton}" />

                            <Border
                                x:Name="Indicator"
                                Grid.Column="0"
                                Width="3"
                                Margin="1,0"
                                Background="{DynamicResource Theme.Brush.Accent.Primary}"
                                CornerRadius="{DynamicResource Theme.SmallCornerRadius}"
                                Visibility="Collapsed" />

                            <Border
                                x:Name="Root"
                                Grid.Column="1"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Theme.SmallCornerRadius}">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                            </Border>
                        </Grid>

                        <ItemsPresenter
                            x:Name="ItemHost"
                            MaxWidth="{Binding ElementName=Root, Path=ActualWidth}"
                            ClipToBounds="True" />
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{Binding ItemHoverBackground, RelativeSource={RelativeSource AncestorType=local:TreeMenu}}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{Binding SelectedItemBackground, RelativeSource={RelativeSource AncestorType=local:TreeMenu}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.Brush.State.DisabledSurface}" />
                        </Trigger>

                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="ExpanderButton" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <!--  Icon 模式用左侧指示器替代展开箭头（指示器仅对有子项的节点显示）。  -->
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=local:TreeMenu}}" Value="Icon">
                            <Setter TargetName="ExpanderButton" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=local:TreeMenu}}" Value="Icon" />
                                <Condition Binding="{Binding HasItems, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:TreeMenu}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Secondary}" />
        <Setter Property="ItemHoverBackground" Value="{DynamicResource Theme.Brush.Surface.Hover}" />
        <Setter Property="SelectedItemBackground" Value="{DynamicResource Theme.Brush.Surface.Sunken}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource TreeMenuItemContainerStyle}" />
        <Setter Property="ItemTemplate" Value="{StaticResource TreeMenuNormalItemTemplate}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TreeMenu}">
                    <ScrollViewer
                        CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                        Focusable="False"
                        HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                        VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                        <Border
                            Background="{DynamicResource Theme.Brush.Surface.Base}"
                            BorderBrush="{DynamicResource Theme.Brush.Border.Default}"
                            BorderThickness="1"
                            ClipToBounds="True"
                            CornerRadius="{DynamicResource Theme.ControlCornerRadius}">
                            <ItemsPresenter />
                        </Border>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="DisplayMode" Value="Icon">
                <Setter Property="ItemTemplate" Value="{StaticResource TreeMenuIconItemTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
