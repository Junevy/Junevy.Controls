<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties"
    xmlns:cvt="clr-namespace:Junevy.Controls.Converters"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Menu"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">

    <cvt:NullToCollapsedConverter x:Key="ContextMenuIconVisibility" />
    <!--  条目容器样式选择器：Separator 是自带容器，TargetType=MenuItem 的 ItemContainerStyle
          会在容器生成时抛 InvalidOperationException（右键闪退），故一律经选择器按条目类型分发。  -->
    <local:JunevyMenuItemStyleSelector x:Key="JunevyMenuItemStyleSelector" />

    <Style x:Key="JunevyContextMenuSeparatorStyle" TargetType="{x:Type Separator}">
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Height="1"
                            Background="{DynamicResource Theme.Brush.Border.Default}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JunevyContextMenuItemStyle" TargetType="{x:Type MenuItem}">
        <Style.Resources>
            <Style TargetType="{x:Type Separator}"
                   BasedOn="{StaticResource JunevyContextMenuSeparatorStyle}" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                             Color="{DynamicResource Theme.Color.Surface.Hover}" />
            <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}"
                             Color="{DynamicResource Theme.Color.Surface.Hover}" />
        </Style.Resources>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Secondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <!-- Keep generated items on this style at every submenu depth.  A
             DynamicResource avoids binding a derived ContextMenuItem style to
             a native MenuItem container. -->
        <!--  自传播同样走选择器：嵌套子菜单里的 Separator 否则会在二级深度复现同款闪退。  -->
        <Setter Property="ItemContainerStyleSelector"
                Value="{StaticResource JunevyMenuItemStyleSelector}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Grid>
                    <Border x:Name="Root" MinHeight="30" Padding="8,4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Theme.SmallCornerRadius}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition x:Name="ArrowColumn" Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="IconPresenter" Grid.Column="0" Width="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{TemplateBinding Icon}"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       TextAlignment="Center"
                                       TextWrapping="NoWrap"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="{TemplateBinding FontSize}"
                                       Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Icon, Converter={StaticResource ContextMenuIconVisibility}}" />
                            <TextBlock x:Name="CheckMark" Grid.Column="0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="Segoe UI Symbol" FontSize="12"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="&#x2713;" Visibility="Collapsed" />
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                              Content="{TemplateBinding Header}"
                                              ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                              RecognizesAccessKey="True"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <TextBlock x:Name="InputGestureText" Grid.Column="2"
                                       Margin="12,0,0,0" VerticalAlignment="Center"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                                       Text="{TemplateBinding InputGestureText}"
                                       Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=InputGestureText, Converter={StaticResource ContextMenuIconVisibility}}" />
                            <Path x:Name="Arrow" Grid.Column="3" Width="6" Height="10" Margin="12,0,0,0"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Data="M 0,0 L 4,5 L 0,10" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.4" Visibility="Collapsed"
                                  RenderTransformOrigin="0.5,0.5" />
                        </Grid>
                    </Border>
                    <Popup x:Name="PART_Popup"
                           AllowsTransparency="True"
                           Focusable="False"
                           IsOpen="{TemplateBinding IsSubmenuOpen}"
                           Placement="Right"
                           PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                           PopupAnimation="Fade">
                        <Border Padding="4"
                                Background="{DynamicResource Theme.Brush.Surface.Base}"
                                BorderBrush="{DynamicResource Theme.Brush.Border.Default}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Theme.ControlCornerRadius}"
                                Effect="{DynamicResource Theme.PopupShadow}">
                            <ScrollViewer x:Name="SubMenuScrollViewer"
                                          Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type FrameworkElement}, ResourceId=MenuScrollViewer}}">
                                <Grid RenderOptions.ClearTypeHint="Enabled">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                                    KeyboardNavigation.TabNavigation="Cycle" />
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  悬停画刷经 AncestorType=MenuBase 读取宿主注入的 MenuAssist.ItemHoverBackground：
                              jv:ContextMenu 与 JunevyMenuBarStyle 的原生 Menu 都注入同一附加属性，
                              条目模板只有一份，两类宿主的下拉条目悬停都生效。  -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="{Binding Path=(atc:MenuAssist.ItemHoverBackground), RelativeSource={RelativeSource AncestorType={x:Type primitives:MenuBase}}}" />
                            <Setter TargetName="Root" Property="Background" Value="{Binding Path=(atc:MenuAssist.ItemHoverBackground), RelativeSource={RelativeSource AncestorType={x:Type primitives:MenuBase}}}" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter Property="Background" Value="{Binding Path=(atc:MenuAssist.ItemHoverBackground), RelativeSource={RelativeSource AncestorType={x:Type primitives:MenuBase}}}" />
                            <Setter TargetName="Root" Property="Background" Value="{Binding Path=(atc:MenuAssist.ItemHoverBackground), RelativeSource={RelativeSource AncestorType={x:Type primitives:MenuBase}}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface.Pressed}" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
                            <Setter TargetName="InputGestureText"
                                    Property="Foreground"
                                    Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="FlowDirection" Value="RightToLeft">
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Left" />
                            <Setter TargetName="Arrow" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="-1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:ContextMenuItem}" BasedOn="{StaticResource JunevyContextMenuItemStyle}" />

    <Style TargetType="{x:Type local:ContextMenu}">
        <Style.Resources>
            <!-- Submenu containers are native MenuItems.  Give them the same
                 template explicitly so WPF cannot fall back to its blue
                 system highlight when a nested item is selected. -->
            <Style TargetType="{x:Type MenuItem}"
                   BasedOn="{StaticResource JunevyContextMenuItemStyle}" />
            <Style TargetType="{x:Type Separator}"
                   BasedOn="{StaticResource JunevyContextMenuSeparatorStyle}" />
        </Style.Resources>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Secondary}" />
        <Setter Property="ItemHoverBackground" Value="{DynamicResource Theme.Brush.Surface.Hover}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface.Base}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HasDropShadow" Value="True" />
        <!--  条目样式一律经选择器分发（Separator 自带容器，见文件头说明）  -->
        <Setter Property="ItemContainerStyleSelector" Value="{StaticResource JunevyMenuItemStyleSelector}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ContextMenu}">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Theme.ControlCornerRadius}"
                            Effect="{DynamicResource Theme.PopupShadow}">
                        <ScrollViewer x:Name="ContextMenuScrollViewer"
                                      Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type FrameworkElement}, ResourceId=MenuScrollViewer}}">
                            <Grid RenderOptions.ClearTypeHint="Enabled">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                                KeyboardNavigation.TabNavigation="Cycle" />
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
