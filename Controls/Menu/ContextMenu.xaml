<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cvt="clr-namespace:Junevy.Controls.Converters"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Menu">

    <cvt:NullToCollapsedConverter x:Key="ContextMenuIconVisibility" />

    <Style x:Key="JunevyContextMenuItemStyle" TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="ItemContainerStyle"
                Value="{Binding RelativeSource={RelativeSource Self}, Path=Style}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Grid>
                    <Border x:Name="Root" MinHeight="30" Padding="8,4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Theme.SmallCornerRadius}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="IconColumn" Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="ArrowColumn" Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentControl x:Name="IconPresenter" Grid.Column="0" Width="16" Height="16"
                                            Margin="0,0,8,0" HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Content="{TemplateBinding Icon}"
                                            FontFamily="{DynamicResource IconFont}" FontSize="14"
                                            Foreground="{TemplateBinding Foreground}"
                                            Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Icon, Converter={StaticResource ContextMenuIconVisibility}}" />
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                              Content="{TemplateBinding Header}"
                                              ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Path x:Name="Arrow" Grid.Column="2" Width="6" Height="10" Margin="12,0,0,0"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Data="M 0,0 L 4,5 L 0,10" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.4" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <Popup x:Name="SubMenuPopup"
                           AllowsTransparency="True"
                           Focusable="False"
                           IsOpen="{TemplateBinding IsSubmenuOpen}"
                           Placement="Right"
                           PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                           PopupAnimation="Fade">
                        <Border Padding="4"
                                Background="{DynamicResource Theme.Brush.Surface.Base}"
                                BorderBrush="{DynamicResource Theme.Brush.Border.Default}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Theme.ControlCornerRadius}"
                                Effect="{DynamicResource Theme.PopupShadow}">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:ContextMenuItem}" BasedOn="{StaticResource JunevyContextMenuItemStyle}" />

    <Style TargetType="{x:Type local:ContextMenu}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface.Base}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource JunevyContextMenuItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ContextMenu}">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Theme.ControlCornerRadius}"
                            Effect="{DynamicResource Theme.PopupShadow}">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
