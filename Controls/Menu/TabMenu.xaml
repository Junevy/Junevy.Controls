<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attach="clr-namespace:Junevy.Controls.AttachedProperties"
    xmlns:bt="clr-namespace:Junevy.Controls.Controls.Button"
    xmlns:cvt="clr-namespace:Junevy.Controls.Converters"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Menu"
    xmlns:tb="clr-namespace:Junevy.Controls.Controls.Text">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls;component/Resources/Font/IconFont.xaml" />
        <ResourceDictionary Source="/Junevy.Controls;component/Controls/Button/Button.xaml" />
        <ResourceDictionary Source="/Junevy.Controls;component/Generic/Style/DefaultFocusStyle.xaml" />
        <ResourceDictionary Source="/Junevy.Controls;component/Controls/Text/TextBox.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <cvt:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <cvt:CornerRadiusFilterConverter x:Key="TopCornerRadius" Mode="Top" />
    <cvt:CornerRadiusFilterConverter x:Key="BottomCornerRadius" Mode="Bottom" />

    <!--  1. TabItem style  -->
    <Style x:Key="DefaultTabMenuItemStyle" TargetType="{x:Type local:TabMenuItem}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="20" />
        <!--<Setter Property="MinWidth" Value="120" />-->
        <Setter Property="HorizontalAlignment" Value="Left" />
        <!--  Stretch使页签底边始终对齐页签行底部，与内容区上边框无缝衔接  -->
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface.Base}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
        <Setter Property="TextElement.FontSize" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TabMenuItem}">
                    <Border
                        x:Name="border"
                        Margin="0,0,2,0"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource Theme.Brush.Border.Default}"
                        BorderThickness="1,1,1,1"
                        CornerRadius="{Binding RelativeSource={RelativeSource AncestorType=local:TabMenu}, Path=HeaderCornerRadius, Converter={StaticResource TopCornerRadius}, FallbackValue=4}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  指示器  -->
                            <Border
                                Grid.Column="0"
                                Background="{DynamicResource Theme.Brush.Accent.Primary}"
                                CornerRadius="2"
                                Visibility="{TemplateBinding IsSelected,
                                                             Converter={StaticResource BoolToVisibility}}" />

                            <Grid Grid.Column="1">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>

                                <!--  icon  -->
                                <ContentControl
                                    Grid.Column="0"
                                    Margin="5"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Icon}"
                                    Focusable="False"
                                    FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:TabMenu}, Path=(attach:Icon.FontFamily)}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Foreground="{TemplateBinding Foreground}"
                                    Visibility="{TemplateBinding Icon,
                                                                 Converter={StaticResource BoolToVisibility}}" />

                                <!-- Header display follows the standard WPF
                                     HeaderedContentControl contract. -->
                                <Grid Grid.Column="1" Margin="5,0,20,0">
                                    <ContentPresenter
                                        x:Name="PART_HeaderPresenter"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        ContentSource="Header"
                                        RecognizesAccessKey="True"
                                        TextElement.FontFamily="{TemplateBinding FontFamily}"
                                        TextElement.FontSize="{TemplateBinding FontSize}"
                                        TextElement.FontStretch="{TemplateBinding FontStretch}"
                                        TextElement.FontStyle="{TemplateBinding FontStyle}"
                                        TextElement.FontWeight="{TemplateBinding FontWeight}"
                                        TextElement.Foreground="{TemplateBinding Foreground}" />

                                    <TextBox
                                        x:Name="PART_EditHeaderTextBox"
                                        VerticalAlignment="Center"
                                        FontSize="{TemplateBinding FontSize}"
                                        Foreground="{TemplateBinding Foreground}"
                                        Template="{StaticResource NoBorderTextBoxTemplate_WPF}"
                                        Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                        Visibility="Collapsed" />
                                </Grid>

                                <bt:Button
                                    x:Name="PART_CloseButton"
                                    Grid.Column="2"
                                    Margin="5,0,5,0"
                                    HorizontalAlignment="Right"
                                    Command="{x:Static local:TabMenu.CloseTabCommand}"
                                    CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TabMenuItem}}}"
                                    Content="&#xe639;"
                                    FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:TabMenu}, Path=(attach:Icon.FontFamily)}"
                                    Foreground="{TemplateBinding Foreground}"
                                    Template="{StaticResource NoBorderButtonTemplate}"
                                    Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:TabMenu}, Path=(attach:AttachFuc.IsClosable), Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!--  触发器后声明者优先：IsSelected需覆盖IsMouseOver，
                              避免悬停选中页签时背景偏离内容区背景色  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <!--  背景与内容区一致、去掉底边框，使选中页签与内容区视觉一体  -->
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Theme.Brush.Background.App}" />
                            <Setter TargetName="border" Property="BorderThickness" Value="1,1,1,0" />
                        </Trigger>
                        <Trigger Property="IsEditing" Value="True">
                            <Setter TargetName="PART_HeaderPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_EditHeaderTextBox" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Theme.Brush.State.DisabledSurface}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  2. TabControl 的完整样式  -->
    <Style TargetType="{x:Type local:TabMenu}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="attach:AttachFuc.IsClosable" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Background.App}" />
        <Setter Property="HeaderCornerRadius" Value="{DynamicResource Theme.SmallCornerRadius}" />
        <Setter Property="ContentCornerRadius" Value="{DynamicResource Theme.LargeCornerRadius}" />

        <Setter Property="ItemContainerStyle" Value="{StaticResource DefaultTabMenuItemStyle}" />

        <!--  标签头排列方式（可改成 WrapPanel 实现自动换行）  -->
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>

        <!--  最重要的：ControlTemplate 重写整体结构  -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TabMenu}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  内容：上移1px，使上边框线延伸到页签行底部，作为页签之间的分割线。
                              声明在页签行之前，页签行绘制在其上层——选中页签无底边框即可盖住分割线，与内容区连为一体  -->
                        <Border
                            Grid.Row="1"
                            Margin="0,-1,0,0"
                            Background="{DynamicResource Theme.Brush.Background.App}"
                            BorderBrush="{DynamicResource Theme.Brush.Border.Default}"
                            BorderThickness="1,1,1,1"
                            CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ContentCornerRadius, Converter={StaticResource BottomCornerRadius}, FallbackValue=8}">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                ContentSource="SelectedContent"
                                ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}"
                                ContentStringFormat="{TemplateBinding SelectedContentStringFormat}" />
                        </Border>

                        <!--  标签头（绘制在内容区上边框线之上）  -->
                        <ScrollViewer
                            CanContentScroll="True"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
