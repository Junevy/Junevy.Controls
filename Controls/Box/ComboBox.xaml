<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bt="clr-namespace:Junevy.Controls.Controls.Button"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Box">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls;component/Controls/Button/ToggleButton.xaml" />
        <ResourceDictionary Source="/Junevy.Controls;component/Themes/AppColors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <ControlTemplate x:Key="DefaultComboBoxItemTemplate" TargetType="ComboBoxItem">
        <Border
            x:Name="ItemBorder"
            Margin="{TemplateBinding Margin}"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            CornerRadius="3">
            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
        </Border>


        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SubBackground}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SubAppColor}" />
                <Setter Property="Foreground" Value="{StaticResource TextFillColor}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SubAppColor}" />
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <Style x:Key="DefaultComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextFillColor}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Background" Value="{StaticResource MainBackground}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource DefaultComboBoxItemTemplate}" />
    </Style>





    <ControlTemplate x:Key="DefaultComboBoxTemplate" TargetType="{x:Type local:ComboBox}">
        <Grid>
            <!--  主体边框  -->
            <Border
                x:Name="MainBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="3"
                SnapsToDevicePixels="True">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>

                    <!--  选中内容显示  -->
                    <ContentPresenter
                        x:Name="ContentSite"
                        Grid.Column="0"
                        Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding SelectionBoxItem}"
                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                        IsHitTestVisible="False" />

                    <!--  占位文字  -->
                    <TextBlock
                        x:Name="Placeholder"
                        Grid.Column="0"
                        Margin="{TemplateBinding Padding}"
                        VerticalAlignment="Center"
                        FontSize="{TemplateBinding FontSize}"
                        Foreground="{StaticResource SubTextFillColor}"
                        IsHitTestVisible="False"
                        Text="Select the item..."
                        Visibility="Collapsed" />


                    <!--  Toggle 按钮（覆盖整个区域）  -->
                    <bt:ToggleButton
                        x:Name="ToggleButton"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Right"
                        ClickMode="Press"
                        Focusable="False"
                        IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                        Template="{StaticResource ArrowToggleButtonTemplate}" />
                </Grid>
            </Border>

            <!--  焦点高亮边框  -->
            <Border
                x:Name="FocusBorder"
                BorderThickness="1"
                CornerRadius="6"
                IsHitTestVisible="False"
                Opacity="0">

                <Border.BorderBrush>
                    <SolidColorBrush Opacity="0.4" Color="DodgerBlue" />
                </Border.BorderBrush>
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="6"
                        Opacity="0.3"
                        ShadowDepth="0"
                        Color="LightGray" />
                </Border.Effect>

            </Border>

            <!--  下拉弹出层  -->
            <Popup
                x:Name="Popup"
                MinHeight="50"
                AllowsTransparency="True"
                Focusable="False"
                IsOpen="{TemplateBinding IsDropDownOpen}"
                Placement="Bottom"
                PopupAnimation="Fade">

                <Grid
                    x:Name="DropDown"
                    MinWidth="{TemplateBinding ActualWidth}"
                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                    SnapsToDevicePixels="True">

                    <Border
                        x:Name="DropDownBorder"
                        Margin="0,4,0,0"
                        Background="{StaticResource MainBackground}"
                        BorderBrush="{StaticResource BorderBrushColor}"
                        BorderThickness="1"
                        CornerRadius="3">
                        <ScrollViewer Margin="0,4" SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Popup>
        </Grid>

        <ControlTemplate.Triggers>
            <!--  无选中项时显示占位文字  -->
            <Trigger Property="SelectedItem" Value="{x:Null}">
                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>

            <!--  鼠标悬停  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource IndicatorColor}" />
            </Trigger>

            <!--  展开状态  -->
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
                <Setter TargetName="FocusBorder" Property="Opacity" Value="1" />
            </Trigger>

            <!--  禁用状态  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource DisabledBackgroundColor}" />
                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource DisabledColor}" />
                <Setter Property="Foreground" Value="{StaticResource DisabledForegroundColor}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <!--  ComboBox 主样式  -->
    <Style x:Key="DefaultComboBoxStyle" TargetType="{x:Type local:ComboBox}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Width" Value="150" />
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="Padding" Value="12,0,0,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextFillColor}" />
        <Setter Property="Background" Value="{StaticResource SubBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DefaultComboBoxItemStyle}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource DefaultComboBoxTemplate}" />
    </Style>



    <Style BasedOn="{StaticResource DefaultComboBoxStyle}" TargetType="{x:Type local:ComboBox}" />
    <Style BasedOn="{StaticResource DefaultComboBoxStyle}" TargetType="ComboBox" />
</ResourceDictionary>