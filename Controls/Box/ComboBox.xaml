<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties"
    xmlns:bt="clr-namespace:Junevy.Controls.Controls.Button"
    xmlns:cvt="clr-namespace:Junevy.Controls.Converters"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Box">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls;component/Controls/Button/ToggleButton.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <cvt:NullToUnsetValueConverter x:Key="NullToUnsetValue" />

    <ControlTemplate x:Key="DefaultComboBoxItemTemplate" TargetType="ComboBoxItem">
        <Border
            x:Name="ItemBorder"
            Margin="{TemplateBinding Margin}"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            CornerRadius="{DynamicResource Theme.SmallCornerRadius}">
            <ContentPresenter
                Content="{TemplateBinding Content}"
                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center" />
        </Border>


        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Base}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Theme.Brush.Accent.PrimarySubtle}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Theme.Brush.Accent.PrimarySubtle}" />
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <Style x:Key="DefaultComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Background.App}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource DefaultComboBoxItemTemplate}" />
    </Style>



    <ControlTemplate x:Key="DefaultComboBoxTemplate" TargetType="ComboBox">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  标题（TitleAssist）：位置由 TitlePlacement 驱动，四个方位各一个呈现器，
                  由模板触发器切换显隐；标题为空时全部折叠，不占用布局空间。
                  字体族/字号/颜色未设置（null/NaN）时经 NullToUnsetValue 回退为继承值  -->
            <ContentPresenter
                x:Name="TitleTop"
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,0,0,4"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Content="{TemplateBinding atc:TitleAssist.Title}"
                IsHitTestVisible="False"
                TextElement.FontWeight="{TemplateBinding atc:TitleAssist.TitleFontWeight}"
                Visibility="Visible">
                <TextElement.FontFamily>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleFontFamily)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="FontFamily" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.FontFamily>
                <TextElement.FontSize>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleFontSize)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="FontSize" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.FontSize>
                <TextElement.Foreground>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleForeground)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="Foreground" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.Foreground>
            </ContentPresenter>

            <ContentPresenter
                x:Name="TitleBottom"
                Grid.Row="2"
                Grid.Column="1"
                Margin="0,4,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Content="{TemplateBinding atc:TitleAssist.Title}"
                IsHitTestVisible="False"
                TextElement.FontWeight="{TemplateBinding atc:TitleAssist.TitleFontWeight}"
                Visibility="Collapsed">
                <TextElement.FontFamily>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleFontFamily)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="FontFamily" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.FontFamily>
                <TextElement.FontSize>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleFontSize)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="FontSize" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.FontSize>
                <TextElement.Foreground>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleForeground)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="Foreground" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.Foreground>
            </ContentPresenter>

            <ContentPresenter
                x:Name="TitleLeft"
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,0,4,0"
                VerticalAlignment="Center"
                Content="{TemplateBinding atc:TitleAssist.Title}"
                IsHitTestVisible="False"
                TextElement.FontWeight="{TemplateBinding atc:TitleAssist.TitleFontWeight}"
                Visibility="Collapsed">
                <TextElement.FontFamily>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleFontFamily)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="FontFamily" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.FontFamily>
                <TextElement.FontSize>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleFontSize)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="FontSize" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.FontSize>
                <TextElement.Foreground>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleForeground)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="Foreground" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.Foreground>
            </ContentPresenter>

            <ContentPresenter
                x:Name="TitleRight"
                Grid.Row="1"
                Grid.Column="2"
                Margin="4,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Content="{TemplateBinding atc:TitleAssist.Title}"
                IsHitTestVisible="False"
                TextElement.FontWeight="{TemplateBinding atc:TitleAssist.TitleFontWeight}"
                Visibility="Collapsed">
                <TextElement.FontFamily>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleFontFamily)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="FontFamily" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.FontFamily>
                <TextElement.FontSize>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleFontSize)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="FontSize" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.FontSize>
                <TextElement.Foreground>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleForeground)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="Foreground" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.Foreground>
            </ContentPresenter>
            <!--  涓讳綋杈规  -->
            <Border
                x:Name="MainBorder"
                Grid.Row="1"
                Grid.Column="1"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding Border.CornerRadius}"
                SnapsToDevicePixels="True">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>

                    <!--  閫変腑鍐呭鏄剧ず  -->
                    <ContentPresenter
                        x:Name="ContentSite"
                        Grid.Column="0"
                        Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding SelectionBoxItem}"
                        ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                        ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                        IsHitTestVisible="False" />

                    <!-- WPF's editable ComboBox contract.  Keeping this named
                         PART lets keyboard input and Text binding work while
                         preserving the custom visual style. Style is pinned to
                         null so the implicit TextBox style cannot restyle it. -->
                    <TextBox
                        x:Name="PART_EditableTextBox"
                        Style="{x:Null}"
                        Grid.Column="0"
                        Margin="{TemplateBinding Padding}"
                        Padding="0"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{TemplateBinding Foreground}"
                        IsReadOnly="{TemplateBinding IsReadOnly}"
                        Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="Collapsed" />

                    <!--  占位符（PlaceholderAssist）：未选中项时显示；
                          字体族跟随 Icon.FontFamily，占位内容可设 iconfont 字形  -->
                    <ContentPresenter
                        x:Name="Placeholder"
                        Grid.Column="0"
                        Margin="{TemplateBinding Padding}"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding atc:PlaceholderAssist.Placeholder}"
                        IsHitTestVisible="False"
                        TextElement.FontFamily="{TemplateBinding atc:Icon.FontFamily}"
                        TextElement.FontSize="{TemplateBinding FontSize}"
                        TextElement.Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                        Visibility="Collapsed" />


                    <!--  Toggle 鎸夐挳锛堣鐩栨暣涓尯鍩燂級  -->
                    <bt:ToggleButton
                        x:Name="ToggleButton"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        ClickMode="Press"
                        Focusable="False"
                        IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                        Template="{StaticResource ArrowToggleButtonTemplate}" />
                </Grid>
            </Border>

            <!--  鐒︾偣楂樹寒杈规  -->
            <Border
                x:Name="FocusBorder"
                Grid.Row="1"
                Grid.Column="1"
                BorderThickness="1"
                CornerRadius="{TemplateBinding Border.CornerRadius}"
                IsHitTestVisible="False"
                Opacity="0">

                <Border.BorderBrush>
                    <SolidColorBrush Opacity="0.45" Color="{DynamicResource Theme.Color.Border.Focus}" />
                </Border.BorderBrush>
                <Border.Effect>
                    <DynamicResource ResourceKey="Theme.PopupShadow" />
                </Border.Effect>

            </Border>

            <!--  涓嬫媺寮瑰嚭灞?  -->
            <Popup
                x:Name="PART_Popup"
                MinHeight="50"
                AllowsTransparency="True"
                Focusable="False"
                IsOpen="{TemplateBinding IsDropDownOpen}"
                Placement="Bottom"
                PopupAnimation="Fade">

                <Grid
                    x:Name="DropDown"
                    MinWidth="{TemplateBinding ActualWidth}"
                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                    SnapsToDevicePixels="True">

                    <Border
                        x:Name="DropDownBorder"
                        Margin="0,4,0,0"
                        Background="{DynamicResource Theme.Brush.Background.App}"
                        BorderBrush="{DynamicResource Theme.Brush.Border.Default}"
                        BorderThickness="1"
                        CornerRadius="{TemplateBinding Border.CornerRadius}">
                        <ScrollViewer
                            Margin="0,4"
                            CanContentScroll="True"
                            SnapsToDevicePixels="True">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Popup>
        </Grid>

        <ControlTemplate.Triggers>
            <!--  标题（TitleAssist）：无标题时四个方位全部折叠；位置触发器只切换对应方位的显隐  -->
            <Trigger Property="atc:TitleAssist.Title" Value="{x:Null}">
                <Setter TargetName="TitleTop" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="TitleBottom" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="TitleLeft" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="TitleRight" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="atc:TitleAssist.TitlePlacement" Value="Bottom">
                <Setter TargetName="TitleTop" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="TitleBottom" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="atc:TitleAssist.TitlePlacement" Value="Left">
                <Setter TargetName="TitleTop" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="TitleLeft" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="atc:TitleAssist.TitlePlacement" Value="Right">
                <Setter TargetName="TitleTop" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="TitleRight" Property="Visibility" Value="Visible" />
            </Trigger>

            <!--  鏃犻€変腑椤规椂鏄剧ず鍗犱綅鏂囧瓧  -->
            <Trigger Property="SelectedItem" Value="{x:Null}">
                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>

            <Trigger Property="IsEditable" Value="True">
                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
            </Trigger>

            <!--  榧犳爣鎮仠  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Strong}" />
            </Trigger>

            <!--  灞曞紑鐘舵€?  -->
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
                <Setter TargetName="FocusBorder" Property="Opacity" Value="1" />
            </Trigger>

            <!--  绂佺敤鐘舵€?  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource Theme.Brush.State.DisabledSurface}" />
                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.State.DisabledBorder}" />
                <Setter TargetName="ContentSite" Property="Opacity" Value="0.55" />
                <Setter TargetName="Placeholder" Property="TextElement.Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <!--  ComboBox 主样式  -->
    <Style x:Key="DefaultComboBoxStyle" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="30" />
        <!--<Setter Property="Width" Value="150" />-->
        <Setter Property="MinWidth" Value="50" />
        <Setter Property="Padding" Value="{DynamicResource Theme.ControlPadding}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface.Base}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="{DynamicResource Theme.ControlCornerRadius}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DefaultComboBoxItemStyle}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="atc:Icon.FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="atc:TitleAssist.TitleForeground" Value="{DynamicResource Theme.Brush.Text.Secondary}" />
        <Setter Property="Template" Value="{StaticResource DefaultComboBoxTemplate}" />
    </Style>



    <!--  隐式样式（官方类型）：App 合并字典后 <ComboBox> 自动生效。
          注意：主体点击切换逻辑在 jv:ComboBox 子类中，原生实例上展开/折叠走 WPF 原生行为；
          占位符统一由 atc:PlaceholderAssist.Placeholder 提供，原生实例默认无占位内容。  -->
    <Style BasedOn="{StaticResource DefaultComboBoxStyle}" TargetType="ComboBox" />

    <!--  隐式样式（派生类型）：jv:ComboBox 照常使用主题样式；
          保留历史默认占位文案，未设置占位符时仍显示 "Select an item..."  -->
    <Style BasedOn="{StaticResource DefaultComboBoxStyle}" TargetType="{x:Type local:ComboBox}">
        <Setter Property="atc:PlaceholderAssist.Placeholder" Value="Select an item..." />
    </Style>
</ResourceDictionary>
