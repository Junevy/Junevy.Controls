<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bt="clr-namespace:Junevy.Controls.Controls.Button"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Box">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls;component/Controls/Button/ToggleButton.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <ControlTemplate x:Key="DefaultComboBoxItemTemplate" TargetType="ComboBoxItem">
        <Border
            x:Name="ItemBorder"
            Margin="{TemplateBinding Margin}"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            CornerRadius="{DynamicResource Theme.SmallCornerRadius}">
            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
        </Border>


        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Theme.SurfaceBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Theme.PrimarySubtleBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimaryBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Theme.PrimarySubtleBrush}" />
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <Style x:Key="DefaultComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource Theme.BackgroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource DefaultComboBoxItemTemplate}" />
    </Style>



    <ControlTemplate x:Key="DefaultComboBoxTemplate" TargetType="{x:Type local:ComboBox}">
        <Grid>
            <!--  涓讳綋杈规  -->
            <Border
                x:Name="MainBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding Border.CornerRadius}"
                SnapsToDevicePixels="True">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>

                    <!--  閫変腑鍐呭鏄剧ず  -->
                    <ContentPresenter
                        x:Name="ContentSite"
                        Grid.Column="0"
                        Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding SelectionBoxItem}"
                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                        IsHitTestVisible="False" />

                    <!--  鍗犱綅鏂囧瓧  -->
                    <TextBlock
                        x:Name="Placeholder"
                        Grid.Column="0"
                        Margin="{TemplateBinding Padding}"
                        VerticalAlignment="Center"
                        FontSize="{TemplateBinding FontSize}"
                        Foreground="{DynamicResource Theme.TextSecondaryBrush}"
                        IsHitTestVisible="False"
                        Text="{TemplateBinding PlaceHolder}"
                        Visibility="Collapsed" />


                    <!--  Toggle 鎸夐挳锛堣鐩栨暣涓尯鍩燂級  -->
                    <bt:ToggleButton
                        x:Name="ToggleButton"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Right"
                        ClickMode="Press"
                        Focusable="False"
                        IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                        Template="{StaticResource ArrowToggleButtonTemplate}" />
                </Grid>
            </Border>

            <!--  鐒︾偣楂樹寒杈规  -->
            <Border
                x:Name="FocusBorder"
                BorderThickness="1"
                CornerRadius="{TemplateBinding Border.CornerRadius}"
                IsHitTestVisible="False"
                Opacity="0">

                <Border.BorderBrush>
                    <SolidColorBrush Opacity="0.45" Color="{DynamicResource Theme.FocusColor}" />
                </Border.BorderBrush>
                <Border.Effect>
                    <DynamicResource ResourceKey="Theme.PopupShadow" />
                </Border.Effect>

            </Border>

            <!--  涓嬫媺寮瑰嚭灞? -->
            <Popup
                x:Name="Popup"
                MinHeight="50"
                AllowsTransparency="True"
                Focusable="False"
                IsOpen="{TemplateBinding IsDropDownOpen}"
                Placement="Bottom"
                PopupAnimation="Fade">

                <Grid
                    x:Name="DropDown"
                    MinWidth="{TemplateBinding ActualWidth}"
                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                    SnapsToDevicePixels="True">

                    <Border
                        x:Name="DropDownBorder"
                        Margin="0,4,0,0"
                        Background="{DynamicResource Theme.BackgroundBrush}"
                        BorderBrush="{DynamicResource Theme.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{TemplateBinding Border.CornerRadius}">
                        <ScrollViewer
                            Margin="0,4"
                            CanContentScroll="True"
                            SnapsToDevicePixels="True">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Popup>
        </Grid>

        <ControlTemplate.Triggers>
            <!--  鏃犻€変腑椤规椂鏄剧ず鍗犱綅鏂囧瓧  -->
            <Trigger Property="SelectedItem" Value="{x:Null}">
                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>

            <!--  榧犳爣鎮仠  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource Theme.BorderStrongBrush}" />
            </Trigger>

            <!--  灞曞紑鐘舵€? -->
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource Theme.PrimaryBrush}" />
                <Setter TargetName="FocusBorder" Property="Opacity" Value="1" />
            </Trigger>

            <!--  绂佺敤鐘舵€? -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource Theme.DisabledSurfaceBrush}" />
                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource Theme.DisabledBorderBrush}" />
                <Setter TargetName="ContentSite" Property="Opacity" Value="0.55" />
                <Setter TargetName="Placeholder" Property="Foreground" Value="{DynamicResource Theme.DisabledForegroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.DisabledForegroundBrush}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <!--  ComboBox 涓绘牱寮? -->
    <Style x:Key="DefaultComboBoxStyle" TargetType="{x:Type local:ComboBox}">
        <Setter Property="MinHeight" Value="30" />
        <!--<Setter Property="Width" Value="150" />-->
        <Setter Property="MinWidth" Value="50" />
        <Setter Property="Padding" Value="12,0,0,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="{DynamicResource Theme.ControlCornerRadius}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DefaultComboBoxItemStyle}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource DefaultComboBoxTemplate}" />
    </Style>



    <Style BasedOn="{StaticResource DefaultComboBoxStyle}" TargetType="{x:Type local:ComboBox}" />
    <!--<Style BasedOn="{StaticResource DefaultComboBoxStyle}" TargetType="ComboBox" />-->
</ResourceDictionary>
