<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties">

    <!--
        ============================================================
        DatePicker / Calendar 全套主题（官方同名控件，隐式样式接管）：
        - DatePicker：PART_Root / PART_TextBox / PART_Button / PART_Calendar
        - DatePickerTextBox：PART_Watermark / PART_ContentElement
        - Calendar：PART_Root + PART_CalendarItem
        - CalendarItem：PART_PreviousButton / PART_HeaderButton / PART_NextButton
                        / PART_MonthView / PART_YearView / PART_DisableVisual
        全部命中 WPF 官方模板部件契约，App 合并 Themes/Generic.xaml 后
        <DatePicker> 直接生效，无需 jv: 前缀。
        ============================================================
    -->

    <!--  日历导航按钮（上月 / 下月）：悬停高亮、按下加深、禁用弱化  -->
    <ControlTemplate x:Key="DefaultCalendarNavigationButtonTemplate" TargetType="Button">
        <Border
            x:Name="Host"
            Background="Transparent"
            CornerRadius="{DynamicResource Theme.SmallCornerRadius}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Host" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Host" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  日历头部按钮（月份/年份标题，点击切换年/十年视图）  -->
    <ControlTemplate x:Key="DefaultCalendarHeaderButtonTemplate" TargetType="Button">
        <Border
            x:Name="Host"
            Padding="6,2"
            Background="Transparent"
            CornerRadius="{DynamicResource Theme.SmallCornerRadius}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontWeight="SemiBold" TextElement.Foreground="{TemplateBinding Foreground}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Host" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Host" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  CalendarItem 模板：头部导航 + 月视图(7x7) + 年视图(3x4) + 禁用蒙层  -->
    <ControlTemplate x:Key="DefaultCalendarItemTemplate" TargetType="CalendarItem">
        <ControlTemplate.Resources>
            <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                    Text="{Binding}" />
            </DataTemplate>
        </ControlTemplate.Resources>
        <Grid x:Name="PART_Root">
            <Border
                Padding="6"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{DynamicResource Theme.ControlCornerRadius}"
                SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  头部：上一页 / 标题 / 下一页  -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="PART_PreviousButton"
                            Grid.Column="0"
                            Width="24"
                            Height="24"
                            HorizontalAlignment="Left"
                            Focusable="False"
                            Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                            Template="{StaticResource DefaultCalendarNavigationButtonTemplate}">
                            <Path
                                Width="10"
                                Height="10"
                                Data="M 6.5 0.5 L 1.5 5 L 6.5 9.5"
                                Stroke="{DynamicResource Theme.Brush.Text.Secondary}"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.5"
                                Stretch="None" />
                        </Button>
                        <Button
                            x:Name="PART_HeaderButton"
                            Grid.Column="1"
                            Focusable="False"
                            Foreground="{DynamicResource Theme.Brush.Text.Primary}"
                            Template="{StaticResource DefaultCalendarHeaderButtonTemplate}" />
                        <Button
                            x:Name="PART_NextButton"
                            Grid.Column="2"
                            Width="24"
                            Height="24"
                            HorizontalAlignment="Right"
                            Focusable="False"
                            Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                            Template="{StaticResource DefaultCalendarNavigationButtonTemplate}">
                            <Path
                                Width="10"
                                Height="10"
                                Data="M 3.5 0.5 L 8.5 5 L 3.5 9.5"
                                Stroke="{DynamicResource Theme.Brush.Text.Secondary}"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.5"
                                Stretch="None" />
                        </Button>
                    </Grid>

                    <!--  月视图：7 行 x 7 列（星期标题行 + 六周，由 CalendarItem 代码填充）  -->
                    <Grid x:Name="PART_MonthView" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>

                    <!--  年视图：3 行 x 4 列（月/十年视图，由 CalendarItem 代码填充）  -->
                    <Grid
                        x:Name="PART_YearView"
                        Grid.Row="1"
                        Visibility="Hidden">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>

                    <!--  禁用蒙层（最后声明覆盖）  -->
                    <Rectangle
                        x:Name="PART_DisableVisual"
                        Grid.Row="1"
                        Fill="#A0FFFFFF"
                        RadiusX="4"
                        RadiusY="4"
                        Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PART_DisableVisual" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  CalendarDayButton：悬停/按下/今日/选中/相邻月/黑名单/禁用  -->
    <ControlTemplate x:Key="DefaultCalendarDayButtonTemplate" TargetType="CalendarDayButton">
        <Border
            x:Name="DayBackground"
            Margin="1"
            Background="Transparent"
            CornerRadius="{DynamicResource Theme.SmallCornerRadius}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="DayBackground" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Hover}" />
            </Trigger>
            <Trigger Property="IsToday" Value="True">
                <Setter TargetName="DayBackground" Property="Background" Value="{DynamicResource Theme.Brush.Accent.PrimarySubtle}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="DayBackground" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Pressed}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="DayBackground" Property="Background" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.OnAccent}" />
            </Trigger>
            <Trigger Property="IsInactive" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Tertiary}" />
            </Trigger>
            <Trigger Property="IsBlackedOut" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  CalendarButton：月 / 年单元格  -->
    <ControlTemplate x:Key="DefaultCalendarButtonTemplate" TargetType="CalendarButton">
        <Border
            x:Name="MonthBackground"
            Margin="1"
            Background="Transparent"
            CornerRadius="{DynamicResource Theme.SmallCornerRadius}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="MonthBackground" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Hover}" />
            </Trigger>
            <Trigger Property="HasSelectedDays" Value="True">
                <Setter TargetName="MonthBackground" Property="Background" Value="{DynamicResource Theme.Brush.Accent.PrimarySubtle}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  DatePicker 下拉按钮（日历图标，钉空隐式样式避免被 Button 接管）  -->
    <ControlTemplate x:Key="DefaultDatePickerCalendarButtonTemplate" TargetType="Button">
        <Border
            x:Name="Host"
            Background="Transparent"
            CornerRadius="{DynamicResource Theme.SmallCornerRadius}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Host" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Host" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  DatePickerTextBox：占位水印 + 文本宿主  -->
    <ControlTemplate x:Key="DefaultDatePickerTextBoxTemplate" TargetType="DatePickerTextBox">
        <Grid>
            <ContentControl
                x:Name="PART_Watermark"
                Margin="{TemplateBinding Padding}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{Binding Path=(atc:DatePickerAssist.PlaceHolder), RelativeSource={RelativeSource TemplatedParent}}"
                Focusable="False"
                Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                IsHitTestVisible="False"
                Opacity="0" />
            <ScrollViewer
                x:Name="PART_ContentElement"
                Margin="{TemplateBinding Padding}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                HorizontalScrollBarVisibility="Hidden"
                VerticalScrollBarVisibility="Hidden" />
        </Grid>
        <ControlTemplate.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="PART_Watermark" Property="Opacity" Value="1" />
            </MultiDataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  Calendar 主体模板：PART_Root + PART_CalendarItem  -->
    <ControlTemplate x:Key="DefaultCalendarTemplate" TargetType="Calendar">
        <StackPanel x:Name="PART_Root" HorizontalAlignment="Center">
            <CalendarItem
                x:Name="PART_CalendarItem"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" />
        </StackPanel>
    </ControlTemplate>

    <!--  DatePicker 主体模板  -->
    <ControlTemplate x:Key="DefaultDatePickerTemplate" TargetType="DatePicker">
        <Grid x:Name="PART_Root">
            <Border
                x:Name="MainBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding Border.CornerRadius}"
                SnapsToDevicePixels="True">
                <DatePickerTextBox
                    x:Name="PART_TextBox"
                    Padding="{TemplateBinding Padding}"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    FocusVisualStyle="{x:Null}"
                    FontSize="{TemplateBinding FontSize}"
                    Foreground="{TemplateBinding Foreground}" />
            </Border>

            <Button
                x:Name="PART_Button"
                Width="30"
                Margin="0,2,2,2"
                HorizontalAlignment="Right"
                Background="Transparent"
                Focusable="False"
                Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                Style="{x:Null}"
                Template="{StaticResource DefaultDatePickerCalendarButtonTemplate}">
                <Path
                    Width="14"
                    Height="14"
                    Data="M 3.5 0.75 L 3.5 3 M 10.5 0.75 L 10.5 3 M 0.75 2.5 L 13.25 2.5 L 13.25 13.25 L 0.75 13.25 Z M 0.75 5.25 L 13.25 5.25"
                    Stroke="{DynamicResource Theme.Brush.Text.Secondary}"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="1.4"
                    Stretch="None" />
            </Button>

            <Popup
                x:Name="PART_Calendar"
                AllowsTransparency="True"
                Focusable="False"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=PART_Button}"
                PopupAnimation="Fade">
                <Border
                    Margin="0,4,0,0"
                    Background="{DynamicResource Theme.Brush.Background.App}"
                    BorderBrush="{DynamicResource Theme.Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{TemplateBinding Border.CornerRadius}"
                    Effect="{DynamicResource Theme.PopupShadow}"
                    SnapsToDevicePixels="True">
                    <Calendar
                        x:Name="Calendar"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{TemplateBinding Foreground}" />
                </Border>
            </Popup>
        </Grid>

        <ControlTemplate.Triggers>
            <!--  悬停  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Strong}" />
            </Trigger>

            <!--  键盘聚焦  -->
            <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
            </Trigger>

            <!--  展开状态  -->
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
            </Trigger>

            <!--  Disabled（最后声明，保证覆盖所有状态）  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource Theme.Brush.State.DisabledSurface}" />
                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.State.DisabledBorder}" />
                <Setter TargetName="PART_TextBox" Property="Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
                <Setter TargetName="PART_Button" Property="Opacity" Value="0.5" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  CalendarItem / CalendarDayButton / CalendarButton / DatePickerTextBox 样式  -->
    <Style x:Key="DefaultCalendarItemStyle" TargetType="CalendarItem">
        <Setter Property="Template" Value="{StaticResource DefaultCalendarItemTemplate}" />
    </Style>

    <Style x:Key="DefaultCalendarDayButtonStyle" TargetType="CalendarDayButton">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource DefaultCalendarDayButtonTemplate}" />
    </Style>

    <Style x:Key="DefaultCalendarButtonStyle" TargetType="CalendarButton">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource DefaultCalendarButtonTemplate}" />
    </Style>

    <Style x:Key="DefaultDatePickerTextBoxStyle" TargetType="DatePickerTextBox">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource DefaultDatePickerTextBoxTemplate}" />
    </Style>

    <Style x:Key="DefaultCalendarStyle" TargetType="Calendar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
        <Setter Property="CalendarButtonStyle" Value="{StaticResource DefaultCalendarButtonStyle}" />
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource DefaultCalendarDayButtonStyle}" />
        <Setter Property="Template" Value="{StaticResource DefaultCalendarTemplate}" />
    </Style>

    <Style x:Key="DefaultDatePickerStyle" TargetType="DatePicker">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="{DynamicResource Theme.ControlPadding}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface.Base}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="{DynamicResource Theme.ControlCornerRadius}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template" Value="{StaticResource DefaultDatePickerTemplate}" />
    </Style>

    <!--  隐式样式（官方类型）：App 合并字典后 <DatePicker> 自动生效  -->
    <Style BasedOn="{StaticResource DefaultCalendarItemStyle}" TargetType="CalendarItem" />
    <Style BasedOn="{StaticResource DefaultCalendarDayButtonStyle}" TargetType="CalendarDayButton" />
    <Style BasedOn="{StaticResource DefaultCalendarButtonStyle}" TargetType="CalendarButton" />
    <Style BasedOn="{StaticResource DefaultDatePickerTextBoxStyle}" TargetType="DatePickerTextBox" />
    <Style BasedOn="{StaticResource DefaultCalendarStyle}" TargetType="Calendar" />
    <Style BasedOn="{StaticResource DefaultDatePickerStyle}" TargetType="DatePicker" />

</ResourceDictionary>
