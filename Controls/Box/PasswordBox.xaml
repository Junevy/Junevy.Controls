<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties"
    xmlns:bt="clr-namespace:Junevy.Controls.Controls.Button"
    xmlns:cvt="clr-namespace:Junevy.Controls.Converters"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Box">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls;component/Resources/Font/IconFont.xaml" />
        <ResourceDictionary Source="/Junevy.Controls;component/Controls/Button/Button.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <cvt:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <cvt:NullToCollapsedConverter x:Key="NullToVisibility" />
    <cvt:NullToUnsetValueConverter x:Key="NullToUnsetValue" />

    <!--  显示/隐藏密码的矢量图标（iconfont 无眼睛类字形，走 Path 绘制）：
          掩码态显示睁眼（点击查看），明文态显示斜杠闭眼（点击隐藏）  -->
    <Geometry x:Key="EyeGeometry">M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z</Geometry>
    <Geometry x:Key="EyeOffGeometry">M11.83,9L15,12.16C15,12.11 15,12.05 15,12A3,3 0 0,0 12,9C11.94,9 11.89,9 11.83,9M7.53,9.8L9.08,11.35C9.03,11.56 9,11.77 9,12A3,3 0 0,0 12,15C12.22,15 12.44,14.97 12.65,14.92L14.2,16.47C13.53,16.8 12.79,17 12,17A5,5 0 0,1 7,12C7,11.2 7.2,10.47 7.53,9.8M2,4.27L4.28,6.55L4.73,7C3.08,8.3 1.78,10 1,12C2.73,16.39 7,19.5 12,19.5C13.55,19.5 15.03,19.2 16.38,18.66L16.81,19.08L19.73,22L21,20.73L3.27,3L2,4.27Z</Geometry>

    <!--  必填标识默认图标（TitleAssist.IsRequired）：主题 Danger 色小圆点；
          未设置 IsRequiredIcon（null）时显示，设置了则让位于自定义图标  -->
    <Style x:Key="RequiredIconDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource Theme.Brush.Status.Danger}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(atc:TitleAssist.IsRequiredIcon), RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  显示密码按钮图标：颜色跟随控件 Foreground，形状随 IsRevealed 在睁眼/闭眼间切换。
          绑定以元素自身解析（Path 处于模板子树，TemplatedParent 为 jv:PasswordBox）  -->
    <Style x:Key="RevealIconStyle" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Data" Value="{StaticResource EyeGeometry}" />
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsRevealed, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                <Setter Property="Data" Value="{StaticResource EyeOffGeometry}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  显示密码按钮：与 TextBoxCloseButtonStyle 同参——无边框、无内距、Focusable=False
          （点击不夺焦点，键盘焦点保持在密码框/明文框上），Margin=1 使悬停色块收在边框内侧  -->
    <Style
        x:Key="PasswordBoxRevealButtonStyle"
        BasedOn="{StaticResource NoBorderButtonStyle}"
        TargetType="{x:Type bt:Button}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <ControlTemplate x:Key="DefaultPasswordBoxTemplate" TargetType="{x:Type local:PasswordBox}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  标题（TitleAssist）：位置由 TitlePlacement 驱动，四个方位各一个呈现器，
                  由模板触发器切换显隐；标题为空时全部折叠，不占用布局空间。
                  字体族/字号/颜色未设置（null/NaN）时首选绑定返回 UnsetValue 失败，
                  PriorityBinding 落到第二绑定继承控件自身取值；
                  TitleWidth 非 NaN 时为标题区域固定宽度（表单对齐用），NaN 时自适应内容。
                  呈现器内容为水平面板：标题文字 + 必填图标宿主（IsRequired，左/右各一个，
                  由 MultiTrigger 按 IsRequiredIconPlacement 点亮对应一侧）  -->
            <Grid
                x:Name="TitleTop"
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,0,0,4"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False"
                TextElement.FontWeight="{TemplateBinding atc:TitleAssist.TitleFontWeight}"
                Visibility="Visible"
                Width="{TemplateBinding atc:TitleAssist.TitleWidth}">
                <TextElement.FontFamily>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleFontFamily)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="FontFamily" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.FontFamily>
                <TextElement.FontSize>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleFontSize)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="FontSize" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.FontSize>
                <TextElement.Foreground>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleForeground)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="Foreground" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.Foreground>
                <StackPanel Orientation="Horizontal">
                    <StackPanel
                        x:Name="TitleTop_IconLeftHost"
                        Margin="0,0,4,0"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                        <Ellipse Style="{StaticResource RequiredIconDotStyle}" />
                        <ContentPresenter
                            Content="{TemplateBinding atc:TitleAssist.IsRequiredIcon}"
                            VerticalAlignment="Center"
                            Visibility="{TemplateBinding atc:TitleAssist.IsRequiredIcon, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                    <ContentPresenter Content="{TemplateBinding atc:TitleAssist.Title}" />
                    <StackPanel
                        x:Name="TitleTop_IconRightHost"
                        Margin="4,0,0,0"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                        <Ellipse Style="{StaticResource RequiredIconDotStyle}" />
                        <ContentPresenter
                            Content="{TemplateBinding atc:TitleAssist.IsRequiredIcon}"
                            VerticalAlignment="Center"
                            Visibility="{TemplateBinding atc:TitleAssist.IsRequiredIcon, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid
                x:Name="TitleBottom"
                Grid.Row="2"
                Grid.Column="1"
                Margin="0,4,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                TextElement.FontWeight="{TemplateBinding atc:TitleAssist.TitleFontWeight}"
                Visibility="Collapsed"
                Width="{TemplateBinding atc:TitleAssist.TitleWidth}">
                <TextElement.FontFamily>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleFontFamily)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="FontFamily" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.FontFamily>
                <TextElement.FontSize>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleFontSize)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="FontSize" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.FontSize>
                <TextElement.Foreground>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleForeground)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="Foreground" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.Foreground>
                <StackPanel Orientation="Horizontal">
                    <StackPanel
                        x:Name="TitleBottom_IconLeftHost"
                        Margin="0,0,4,0"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                        <Ellipse Style="{StaticResource RequiredIconDotStyle}" />
                        <ContentPresenter
                            Content="{TemplateBinding atc:TitleAssist.IsRequiredIcon}"
                            VerticalAlignment="Center"
                            Visibility="{TemplateBinding atc:TitleAssist.IsRequiredIcon, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                    <ContentPresenter Content="{TemplateBinding atc:TitleAssist.Title}" />
                    <StackPanel
                        x:Name="TitleBottom_IconRightHost"
                        Margin="4,0,0,0"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                        <Ellipse Style="{StaticResource RequiredIconDotStyle}" />
                        <ContentPresenter
                            Content="{TemplateBinding atc:TitleAssist.IsRequiredIcon}"
                            VerticalAlignment="Center"
                            Visibility="{TemplateBinding atc:TitleAssist.IsRequiredIcon, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid
                x:Name="TitleLeft"
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,0,4,0"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                TextElement.FontWeight="{TemplateBinding atc:TitleAssist.TitleFontWeight}"
                Visibility="Collapsed"
                Width="{TemplateBinding atc:TitleAssist.TitleWidth}">
                <TextElement.FontFamily>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleFontFamily)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="FontFamily" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.FontFamily>
                <TextElement.FontSize>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleFontSize)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="FontSize" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.FontSize>
                <TextElement.Foreground>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleForeground)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="Foreground" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.Foreground>
                <!--  固定 TitleWidth 时内容组右对齐，保持标题贴合输入框（原 TextAlignment=Right 语义）  -->
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <StackPanel
                        x:Name="TitleLeft_IconLeftHost"
                        Margin="0,0,4,0"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                        <Ellipse Style="{StaticResource RequiredIconDotStyle}" />
                        <ContentPresenter
                            Content="{TemplateBinding atc:TitleAssist.IsRequiredIcon}"
                            VerticalAlignment="Center"
                            Visibility="{TemplateBinding atc:TitleAssist.IsRequiredIcon, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                    <ContentPresenter Content="{TemplateBinding atc:TitleAssist.Title}" />
                    <StackPanel
                        x:Name="TitleLeft_IconRightHost"
                        Margin="4,0,0,0"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                        <Ellipse Style="{StaticResource RequiredIconDotStyle}" />
                        <ContentPresenter
                            Content="{TemplateBinding atc:TitleAssist.IsRequiredIcon}"
                            VerticalAlignment="Center"
                            Visibility="{TemplateBinding atc:TitleAssist.IsRequiredIcon, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid
                x:Name="TitleRight"
                Grid.Row="1"
                Grid.Column="2"
                Margin="4,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                TextElement.FontWeight="{TemplateBinding atc:TitleAssist.TitleFontWeight}"
                Visibility="Collapsed"
                Width="{TemplateBinding atc:TitleAssist.TitleWidth}">
                <TextElement.FontFamily>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleFontFamily)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="FontFamily" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.FontFamily>
                <TextElement.FontSize>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleFontSize)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="FontSize" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.FontSize>
                <TextElement.Foreground>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleForeground)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="Foreground" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.Foreground>
                <StackPanel Orientation="Horizontal">
                    <StackPanel
                        x:Name="TitleRight_IconLeftHost"
                        Margin="0,0,4,0"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                        <Ellipse Style="{StaticResource RequiredIconDotStyle}" />
                        <ContentPresenter
                            Content="{TemplateBinding atc:TitleAssist.IsRequiredIcon}"
                            VerticalAlignment="Center"
                            Visibility="{TemplateBinding atc:TitleAssist.IsRequiredIcon, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                    <ContentPresenter Content="{TemplateBinding atc:TitleAssist.Title}" />
                    <StackPanel
                        x:Name="TitleRight_IconRightHost"
                        Margin="4,0,0,0"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                        <Ellipse Style="{StaticResource RequiredIconDotStyle}" />
                        <ContentPresenter
                            Content="{TemplateBinding atc:TitleAssist.IsRequiredIcon}"
                            VerticalAlignment="Center"
                            Visibility="{TemplateBinding atc:TitleAssist.IsRequiredIcon, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!--  外层 Border（视觉与 jv:TextBox 一致：圆角、悬停描边加深、聚焦 accent）  -->
            <Border
                x:Name="Border"
                Grid.Row="1"
                Grid.Column="1"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding Border.CornerRadius}"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  错误泛红（IsError）：垫在内容之下的一层低透明度 Danger 色，
                          只把背景「微微染红」，不遮挡文字、不改边框与前景  -->
                    <Border
                        x:Name="ErrorTint"
                        Grid.ColumnSpan="3"
                        Background="{DynamicResource Theme.Brush.Status.Danger}"
                        CornerRadius="{TemplateBinding Border.CornerRadius}"
                        IsHitTestVisible="False"
                        Opacity="0.09"
                        Visibility="Collapsed" />

                    <ContentControl
                        x:Name="PART_ICON"
                        Grid.Column="0"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding atc:Icon.Icon}"
                        Focusable="False"
                        FontFamily="{TemplateBinding atc:Icon.FontFamily}"
                        TextElement.FontSize="{TemplateBinding FontSize}"
                        TextElement.Foreground="{TemplateBinding Foreground}"
                        Visibility="{TemplateBinding atc:Icon.Icon, Converter={StaticResource NullToVisibility}}" />

                    <!--  掩码宿主：内嵌原生 PasswordBox（密封类无法派生），承载真实密码编辑
                          （输入、IME、粘贴、MaxLength 等走原生管线）。Style 钉死为 null——
                          一是避免应用级隐式样式把宿主重新套上本模板造成递归，二是去掉原生 chrome 皮肤  -->
                    <PasswordBox
                        x:Name="PART_HostPasswordBox"
                        Grid.Column="1"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="{TemplateBinding FontSize}"
                        Foreground="{TemplateBinding Foreground}"
                        MaxLength="{TemplateBinding MaxLength}"
                        Padding="{TemplateBinding Padding}"
                        PasswordChar="{TemplateBinding PasswordChar}"
                        Style="{x:Null}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        VerticalContentAlignment="Center" />

                    <!--  明文宿主：显示中可直接编辑，Text 与 Password 双向绑定（值等价回写由控件代码
                          的等价检查拦停）；Style 钉死为 null，避免应用级隐式 TextBox 样式改写视觉  -->
                    <TextBox
                        x:Name="PART_RevealTextBox"
                        Grid.Column="1"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="{TemplateBinding FontSize}"
                        Foreground="{TemplateBinding Foreground}"
                        HorizontalScrollBarVisibility="Hidden"
                        MaxLength="{TemplateBinding MaxLength}"
                        Style="{x:Null}"
                        Text="{Binding Password, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="NoWrap"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        VerticalContentAlignment="Center"
                        VerticalScrollBarVisibility="Hidden"
                        Visibility="Collapsed" />

                    <!--  占位符（PlaceholderAssist）：空密码 + 未持有键盘焦点 + 未显示明文时显示
                          （MultiTrigger 条件，Password 为本控件真实依赖属性）；字体族跟随
                          Icon.FontFamily，占位内容可设 iconfont 字形  -->
                    <ContentPresenter
                        x:Name="PART_Placeholder"
                        Grid.Column="1"
                        Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding atc:PlaceholderAssist.Placeholder}"
                        IsHitTestVisible="False"
                        TextElement.FontFamily="{TemplateBinding atc:Icon.FontFamily}"
                        TextElement.FontSize="{TemplateBinding FontSize}"
                        TextElement.Foreground="{DynamicResource Theme.Brush.Text.Tertiary}"
                        Visibility="Collapsed" />

                    <!--  显示密码按钮：Click 模式点击切换、PressAndHold 模式按下显示松开隐藏，
                          行为在控件代码内按 RevealMode 分派；图标形状随 IsRevealed 切换  -->
                    <bt:Button
                        x:Name="PART_RevealButton"
                        Grid.Column="2"
                        Width="26"
                        Margin="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Style="{StaticResource PasswordBoxRevealButtonStyle}">
                        <Path Focusable="False" Style="{StaticResource RevealIconStyle}" />
                    </bt:Button>
                </Grid>
            </Border>
        </Grid>

        <ControlTemplate.Triggers>
            <!--  标题（TitleAssist）：无标题时四个方位全部折叠；位置触发器只切换对应方位的显隐  -->
            <Trigger Property="atc:TitleAssist.Title" Value="{x:Null}">
                <Setter TargetName="TitleTop" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="TitleBottom" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="TitleLeft" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="TitleRight" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="atc:TitleAssist.TitlePlacement" Value="Bottom">
                <Setter TargetName="TitleTop" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="TitleBottom" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="atc:TitleAssist.TitlePlacement" Value="Left">
                <Setter TargetName="TitleTop" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="TitleLeft" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="atc:TitleAssist.TitlePlacement" Value="Right">
                <Setter TargetName="TitleTop" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="TitleRight" Property="Visibility" Value="Visible" />
            </Trigger>

            <!--  必填标识（TitleAssist.IsRequired）：四个方位的图标宿主默认全部折叠；
                  IsRequired=true 时按 IsRequiredIconPlacement 点亮对应一侧的四个宿主，
                  宿主内部再按 IsRequiredIcon 是否为空切换「默认小圆点 / 自定义图标」；
                  无标题时标题呈现器整体折叠，必填标识随标题一起隐藏  -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="atc:TitleAssist.IsRequired" Value="True" />
                    <Condition Property="atc:TitleAssist.IsRequiredIconPlacement" Value="Right" />
                </MultiTrigger.Conditions>
                <Setter TargetName="TitleTop_IconRightHost" Property="Visibility" Value="Visible" />
                <Setter TargetName="TitleBottom_IconRightHost" Property="Visibility" Value="Visible" />
                <Setter TargetName="TitleLeft_IconRightHost" Property="Visibility" Value="Visible" />
                <Setter TargetName="TitleRight_IconRightHost" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="atc:TitleAssist.IsRequired" Value="True" />
                    <Condition Property="atc:TitleAssist.IsRequiredIconPlacement" Value="Left" />
                </MultiTrigger.Conditions>
                <Setter TargetName="TitleTop_IconLeftHost" Property="Visibility" Value="Visible" />
                <Setter TargetName="TitleBottom_IconLeftHost" Property="Visibility" Value="Visible" />
                <Setter TargetName="TitleLeft_IconLeftHost" Property="Visibility" Value="Visible" />
                <Setter TargetName="TitleRight_IconLeftHost" Property="Visibility" Value="Visible" />
            </MultiTrigger>

            <!--  明文显示（IsRevealed）：掩码宿主与明文宿主互斥切换  -->
            <Trigger Property="local:PasswordBox.IsRevealed" Value="True">
                <Setter TargetName="PART_HostPasswordBox" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_RevealTextBox" Property="Visibility" Value="Visible" />
            </Trigger>

            <!--  错误泛红（IsError）：点亮垫底的 Danger 色薄层  -->
            <Trigger Property="local:PasswordBox.IsError" Value="True">
                <Setter TargetName="ErrorTint" Property="Visibility" Value="Visible" />
            </Trigger>

            <!--  占位符：密码为空、未持有键盘焦点（掩码框/明文框都不在焦点链内）且未显示明文时可见  -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="local:PasswordBox.Password" Value="" />
                    <Condition Property="IsKeyboardFocusWithin" Value="False" />
                    <Condition Property="local:PasswordBox.IsRevealed" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_Placeholder" Property="Visibility" Value="Visible" />
            </MultiTrigger>

            <!--  聚焦时边框高亮（现代感）  -->
            <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
                <Setter TargetName="Border" Property="BorderThickness" Value="1" />
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Focused}" />
            </Trigger>

            <!--  鼠标悬停时轻微变化  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Strong}" />
            </Trigger>

            <!--  禁用态  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource Theme.Brush.State.DisabledSurface}" />
                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Theme.Brush.State.DisabledBorder}" />
                <Setter TargetName="PART_Placeholder" Property="TextElement.Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <!--  PasswordBox 主样式：模板复合控件，Focusable=False 让 Tab 直接落到模板内的
          掩码宿主（真实输入位），光标用 IBeam 提示可输入  -->
    <Style x:Key="DefaultPasswordBoxStyle" TargetType="{x:Type local:PasswordBox}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
        <Setter Property="atc:Icon.FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface.Base}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Secondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="{DynamicResource Theme.ControlCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource Theme.ControlPadding}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="atc:TitleAssist.TitleForeground" Value="{DynamicResource Theme.Brush.Text.Secondary}" />
        <Setter Property="Template" Value="{StaticResource DefaultPasswordBoxTemplate}" />
    </Style>


    <!--  隐式样式（派生类型）：jv:PasswordBox 照常使用主题样式。
          不提供原生 PasswordBox 的隐式样式：原生类型是密封类，模板复合方案（内嵌原生宿主）
          的触发器/绑定都挂在 jv:PasswordBox 的依赖属性上，无法安全套用到原生实例——
          强行套用会出现「按钮无行为、占位符失效」的半残样式，故保持原生默认外观。  -->
    <Style BasedOn="{StaticResource DefaultPasswordBoxStyle}" TargetType="{x:Type local:PasswordBox}" />
</ResourceDictionary>
