<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties"
    xmlns:paging="clr-namespace:Junevy.Controls.Controls.Paging"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Box">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls;component/Generic/Style/DefaultFocusStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  Orientation=Horizontal 时替换默认竖向面板：项目自左向右排列并沿水平方向虚拟化滚动  -->
    <ItemsPanelTemplate x:Key="DefaultListBoxHorizontalItemsPanel">
        <VirtualizingStackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <Style x:Key="DefaultListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <!--  Item 前景跟随宿主 ListBox.Foreground（默认样式给宿主的是随主题的 Text.Secondary，
              宿主在实例上覆盖时条目同步跟随，撤销覆盖用 ClearValue）。  -->
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />
        <Setter Property="Padding" Value="{DynamicResource Theme.ContentMargin}" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        x:Name="ItemBorder"
                        Margin="{TemplateBinding Margin}"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{DynamicResource Theme.SmallCornerRadius}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                            RecognizesAccessKey="True"
                            TextElement.FontFamily="{TemplateBinding FontFamily}"
                            TextElement.FontSize="{TemplateBinding FontSize}"
                            TextElement.FontStretch="{TemplateBinding FontStretch}"
                            TextElement.FontStyle="{TemplateBinding FontStyle}"
                            TextElement.FontWeight="{TemplateBinding FontWeight}"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Hover}" />
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Subtle}" />
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Selected}" />
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Theme.Brush.Accent.PrimarySubtle}" />
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent.PrimaryHover}" />
                        </MultiTrigger>

                        <!--  焦点环只给未选中项：选中项描边固定用主色，避免键盘焦点后主色被焦点青覆盖  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocusWithin" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Focus}" />
                        </MultiTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Theme.Brush.State.DisabledSurface}" />
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.State.DisabledBorder}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface.Base}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Secondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="{DynamicResource Theme.ControlCornerRadius}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />

        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <!--  像素滚动：偏移不再吸附到条目边界，滚轮补间（SmoothScrolling）才能连续滑动  -->
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <!--  预生成视口前后各一页的容器：容器生成（模板展开/绑定/测量）提前到滚动到达之前，
              消除补间滚动跨越条目边界时的实体化顿挫；代价约为两页容器的额外内存  -->
        <Setter Property="VirtualizingPanel.CacheLength" Value="1,1" />
        <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page" />
        <!--  平滑滚轮默认开启：滚轮刻度补间滚动，实例上设 atc:SmoothScrolling.IsEnabled=False 可单独关闭  -->
        <Setter Property="atc:SmoothScrolling.IsEnabled" Value="True" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DefaultListBoxItemStyle}" />

        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border
                        x:Name="Root"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding Border.CornerRadius}"
                        SnapsToDevicePixels="True">
                        <DockPanel>
                            <!--  分页页脚：atc:PagingAssist.HasPager 为真时出现，方位随 atc:PagingAssist.Placement  -->
                            <Border
                                x:Name="PagingFooter"
                                DockPanel.Dock="Bottom"
                                Padding="4,3"
                                Background="{DynamicResource Theme.Brush.Surface.Base}"
                                BorderBrush="{DynamicResource Theme.Brush.Border.Divider}"
                                BorderThickness="0,1,0,0"
                                Visibility="Collapsed">
                                <paging:DataPager x:Name="Pager" />
                            </Border>

                            <ScrollViewer
                                x:Name="PART_ScrollViewer"
                                CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                Focusable="False"
                                HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Strong}" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Focus}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.Brush.State.DisabledSurface}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Theme.Brush.State.DisabledBorder}" />
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
                        </Trigger>

                        <!--
                            分页页脚显隐与方位：读宿主上的附加属性。
                            这里必须用 Trigger（Property=附加属性）而不是
                            DataTrigger + Binding(RelativeSource TemplatedParent)——后者在
                            ControlTemplate.Triggers 内解析不到 TemplatedParent，方位会整体失效。
                        -->
                        <Trigger Property="atc:PagingAssist.HasPager" Value="True">
                            <Setter TargetName="PagingFooter" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="atc:PagingAssist.Placement" Value="Top">
                            <Setter TargetName="PagingFooter" Property="DockPanel.Dock" Value="Top" />
                            <Setter TargetName="PagingFooter" Property="BorderThickness" Value="0,0,0,1" />
                            <Setter TargetName="Pager" Property="Orientation" Value="Horizontal" />
                        </Trigger>
                        <Trigger Property="atc:PagingAssist.Placement" Value="Left">
                            <Setter TargetName="PagingFooter" Property="DockPanel.Dock" Value="Left" />
                            <Setter TargetName="PagingFooter" Property="BorderThickness" Value="0,0,1,0" />
                            <Setter TargetName="Pager" Property="Orientation" Value="Vertical" />
                        </Trigger>
                        <Trigger Property="atc:PagingAssist.Placement" Value="Right">
                            <Setter TargetName="PagingFooter" Property="DockPanel.Dock" Value="Right" />
                            <Setter TargetName="PagingFooter" Property="BorderThickness" Value="1,0,0,0" />
                            <Setter TargetName="Pager" Property="Orientation" Value="Vertical" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsGrouping" Value="True" />
                                <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  隐式样式（官方类型）：App 合并字典后 <ListBox> 自动生效  -->
    <Style BasedOn="{StaticResource DefaultListBoxStyle}" TargetType="ListBox" />

    <!--  隐式样式（派生类型）：jv:ListBox 照常使用主题样式，并额外支持水平滑动  -->
    <Style BasedOn="{StaticResource DefaultListBoxStyle}" TargetType="{x:Type local:ListBox}">
        <Style.Triggers>
            <!--
                Orientation=Horizontal：项目横向排列，水平滚动条按需显示、垂直滚动条关闭。
                值回到 Vertical 时触发器失效，自动恢复基样式的竖向面板与滚动条设置，
                因此运行时切换方向无需重建控件。
            -->
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ItemsPanel" Value="{StaticResource DefaultListBoxHorizontalItemsPanel}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
