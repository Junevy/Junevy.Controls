<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Box">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls;component/Generic/Style/DefaultFocusStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <ControlTemplate x:Key="DefaultCheckBoxTemplate" TargetType="CheckBox">
        <Grid Background="Transparent">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">

                <!--  勾选框  -->
                <Border
                    x:Name="CheckBorder"
                    Width="18"
                    Height="18"
                    Background="Transparent"
                    BorderBrush="{DynamicResource Theme.Brush.Border.Strong}"
                    BorderThickness="1.5"
                    CornerRadius="{DynamicResource Theme.SmallCornerRadius}">

                    <!--  勾选标记：矢量对勾，几何包围盒恰好等于元素盒（0,0 起算 + 显式宽高），居中时不会因笔画或坐标偏移而偏心  -->
                    <Path
                        x:Name="CheckMark"
                        Width="9"
                        Height="6.5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M 0,3.5 L 3,6.5 L 9,0"
                        Opacity="0"
                        Stroke="{DynamicResource Theme.Brush.Text.OnAccent}"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="1.5" />
                </Border>

                <!--  文本  -->
                <ContentPresenter
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    RecognizesAccessKey="True" />

            </StackPanel>
        </Grid>

        <ControlTemplate.Triggers>

            <!--  Hover  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
                <Setter TargetName="CheckBorder" Property="Background" Value="Transparent" />
            </Trigger>

            <!--  Checked  -->
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent.PrimaryHover}" />
                <Setter TargetName="CheckMark" Property="Opacity" Value="1" />
            </Trigger>

            <!--  Checked + Hover  -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource Theme.Brush.Accent.PrimaryHover}" />
                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent.PrimaryHover}" />
            </MultiTrigger>

            <!--  Pressed（按下反馈：未勾选时边框加深 + 底色浮现）  -->
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent.PrimaryHover}" />
                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource Theme.Brush.Accent.PrimarySubtle}" />
            </Trigger>

            <!--  Checked + Pressed（按下反馈：勾选底色加深）  -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True" />
                    <Condition Property="IsPressed" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource Theme.Brush.Accent.PrimaryPressed}" />
                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent.PrimaryPressed}" />
            </MultiTrigger>

            <!--  Disabled（最后声明，保证覆盖所有状态）  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.State.DisabledBorder}" />
                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource Theme.Brush.State.DisabledSurface}" />
                <Setter TargetName="CheckMark" Property="Stroke" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
            </Trigger>

        </ControlTemplate.Triggers>
    </ControlTemplate>


    <Style x:Key="DefaultCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Secondary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Border.CornerRadius" Value="{DynamicResource Theme.SmallCornerRadius}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource DefaultCheckBoxTemplate}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.Brush.Text.Secondary}" />
    </Style>

    <!--  隐式样式（官方类型）：App 合并字典后 <CheckBox> 自动生效  -->
    <Style BasedOn="{StaticResource DefaultCheckBoxStyle}" TargetType="CheckBox" />

    <!--  隐式样式（派生类型）：jv:CheckBox 照常使用主题样式  -->
    <Style BasedOn="{StaticResource DefaultCheckBoxStyle}" TargetType="{x:Type local:CheckBox}" />
</ResourceDictionary>
