<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties"
    xmlns:cvt="clr-namespace:Junevy.Controls.Converters"
    xmlns:paging="clr-namespace:Junevy.Controls.Controls.Paging"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Box">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls;component/Generic/Style/DefaultFocusStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <cvt:IsGridViewConverter x:Key="IsGridViewConverter" />
    <cvt:GridViewColumnsConverter x:Key="GridViewColumnsConverter" />

    <!--  Orientation=Horizontal 时替换默认竖向面板：项目自左向右排列并沿水平方向虚拟化滚动  -->
    <ItemsPanelTemplate x:Key="DefaultListViewHorizontalItemsPanel">
        <VirtualizingStackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <Style x:Key="DefaultListViewColumnHeaderStyle" TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface.Sunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Secondary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="{DynamicResource Theme.ContentMargin}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border
                        x:Name="HeaderBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                            RecognizesAccessKey="True"
                            TextElement.FontFamily="{TemplateBinding FontFamily}"
                            TextElement.FontSize="{TemplateBinding FontSize}"
                            TextElement.FontWeight="{TemplateBinding FontWeight}"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Theme.Brush.State.DisabledSurface}" />
                            <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.State.DisabledBorder}" />
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <!--  Item 前景跟随宿主 ListView.Foreground（默认样式给宿主的是随主题的 Text.Secondary，
              宿主在实例上覆盖时条目同步跟随，撤销覆盖用 ClearValue）。  -->
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}" />
        <Setter Property="Padding" Value="{DynamicResource Theme.ContentMargin}" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border
                        x:Name="ItemBorder"
                        Margin="{TemplateBinding Margin}"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{DynamicResource Theme.SmallCornerRadius}"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <GridViewRowPresenter
                                x:Name="GridViewContent"
                                Content="{TemplateBinding Content}"
                                Columns="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListView}}, Path=View, Converter={StaticResource GridViewColumnsConverter}}"
                                TextElement.FontFamily="{TemplateBinding FontFamily}"
                                TextElement.FontSize="{TemplateBinding FontSize}"
                                TextElement.FontStretch="{TemplateBinding FontStretch}"
                                TextElement.FontStyle="{TemplateBinding FontStyle}"
                                TextElement.FontWeight="{TemplateBinding FontWeight}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                            <ContentPresenter
                                x:Name="ContentSite"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                RecognizesAccessKey="True"
                                TextElement.FontFamily="{TemplateBinding FontFamily}"
                                TextElement.FontSize="{TemplateBinding FontSize}"
                                TextElement.FontStretch="{TemplateBinding FontStretch}"
                                TextElement.FontStyle="{TemplateBinding FontStyle}"
                                TextElement.FontWeight="{TemplateBinding FontWeight}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <DataTrigger
                            Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListView}}, Path=View, Converter={StaticResource IsGridViewConverter}}"
                            Value="False">
                            <Setter TargetName="GridViewContent" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Hover}" />
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Subtle}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Selected}" />
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Theme.Brush.Accent.PrimarySubtle}" />
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent.PrimaryHover}" />
                        </MultiTrigger>
                        <!--  焦点环只给未选中项：选中项描边固定用主色，避免键盘焦点后主色被焦点青覆盖  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocusWithin" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Focus}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Theme.Brush.State.DisabledSurface}" />
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.State.DisabledBorder}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="DefaultListViewTemplate" TargetType="ListView">
        <Border
            x:Name="Root"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding Border.CornerRadius}"
            SnapsToDevicePixels="True">
            <DockPanel>
                <!--  分页页脚：atc:PagingAssist.HasPager 为真时出现，方位随 atc:PagingAssist.Placement  -->
                <Border
                    x:Name="PagingFooter"
                    DockPanel.Dock="Bottom"
                    Padding="4,3"
                    Background="{DynamicResource Theme.Brush.Surface.Base}"
                    BorderBrush="{DynamicResource Theme.Brush.Border.Divider}"
                    BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                    <paging:DataPager x:Name="Pager" />
                </Border>
                <ScrollViewer
                    x:Name="PART_ScrollViewer"
                    CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                    Focusable="False"
                    HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                    <ItemsPresenter />
                </ScrollViewer>
            </DockPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Strong}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Focus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.Brush.State.DisabledSurface}" />
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Theme.Brush.State.DisabledBorder}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsGrouping" Value="True" />
                    <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            </MultiTrigger>
            <!--
                分页页脚显隐与方位：读宿主上的附加属性。
                必须用 Trigger（Property=附加属性）：DataTrigger + Binding(RelativeSource TemplatedParent)
                在 ControlTemplate.Triggers 内解析不到 TemplatedParent，方位会整体失效。
            -->
            <Trigger Property="atc:PagingAssist.HasPager" Value="True">
                <Setter TargetName="PagingFooter" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="atc:PagingAssist.Placement" Value="Top">
                <Setter TargetName="PagingFooter" Property="DockPanel.Dock" Value="Top" />
                <Setter TargetName="PagingFooter" Property="BorderThickness" Value="0,0,0,1" />
                <Setter TargetName="Pager" Property="Orientation" Value="Horizontal" />
            </Trigger>
            <Trigger Property="atc:PagingAssist.Placement" Value="Left">
                <Setter TargetName="PagingFooter" Property="DockPanel.Dock" Value="Left" />
                <Setter TargetName="PagingFooter" Property="BorderThickness" Value="0,0,1,0" />
                <Setter TargetName="Pager" Property="Orientation" Value="Vertical" />
            </Trigger>
            <Trigger Property="atc:PagingAssist.Placement" Value="Right">
                <Setter TargetName="PagingFooter" Property="DockPanel.Dock" Value="Right" />
                <Setter TargetName="PagingFooter" Property="BorderThickness" Value="1,0,0,0" />
                <Setter TargetName="Pager" Property="Orientation" Value="Vertical" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="DefaultGridViewListViewTemplate" TargetType="ListView">
        <ControlTemplate.Resources>
            <Style
                BasedOn="{StaticResource DefaultListViewColumnHeaderStyle}"
                TargetType="GridViewColumnHeader" />
        </ControlTemplate.Resources>
        <Border
            x:Name="Root"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding Border.CornerRadius}"
            SnapsToDevicePixels="True">
            <DockPanel>
                <!--  分页页脚：atc:PagingAssist.HasPager 为真时出现，方位随 atc:PagingAssist.Placement  -->
                <Border
                    x:Name="PagingFooter"
                    DockPanel.Dock="Bottom"
                    Padding="4,3"
                    Background="{DynamicResource Theme.Brush.Surface.Base}"
                    BorderBrush="{DynamicResource Theme.Brush.Border.Divider}"
                    BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                    <paging:DataPager x:Name="Pager" />
                </Border>
                <ScrollViewer
                    x:Name="PART_ScrollViewer"
                    Padding="{TemplateBinding Padding}"
                    CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                    Focusable="False"
                    HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    Style="{DynamicResource {x:Static GridView.GridViewScrollViewerStyleKey}}"
                    VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                </ScrollViewer>
            </DockPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Strong}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Focus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.Brush.State.DisabledSurface}" />
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Theme.Brush.State.DisabledBorder}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsGrouping" Value="True" />
                    <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            </MultiTrigger>
            <!--  GridView 视图模板同样要响应分页附加属性：显隐与方位写法同上  -->
            <Trigger Property="atc:PagingAssist.HasPager" Value="True">
                <Setter TargetName="PagingFooter" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="atc:PagingAssist.Placement" Value="Top">
                <Setter TargetName="PagingFooter" Property="DockPanel.Dock" Value="Top" />
                <Setter TargetName="PagingFooter" Property="BorderThickness" Value="0,0,0,1" />
                <Setter TargetName="Pager" Property="Orientation" Value="Horizontal" />
            </Trigger>
            <Trigger Property="atc:PagingAssist.Placement" Value="Left">
                <Setter TargetName="PagingFooter" Property="DockPanel.Dock" Value="Left" />
                <Setter TargetName="PagingFooter" Property="BorderThickness" Value="0,0,1,0" />
                <Setter TargetName="Pager" Property="Orientation" Value="Vertical" />
            </Trigger>
            <Trigger Property="atc:PagingAssist.Placement" Value="Right">
                <Setter TargetName="PagingFooter" Property="DockPanel.Dock" Value="Right" />
                <Setter TargetName="PagingFooter" Property="BorderThickness" Value="1,0,0,0" />
                <Setter TargetName="Pager" Property="Orientation" Value="Vertical" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="DefaultListViewStyle" TargetType="ListView">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface.Base}" />
        <!--  控件默认前景对齐「常规控件文字 = 次级」约定（与 ListBox 一致，原为 Text.Primary）：
              Item 前景经 AncestorType 绑定宿主，此值即条目默认文字色（选中项仍由触发器升为一级）。  -->
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Secondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="{DynamicResource Theme.ControlCornerRadius}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <!--  像素滚动：偏移不再吸附到条目边界，滚轮补间（SmoothScrolling）才能连续滑动  -->
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <!--  预生成视口前后各一页的容器：容器生成提前到滚动到达之前，消除补间中的实体化顿挫  -->
        <Setter Property="VirtualizingPanel.CacheLength" Value="1,1" />
        <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page" />
        <!--  平滑滚轮默认开启：滚轮刻度补间滚动，实例上设 atc:SmoothScrolling.IsEnabled=False 可单独关闭  -->
        <Setter Property="atc:SmoothScrolling.IsEnabled" Value="True" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DefaultListViewItemStyle}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template" Value="{StaticResource DefaultListViewTemplate}" />
    </Style>

    <!--  隐式样式（官方类型）：App 合并字典后 <ListView> 自动生效  -->
    <Style BasedOn="{StaticResource DefaultListViewStyle}" TargetType="ListView">
        <Style.Triggers>
            <DataTrigger Binding="{Binding View, RelativeSource={RelativeSource Self}, Converter={StaticResource IsGridViewConverter}}"
                         Value="True">
                <Setter Property="Template" Value="{StaticResource DefaultGridViewListViewTemplate}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  隐式样式（派生类型）：jv:ListView 照常使用主题样式，并额外支持水平滑动  -->
    <Style BasedOn="{StaticResource DefaultListViewStyle}" TargetType="{x:Type local:ListView}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding View, RelativeSource={RelativeSource Self}, Converter={StaticResource IsGridViewConverter}}"
                         Value="True">
                <Setter Property="Template" Value="{StaticResource DefaultGridViewListViewTemplate}" />
            </DataTrigger>

            <!--
                Orientation=Horizontal 且未设置 View（普通列表）：项目横向排列，
                水平滚动条按需显示、垂直滚动条关闭。设置 GridView 等视图时条件不成立，
                列表维持竖向排列，避免破坏列布局与表头。
            -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Orientation" Value="Horizontal" />
                    <Condition Property="View" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ItemsPanel" Value="{StaticResource DefaultListViewHorizontalItemsPanel}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
