<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties"
    xmlns:cvt="clr-namespace:Junevy.Controls.Converters"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Expander">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls;component/Resources/Font/IconFont.xaml" />
        <ResourceDictionary Source="/Junevy.Controls;component/Generic/Style/DefaultFocusStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <cvt:NullToCollapsedConverter x:Key="NullToVisibility" />

    <!--  卡片式模板（DisplayMode=Card）：头部整块是 ToggleButton（点击 / Space 切换），
          HeaderExtra 作为其上的兄弟覆盖层——命中测试只落在实际内容上，右侧控件独立交互
          不会误触发展开，空白区域点击穿透到头部照常切换；内容区经 ScaleTransform 收放
          （动画由控件代码驱动，与经典模板共用 PART_ContentHost / PART_ScaleTransform 契约）  -->
    <ControlTemplate x:Key="CardExpanderPanelTemplate" TargetType="{x:Type local:ExpanderPanel}">
        <Border
            x:Name="CardRoot"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{DynamicResource Theme.ControlCornerRadius}"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
            <DockPanel LastChildFill="True">
                <Grid DockPanel.Dock="Top">
                    <ToggleButton
                        x:Name="PART_HeaderButton"
                        Background="Transparent"
                        BorderThickness="0"
                        FocusVisualStyle="{DynamicResource DefaultControlFocusVisualStyle}"
                        Foreground="{TemplateBinding Foreground}"
                        IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                        SnapsToDevicePixels="True">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                <Border
                                    x:Name="HeaderRoot"
                                    Padding="12,10,10,10"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{DynamicResource Theme.ControlCornerRadius}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--  图标槽：iconfont 字形或任意内容（Icon），为空时折叠不占位；
                                              字体族/字号跟随 atc:Icon.FontFamily / atc:Icon.IconSize  -->
                                        <ContentPresenter
                                            x:Name="IconHost"
                                            Grid.Column="0"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Content="{Binding Icon, RelativeSource={RelativeSource AncestorType={x:Type local:ExpanderPanel}}}"
                                            TextElement.FontFamily="{Binding Path=(atc:Icon.FontFamily), RelativeSource={RelativeSource AncestorType={x:Type local:ExpanderPanel}}}"
                                            TextElement.FontSize="{Binding Path=(atc:Icon.IconSize), RelativeSource={RelativeSource AncestorType={x:Type local:ExpanderPanel}}}"
                                            TextElement.Foreground="{TemplateBinding Foreground}"
                                            Visibility="{Binding Icon, Converter={StaticResource NullToVisibility}, RelativeSource={RelativeSource AncestorType={x:Type local:ExpanderPanel}}}" />

                                        <!--  标题（Header）加粗，补充说明（Description）次级色小号；说明为空时
                                              整体折叠，头部自动变矮  -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <ContentPresenter
                                                Content="{Binding Header, RelativeSource={RelativeSource AncestorType={x:Type local:ExpanderPanel}}}"
                                                RecognizesAccessKey="True"
                                                TextElement.FontWeight="SemiBold"
                                                TextElement.Foreground="{TemplateBinding Foreground}" />
                                            <ContentPresenter
                                                x:Name="DescriptionHost"
                                                Margin="0,2,0,0"
                                                Content="{Binding Description, RelativeSource={RelativeSource AncestorType={x:Type local:ExpanderPanel}}}"
                                                TextElement.FontSize="12"
                                                TextElement.Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                                                Visibility="{Binding Description, Converter={StaticResource NullToVisibility}, RelativeSource={RelativeSource AncestorType={x:Type local:ExpanderPanel}}}" />
                                        </StackPanel>

                                        <!--  展开箭头：折叠朝下、展开朝上（与卡片展开语义一致），随 IsChecked 旋转  -->
                                        <TextBlock
                                            x:Name="Chevron"
                                            Grid.Column="2"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            FontFamily="{DynamicResource IconFont}"
                                            FontSize="12"
                                            Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                                            RenderTransformOrigin="0.5,0.5"
                                            Text="&#xE650;">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="90" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Chevron" Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="270" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="HeaderRoot" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Hover}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <!--  右侧扩展槽（HeaderExtra）：置于头部按钮之上的兄弟层，右侧留出箭头槽位。
                          其中按钮/开关等交互控件按下即标记事件已处理，不会冒泡到头部按钮误触发展开  -->
                    <ContentPresenter
                        x:Name="HeaderExtraHost"
                        Margin="0,0,26,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding HeaderExtra}" />
                </Grid>

                <Grid x:Name="PART_ContentHost" ClipToBounds="True">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="PART_ScaleTransform" ScaleX="1" ScaleY="1" />
                    </Grid.LayoutTransform>
                    <ContentPresenter Margin="{TemplateBinding Padding}" ContentSource="Content" />
                </Grid>
            </DockPanel>
        </Border>
    </ControlTemplate>


    <Style TargetType="{x:Type local:ExpanderPanel}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ExpanderPanel}">
                    <DockPanel LastChildFill="True">
                        <ToggleButton
                            x:Name="PART_HeaderButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Content="{TemplateBinding Header}"
                            DockPanel.Dock="Top"
                            FocusVisualStyle="{DynamicResource DefaultControlFocusVisualStyle}"
                            Foreground="{TemplateBinding Foreground}"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            SnapsToDevicePixels="True">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border
                                        x:Name="HeaderRoot"
                                        Padding="0,4"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="{DynamicResource Theme.SmallCornerRadius}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                x:Name="Arrow"
                                                Margin="2,0"
                                                VerticalAlignment="Center"
                                                FontFamily="{DynamicResource IconFont}"
                                                FontSize="10"
                                                Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                                                RenderTransformOrigin="0.5,0.5"
                                                Text="&#xE650;">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform Angle="0" />
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                            <ContentPresenter
                                                Content="{TemplateBinding Content}"
                                                RecognizesAccessKey="True"
                                                TextElement.Foreground="{TemplateBinding Foreground}" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HeaderRoot" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Hover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Grid x:Name="PART_ContentHost" ClipToBounds="True">
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="PART_ScaleTransform" ScaleX="1" ScaleY="1" />
                            </Grid.LayoutTransform>
                            <ContentPresenter ContentSource="Content" />
                        </Grid>
                    </DockPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="ExpandDirection" Value="Up">
                            <Setter TargetName="PART_HeaderButton" Property="DockPanel.Dock" Value="Bottom" />
                        </Trigger>
                        <!--  Left：内容向左展开，头部停靠右侧；与 WPF Expander 语义一致  -->
                        <Trigger Property="ExpandDirection" Value="Left">
                            <Setter TargetName="PART_HeaderButton" Property="DockPanel.Dock" Value="Right" />
                        </Trigger>
                        <Trigger Property="ExpandDirection" Value="Right">
                            <Setter TargetName="PART_HeaderButton" Property="DockPanel.Dock" Value="Left" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <!--  卡片模式：高头部（图标 + 标题/补充说明 + 右侧扩展槽 + 展开箭头），整卡有底色描边，
                  内容向下展开（ExpandDirection 仅 Classic 模式生效）。图标字体/字号经 atc:Icon 附加属性
                  提供默认值，实例可覆盖  -->
            <Trigger Property="DisplayMode" Value="Card">
                <Setter Property="Template" Value="{StaticResource CardExpanderPanelTemplate}" />
                <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface.Base}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Default}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,2,14,14" />
                <Setter Property="atc:Icon.FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="atc:Icon.IconSize" Value="20" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
