<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Text">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls;component/Themes/AppColors.xaml" />
        <ResourceDictionary Source="/Junevy.Controls.Resources;component/Font/IconFont.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <ControlTemplate x:Key="DefaultLabelTemplate" TargetType="{x:Type local:Label}">
        <Border
            x:Name="Bd"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            CornerRadius="3"
            SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal">

                <ContentControl
                    Margin="5,0,5,0"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Content="{Binding RelativeSource={RelativeSource AncestorType=local:Label}, Path=(atc:Icon.Icon)}"
                    FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:Label}, Path=(atc:Icon.FontFamily)}"
                    FontSize="{TemplateBinding FontSize}"
                    Foreground="{TemplateBinding Foreground}" />
                <ContentPresenter
                    Margin="0,0,5,0"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    RecognizesAccessKey="True" />
            </StackPanel>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="ErrorLabelTemplate" TargetType="{x:Type local:Label}">
        <Border
            x:Name="Bd"
            Padding="{TemplateBinding Padding}"
            Background="#FFDC2626"
            CornerRadius="3"
            SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal">

                <ContentControl
                    Margin="5,0,5,0"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Content="&#xe61a;"
                    FontFamily="{StaticResource IconFont}"
                    FontSize="{TemplateBinding FontSize}"
                    Foreground="{TemplateBinding Foreground}" />
                <ContentPresenter
                    Margin="0,0,5,0"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    RecognizesAccessKey="True" />
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFEF4444" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="SuccessLabelTemplate" TargetType="{x:Type local:Label}">
        <Border
            x:Name="Bd"
            Padding="{TemplateBinding Padding}"
            Background="#FF16A34A"
            CornerRadius="3"
            SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal">
                <ContentControl
                    Margin="5,0,5,0"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Content="&#xe613;"
                    FontFamily="{StaticResource IconFont}"
                    FontSize="{TemplateBinding FontSize}"
                    Foreground="{TemplateBinding Foreground}" />
                <ContentPresenter
                    Margin="0,0,5,0"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    RecognizesAccessKey="True" />
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FF22C55E" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="WarningLabelTemplate" TargetType="{x:Type local:Label}">
        <Border
            x:Name="Bd"
            Padding="{TemplateBinding Padding}"
            Background="#FFF59E0B"
            CornerRadius="3"
            SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal">

                <ContentControl
                    Margin="5,0,5,0"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Content="&#xe932;"
                    FontFamily="{StaticResource IconFont}"
                    FontSize="{TemplateBinding FontSize}"
                    Foreground="{TemplateBinding Foreground}" />
                <ContentPresenter
                    Margin="0,0,5,0"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    RecognizesAccessKey="True" />
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFFBBF24" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="AccentLabelTemplate" TargetType="{x:Type local:Label}">
        <Border
            x:Name="Bd"
            Padding="{TemplateBinding Padding}"
            Background="{StaticResource AppColor}"
            CornerRadius="3"
            SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal">
                <ContentControl
                    Margin="5,0,5,0"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Content="{Binding RelativeSource={RelativeSource AncestorType=local:Label}, Path=(atc:Icon.Icon)}"
                    FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:Label}, Path=(atc:Icon.FontFamily)}"
                    FontSize="{TemplateBinding FontSize}"
                    Foreground="{TemplateBinding Foreground}" />
                <ContentPresenter
                    Margin="0,0,5,0"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    RecognizesAccessKey="True" />
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FF3B82F6" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="BoxLabelStyle" TargetType="{x:Type local:Label}">
        <Setter Property="Background" Value="{StaticResource AppColor}" />
        <Setter Property="Foreground" Value="{StaticResource DarkTextFillColor}" />
        <Setter Property="FontSize" Value="8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="2,2" />
        <Setter Property="FontFamily" Value="Arial" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource DefaultLabelTemplate}" />
        <Style.Triggers>
            <!--<Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SubAppColor}" />
            </Trigger>-->

            <Trigger Property="DisplayMode" Value="0">
                <Setter Property="Template" Value="{StaticResource ErrorLabelTemplate}" />
            </Trigger>

            <Trigger Property="DisplayMode" Value="1">
                <Setter Property="Template" Value="{StaticResource SuccessLabelTemplate}" />
            </Trigger>

            <Trigger Property="DisplayMode" Value="-1">
                <Setter Property="Template" Value="{StaticResource WarningLabelTemplate}" />
            </Trigger>

            <Trigger Property="DisplayMode" Value="100">
                <Setter Property="Template" Value="{StaticResource DefaultLabelTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>


    <!--  轮廓/描边标签  -->
    <Style
        x:Key="DefaultLabelStyle"
        BasedOn="{StaticResource BoxLabelStyle}"
        TargetType="{x:Type local:Label}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AppColor}" />
        <Setter Property="TextElement.FontSize" Value="8" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource DarkTextFillColor}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Label}">
                    <Border
                        x:Name="Bd"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{StaticResource AppColor}"
                        BorderThickness="1"
                        CornerRadius="3"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>

                            <ContentControl
                                Grid.Column="0"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{Binding RelativeSource={RelativeSource AncestorType=local:Label}, Path=(atc:Icon.Icon)}"
                                FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:Label}, Path=(atc:Icon.FontFamily)}"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{TemplateBinding Foreground}" />

                            <ContentPresenter
                                Grid.Column="1"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
                        </Grid>

                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubAppColor}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource BoxLabelStyle}" TargetType="{x:Type local:Label}" />
    <Style BasedOn="{StaticResource BoxLabelStyle}" TargetType="Label" />
</ResourceDictionary>