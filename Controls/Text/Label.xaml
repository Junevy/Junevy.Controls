<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties"
    xmlns:cvt="clr-namespace:Junevy.Controls.Converters"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Text">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls;component/Resources/Font/IconFont.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <cvt:NullToCollapsedConverter x:Key="NullToVisibility" />

    <!--
        带背景标签模板（Error/Success/Warning/Neutral 共用）：
        背景跟随 Background，由样式按 DisplayMode 注入状态色；
        图标由 atc:Icon.Icon 提供（样式触发器注入各模式的默认图标，用户可用局部值覆盖），为空时折叠图标区域。
    -->
    <ControlTemplate x:Key="BoxedLabelTemplate" TargetType="{x:Type local:Label}">
        <Border
            x:Name="Bd"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            CornerRadius="{DynamicResource Theme.SmallCornerRadius}"
            SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal">
                <ContentControl
                    x:Name="IconPresenter"
                    Margin="5,0,5,0"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Content="{Binding RelativeSource={RelativeSource AncestorType=local:Label}, Path=(atc:Icon.Icon)}"
                    FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:Label}, Path=(atc:Icon.FontFamily)}"
                    FontSize="{TemplateBinding FontSize}"
                    Foreground="{TemplateBinding Foreground}"
                    Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:Label}, Path=(atc:Icon.Icon), Converter={StaticResource NullToVisibility}}" />
                <ContentPresenter
                    Margin="0,0,5,0"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    RecognizesAccessKey="True" />
            </StackPanel>
        </Border>
    </ControlTemplate>

    <!--
        无边框标签模板（BorderlessError/BorderlessWarning/BorderlessNotice 共用）：
        无背景色块，图标由 atc:Icon.Icon 提供（样式触发器注入默认图标，用户可覆盖），内容由 Content 提供。
    -->
    <ControlTemplate x:Key="PlainLabelTemplate" TargetType="{x:Type local:Label}">
        <StackPanel Orientation="Horizontal">
            <ContentControl
                x:Name="IconPresenter"
                Margin="5,0,5,0"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{Binding RelativeSource={RelativeSource AncestorType=local:Label}, Path=(atc:Icon.Icon)}"
                FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:Label}, Path=(atc:Icon.FontFamily)}"
                FontSize="{TemplateBinding FontSize}"
                Foreground="{TemplateBinding Foreground}"
                Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:Label}, Path=(atc:Icon.Icon), Converter={StaticResource NullToVisibility}}" />
            <ContentPresenter
                Margin="0"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                RecognizesAccessKey="True" />
        </StackPanel>
    </ControlTemplate>

    <Style x:Key="BoxLabelStyle" TargetType="{x:Type local:Label}">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.OnAccent}" />
        <Setter Property="FontSize" Value="8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="2,2" />
        <Setter Property="FontFamily" Value="Arial" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource BoxedLabelTemplate}" />
        <Style.Triggers>
            <Trigger Property="DisplayMode" Value="Error">
                <Setter Property="Background" Value="{DynamicResource Theme.Brush.Status.Danger}" />
                <Setter Property="atc:Icon.Icon" Value="&#xe61a;" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="DisplayMode" Value="Error" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Theme.Brush.Status.DangerHover}" />
            </MultiTrigger>

            <Trigger Property="DisplayMode" Value="Success">
                <Setter Property="Background" Value="{DynamicResource Theme.Brush.Status.Success}" />
                <Setter Property="atc:Icon.Icon" Value="&#xe613;" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="DisplayMode" Value="Success" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Theme.Brush.Status.SuccessHover}" />
            </MultiTrigger>

            <Trigger Property="DisplayMode" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource Theme.Brush.Status.Warning}" />
                <Setter Property="atc:Icon.Icon" Value="&#xe932;" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="DisplayMode" Value="Warning" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Theme.Brush.Status.WarningHover}" />
            </MultiTrigger>

            <Trigger Property="DisplayMode" Value="BorderlessError">
                <Setter Property="Template" Value="{StaticResource PlainLabelTemplate}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Status.Danger}" />
                <Setter Property="atc:Icon.Icon" Value="&#xe61a;" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="14" />
            </Trigger>

            <Trigger Property="DisplayMode" Value="BorderlessWarning">
                <Setter Property="Template" Value="{StaticResource PlainLabelTemplate}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Status.Warning}" />
                <Setter Property="atc:Icon.Icon" Value="&#xe932;" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="14" />
            </Trigger>

            <Trigger Property="DisplayMode" Value="BorderlessNotice">
                <Setter Property="Template" Value="{StaticResource PlainLabelTemplate}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
                <Setter Property="atc:Icon.Icon" Value="&#xe651;" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="14" />
            </Trigger>
        </Style.Triggers>
    </Style>


    <Style BasedOn="{StaticResource BoxLabelStyle}" TargetType="{x:Type local:Label}" />
</ResourceDictionary>
