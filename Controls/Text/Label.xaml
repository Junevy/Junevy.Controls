<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties"
    xmlns:cvt="clr-namespace:Junevy.Controls.Converters"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Text">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls;component/Resources/Font/IconFont.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <cvt:NullToCollapsedConverter x:Key="NullToVisibility" />

    <!--
        带背景标签模板（Error/Success/Warning/Neutral 共用）：
        背景跟随 Background，由样式按 DisplayMode 注入状态色；
        图标由 atc:Icon.Icon 提供（样式触发器注入各模式的默认图标，用户可用局部值覆盖），为空时折叠图标区域。
        图标与文字的 5px 间距全部由图标右侧 Margin 承载（图标折叠后不留残余间距），
        Padding 负责左右 7px 呼吸位——有图标/无图标两种形态下内容块均相对边缘对称；
        水平对齐经 StackPanel 落实 HorizontalContentAlignment（垂直对齐仍由内容项各自绑定）。
        图标字号/颜色经 atc:Icon.IconSize / atc:Icon.IconForeground 注入（样式给各模式默认值，用户可局部覆盖）。
    -->
    <ControlTemplate x:Key="BoxedLabelTemplate" TargetType="{x:Type local:Label}">
        <Border
            x:Name="Bd"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            CornerRadius="{DynamicResource Theme.SmallCornerRadius}"
            SnapsToDevicePixels="True">
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                <ContentControl
                    x:Name="IconPresenter"
                    Margin="0,0,5,0"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Content="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(atc:Icon.Icon)}"
                    FontFamily="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(atc:Icon.FontFamily)}"
                    FontSize="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(atc:Icon.IconSize)}"
                    Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(atc:Icon.IconForeground)}"
                    Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(atc:Icon.Icon), Converter={StaticResource NullToVisibility}}" />
                <ContentPresenter
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    RecognizesAccessKey="True" />
            </StackPanel>
        </Border>
    </ControlTemplate>

    <!--
        无边框标签模板（BorderlessError/BorderlessWarning/BorderlessNotice 共用）：
        无背景色块，图标由 atc:Icon.Icon 提供（样式触发器注入默认图标，用户可覆盖），内容由 Content 提供。
        间距策略与带背景模板一致：5px 图文间距全由图标右侧 Margin 承载。
    -->
    <ControlTemplate x:Key="PlainLabelTemplate" TargetType="{x:Type local:Label}">
        <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
            <ContentControl
                x:Name="IconPresenter"
                Margin="0,0,5,0"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(atc:Icon.Icon)}"
                FontFamily="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(atc:Icon.FontFamily)}"
                FontSize="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(atc:Icon.IconSize)}"
                Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(atc:Icon.IconForeground)}"
                Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(atc:Icon.Icon), Converter={StaticResource NullToVisibility}}" />
            <ContentPresenter
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                RecognizesAccessKey="True" />
        </StackPanel>
    </ControlTemplate>

    <Style x:Key="BoxLabelStyle" TargetType="{x:Type local:Label}">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.OnAccent}" />
        <Setter Property="FontSize" Value="8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="FontFamily" Value="Arial" />
        <Setter Property="atc:Icon.IconSize" Value="8" />
        <Setter Property="atc:Icon.IconForeground" Value="{DynamicResource Theme.Brush.Text.OnAccent}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource BoxedLabelTemplate}" />
        <Style.Triggers>
            <Trigger Property="DisplayMode" Value="Error">
                <Setter Property="Background" Value="{DynamicResource Theme.Brush.Status.Danger}" />
                <Setter Property="atc:Icon.Icon" Value="&#xe61a;" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="DisplayMode" Value="Error" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Theme.Brush.Status.DangerHover}" />
            </MultiTrigger>

            <Trigger Property="DisplayMode" Value="Success">
                <Setter Property="Background" Value="{DynamicResource Theme.Brush.Status.Success}" />
                <Setter Property="atc:Icon.Icon" Value="&#xe613;" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="DisplayMode" Value="Success" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Theme.Brush.Status.SuccessHover}" />
            </MultiTrigger>

            <Trigger Property="DisplayMode" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource Theme.Brush.Status.Warning}" />
                <Setter Property="atc:Icon.Icon" Value="&#xe932;" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="DisplayMode" Value="Warning" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Theme.Brush.Status.WarningHover}" />
            </MultiTrigger>

            <!--  Neutral：默认中性灰底（Theme.Brush.Status.Neutral），用户可用局部 Background 覆盖（局部值优先于触发器，
                  悬停变色随覆盖自然失效）；前景保持 OnAccent，局部改底色的既有用法不受影响。Neutral 无默认图标。  -->
            <Trigger Property="DisplayMode" Value="Neutral">
                <Setter Property="Background" Value="{DynamicResource Theme.Brush.Status.Neutral}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="DisplayMode" Value="Neutral" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Theme.Brush.Status.NeutralHover}" />
            </MultiTrigger>

            <Trigger Property="DisplayMode" Value="BorderlessError">
                <Setter Property="Template" Value="{StaticResource PlainLabelTemplate}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Status.Danger}" />
                <Setter Property="atc:Icon.Icon" Value="&#xe61a;" />
                <Setter Property="atc:Icon.IconSize" Value="14" />
                <Setter Property="atc:Icon.IconForeground" Value="{DynamicResource Theme.Brush.Status.Danger}" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="14" />
            </Trigger>

            <Trigger Property="DisplayMode" Value="BorderlessWarning">
                <Setter Property="Template" Value="{StaticResource PlainLabelTemplate}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Status.Warning}" />
                <Setter Property="atc:Icon.Icon" Value="&#xe932;" />
                <Setter Property="atc:Icon.IconSize" Value="14" />
                <Setter Property="atc:Icon.IconForeground" Value="{DynamicResource Theme.Brush.Status.Warning}" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="14" />
            </Trigger>

            <Trigger Property="DisplayMode" Value="BorderlessNotice">
                <Setter Property="Template" Value="{StaticResource PlainLabelTemplate}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
                <Setter Property="atc:Icon.Icon" Value="&#xe651;" />
                <Setter Property="atc:Icon.IconSize" Value="14" />
                <Setter Property="atc:Icon.IconForeground" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="14" />
            </Trigger>

            <!--  Disabled：整体弱化。  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>


    <Style BasedOn="{StaticResource BoxLabelStyle}" TargetType="{x:Type local:Label}" />
</ResourceDictionary>
