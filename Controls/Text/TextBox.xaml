<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties"
    xmlns:bt="clr-namespace:Junevy.Controls.Controls.Button"
    xmlns:cvt="clr-namespace:Junevy.Controls.Converters"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Text">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls;component/Resources/Font/IconFont.xaml" />
        <ResourceDictionary Source="/Junevy.Controls;component/Generic/Style/DefaultFocusStyle.xaml" />
        <ResourceDictionary Source="/Junevy.Controls;component/Controls/Button/Button.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <cvt:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <cvt:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <cvt:NullToUnsetValueConverter x:Key="NullToUnsetValue" />

    <Style
        x:Key="TextBoxCloseButtonStyle"
        BasedOn="{StaticResource NoBorderButtonStyle}"
        TargetType="{x:Type bt:Button}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <ControlTemplate x:Key="DefaultTextBoxTemplate" TargetType="TextBox">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  标题（TitleAssist）：位置由 TitlePlacement 驱动，四个方位各一个呈现器，
                  由模板触发器切换显隐；标题为空时全部折叠，不占用布局空间。
                  字体族/字号/颜色未设置（null/NaN）时首选绑定返回 UnsetValue 失败，
                  PriorityBinding 落到第二绑定继承控件自身取值；
                  TitleWidth 非 NaN 时为标题区域固定宽度（表单对齐用），NaN 时自适应内容  -->
            <ContentPresenter
                x:Name="TitleTop"
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,0,0,4"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Content="{TemplateBinding atc:TitleAssist.Title}"
                IsHitTestVisible="False"
                TextElement.FontWeight="{TemplateBinding atc:TitleAssist.TitleFontWeight}"
                Visibility="Visible"
                Width="{TemplateBinding atc:TitleAssist.TitleWidth}">
                <TextElement.FontFamily>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleFontFamily)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="FontFamily" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.FontFamily>
                <TextElement.FontSize>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleFontSize)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="FontSize" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.FontSize>
                <TextElement.Foreground>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleForeground)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="Foreground" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.Foreground>
            </ContentPresenter>

            <ContentPresenter
                x:Name="TitleBottom"
                Grid.Row="2"
                Grid.Column="1"
                Margin="0,4,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Content="{TemplateBinding atc:TitleAssist.Title}"
                IsHitTestVisible="False"
                TextElement.FontWeight="{TemplateBinding atc:TitleAssist.TitleFontWeight}"
                Visibility="Collapsed"
                Width="{TemplateBinding atc:TitleAssist.TitleWidth}">
                <TextElement.FontFamily>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleFontFamily)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="FontFamily" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.FontFamily>
                <TextElement.FontSize>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleFontSize)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="FontSize" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.FontSize>
                <TextElement.Foreground>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleForeground)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="Foreground" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.Foreground>
            </ContentPresenter>

            <ContentPresenter
                x:Name="TitleLeft"
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,0,4,0"
                VerticalAlignment="Center"
                Content="{TemplateBinding atc:TitleAssist.Title}"
                IsHitTestVisible="False"
                TextBlock.TextAlignment="Right"
                TextElement.FontWeight="{TemplateBinding atc:TitleAssist.TitleFontWeight}"
                Visibility="Collapsed"
                Width="{TemplateBinding atc:TitleAssist.TitleWidth}">
                <TextElement.FontFamily>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleFontFamily)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="FontFamily" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.FontFamily>
                <TextElement.FontSize>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleFontSize)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="FontSize" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.FontSize>
                <TextElement.Foreground>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleForeground)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="Foreground" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.Foreground>
            </ContentPresenter>

            <ContentPresenter
                x:Name="TitleRight"
                Grid.Row="1"
                Grid.Column="2"
                Margin="4,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Content="{TemplateBinding atc:TitleAssist.Title}"
                IsHitTestVisible="False"
                TextElement.FontWeight="{TemplateBinding atc:TitleAssist.TitleFontWeight}"
                Visibility="Collapsed"
                Width="{TemplateBinding atc:TitleAssist.TitleWidth}">
                <TextElement.FontFamily>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleFontFamily)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="FontFamily" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.FontFamily>
                <TextElement.FontSize>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleFontSize)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="FontSize" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.FontSize>
                <TextElement.Foreground>
                    <PriorityBinding>
                        <Binding Converter="{StaticResource NullToUnsetValue}" Path="(atc:TitleAssist.TitleForeground)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="Foreground" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.Foreground>
            </ContentPresenter>

            <!--  澶栧眰 Border  -->
            <Border
                x:Name="Border"
                Grid.Row="1"
                Grid.Column="1"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding Border.CornerRadius}"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <ContentControl
                        x:Name="PART_ICON"
                        Grid.Column="0"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding atc:Icon.Icon}"
                        Focusable="False"
                        FontFamily="{TemplateBinding atc:Icon.FontFamily}"
                        TextElement.FontSize="{TemplateBinding FontSize}"
                        TextElement.Foreground="{TemplateBinding Foreground}"
                        Visibility="{TemplateBinding atc:Icon.Icon, Converter={StaticResource NullToVisibility}}" />

                    <ScrollViewer
                        x:Name="PART_ContentHost"
                        Grid.Column="1"
                        Margin="0"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Hidden" />

                    <!--  占位符（PlaceholderAssist）：无值且未聚焦时显示；
                          字体族跟随 Icon.FontFamily，占位内容可设 iconfont 字形  -->
                    <ContentPresenter
                        x:Name="PlaceholderText"
                        Grid.Column="1"
                        Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding atc:PlaceholderAssist.Placeholder}"
                        IsHitTestVisible="False"
                        TextElement.FontFamily="{TemplateBinding atc:Icon.FontFamily}"
                        TextElement.FontSize="{TemplateBinding FontSize}"
                        TextElement.Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                        Visibility="Collapsed" />

                    <!--  清空按钮：显式 TextBlock 承载字形——图标字体默认行高的 ascent/descent 不对称，
                          自动生成的文本行会让字形整体偏上；强制行高 = 字号（BlockLineHeight）使字形随 em 框居中，
                          FontSize 变化时自适应。Margin=1 使悬停色块整体收在边框内侧，不压边框线与圆角  -->
                    <bt:Button
                        x:Name="PART_ClearButton"
                        Grid.Column="2"
                        Width="26"
                        Margin="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Style="{StaticResource TextBoxCloseButtonStyle}"
                        Visibility="{Binding Path=(local:TextBox.ShowClear), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            FontFamily="{TemplateBinding atc:Icon.FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            Foreground="{TemplateBinding Foreground}"
                            Text="&#xe639;"
                            TextAlignment="Center" />
                    </bt:Button>

                    <!--  命令按钮（CommandButton）：ShowCommandButton 控制显隐，与清空按钮互斥——
                          ShowClear 为 true（清空按钮显示）时本按钮强制隐藏；元素默认 Collapsed，
                          由模板触发器在「ShowCommandButton=true 且 ShowClear=false」时置为 Visible。
                          命令/参数/内容经三个 DP 绑定到 TemplatedParent，字体族/字号/颜色与清空按钮一致  -->
                    <bt:Button
                        x:Name="PART_CommandButton"
                        Grid.Column="2"
                        Width="26"
                        Margin="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Command="{Binding Path=(local:TextBox.CommandButtonCommand), RelativeSource={RelativeSource TemplatedParent}}"
                        CommandParameter="{Binding Path=(local:TextBox.CommandButtonCommandParameter), RelativeSource={RelativeSource TemplatedParent}}"
                        Content="{Binding Path=(local:TextBox.CommandButtonContent), RelativeSource={RelativeSource TemplatedParent}}"
                        Style="{StaticResource TextBoxCloseButtonStyle}"
                        TextElement.FontFamily="{TemplateBinding atc:Icon.FontFamily}"
                        TextElement.FontSize="{TemplateBinding FontSize}"
                        TextElement.Foreground="{TemplateBinding Foreground}"
                        Visibility="Collapsed" />
                </Grid>
            </Border>


        </Grid>

        <ControlTemplate.Triggers>
            <!--  标题（TitleAssist）：无标题时四个方位全部折叠；位置触发器只切换对应方位的显隐  -->
            <Trigger Property="atc:TitleAssist.Title" Value="{x:Null}">
                <Setter TargetName="TitleTop" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="TitleBottom" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="TitleLeft" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="TitleRight" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="atc:TitleAssist.TitlePlacement" Value="Bottom">
                <Setter TargetName="TitleTop" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="TitleBottom" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="atc:TitleAssist.TitlePlacement" Value="Left">
                <Setter TargetName="TitleTop" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="TitleLeft" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="atc:TitleAssist.TitlePlacement" Value="Right">
                <Setter TargetName="TitleTop" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="TitleRight" Property="Visibility" Value="Visible" />
            </Trigger>

            <!--<Trigger Property="" Value="{x:Null}">
                <Setter TargetName="PART_ICON" Property="Visibility" Value="Collapsed" />
            </Trigger>-->

            <!--  褰?Text 涓虹┖ 涓?鏈幏寰楃劍鐐?鏃舵樉绀哄崰浣嶇  -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Text" Value="" />
                    <Condition Property="IsFocused" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
            </MultiTrigger>

            <!--  命令按钮（CommandButton）：仅在「ShowCommandButton=true 且 ShowClear=false（清空按钮不显示）」时
                  显示，保证与清空按钮互斥；其余状态保持元素默认 Collapsed  -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="local:TextBox.ShowCommandButton" Value="True" />
                    <Condition Property="local:TextBox.ShowClear" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_CommandButton" Property="Visibility" Value="Visible" />
            </MultiTrigger>

            <!--  鐒︾偣鏃惰竟妗嗛珮浜紙鐜颁唬鎰燂級  -->
            <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
                <Setter TargetName="Border" Property="BorderThickness" Value="1" />
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Sunken}" />
            </Trigger>


            <!--  榧犳爣鎮仠鏃惰交寰彉鍖? -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Strong}" />
            </Trigger>

            <!--  只读态：底色下沉 + 光标恢复箭头（区别于可编辑态）  -->
            <Trigger Property="IsReadOnly" Value="True">
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Sunken}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource Theme.Brush.State.DisabledSurface}" />
                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Theme.Brush.State.DisabledBorder}" />
                <Setter TargetName="PlaceholderText" Property="TextElement.Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <ControlTemplate x:Key="NoBorderTextBoxTemplate" TargetType="{x:Type local:TextBox}">
        <Border
            x:Name="TextBoxHost"
            BorderBrush="{DynamicResource Theme.Brush.Accent.Primary}"
            BorderThickness="0">
            <ScrollViewer
                x:Name="PART_ContentHost"
                Grid.Column="1"
                Margin="0"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                HorizontalScrollBarVisibility="Hidden"
                VerticalScrollBarVisibility="Hidden" />
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="NoBorderTextBoxTemplate_WPF" TargetType="TextBox">
        <Border
            x:Name="TextBoxHost"
            Padding="5"
            BorderBrush="{DynamicResource Theme.Brush.Border.Default}"
            BorderThickness="0">
            <ScrollViewer
                x:Name="PART_ContentHost"
                Grid.Column="1"
                Margin="0,0,0,0"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                HorizontalScrollBarVisibility="Hidden"
                VerticalScrollBarVisibility="Hidden" />
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsReadOnly" Value="False">
                <Setter TargetName="TextBoxHost" Property="BorderThickness" Value="0,0,0,2" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <Style x:Key="DefaultTextBoxStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="atc:Icon.FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface.Base}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="{DynamicResource Theme.ControlCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource Theme.ControlPadding}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="local:TextBox.ShowClear" Value="True" />
        <Setter Property="atc:TitleAssist.TitleForeground" Value="{DynamicResource Theme.Brush.Text.Secondary}" />
        <Setter Property="Template" Value="{StaticResource DefaultTextBoxTemplate}" />
    </Style>


    <!--  隐式样式（官方类型）：App 合并字典后 <TextBox> 自动生效。
          注意：清空按钮的 Click 处理在 jv:TextBox 子类中，原生 TextBox 上仅外观生效。  -->
    <Style BasedOn="{StaticResource DefaultTextBoxStyle}" TargetType="TextBox" />

    <!--  隐式样式（派生类型）：jv:TextBox 照常使用主题样式  -->
    <Style BasedOn="{StaticResource DefaultTextBoxStyle}" TargetType="{x:Type local:TextBox}" />

</ResourceDictionary>
