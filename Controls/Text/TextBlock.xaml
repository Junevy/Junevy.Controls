<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties"
    xmlns:cvt="clr-namespace:Junevy.Controls.Converters"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Text">

    <cvt:NullToCollapsedConverter x:Key="NullToVisibility" />

    <!--
        TextBlock 模板：左侧图标槽 + 右侧 Text，本控件不承载内容（图标一律走 atc:Icon.* 附加属性）。
        图标由 atc:Icon.Icon 提供（可为图标字体字符、Image、Path 等任意内容），为空时整块折叠；
        图标与标题的 5px 间距全部由图标右侧 Margin 承载——图标折叠后标题不留残余缩进。
        图标字号/颜色经 atc:Icon.IconSize / atc:Icon.IconForeground 注入（样式给默认值，用户可局部覆盖）；
        IconSize 是 int，而 ContentControl.FontSize 是 double，TemplateBinding 不做类型转换会静默失效，
        故此处用 TemplatedParent 绑定读取附加属性（与 Label 模板同一写法）。
        对齐方式、内边距与字体排印均由模板绑定驱动，可在使用处覆盖；
        标题文本超宽时以省略号截断，不硬裁剪。
    -->
    <ControlTemplate x:Key="DefaultTextBlockTemplate" TargetType="{x:Type local:TextBlock}">
        <Grid Margin="{TemplateBinding Padding}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ContentControl
                x:Name="IconPresenter"
                Grid.Column="0"
                Margin="0,0,5,0"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(atc:Icon.Icon)}"
                FontFamily="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(atc:Icon.FontFamily)}"
                FontSize="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(atc:Icon.IconSize)}"
                Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(atc:Icon.IconForeground)}"
                Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(atc:Icon.Icon), Converter={StaticResource NullToVisibility}}" />

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                FontFamily="{TemplateBinding FontFamily}"
                FontSize="{TemplateBinding FontSize}"
                FontStretch="{TemplateBinding FontStretch}"
                FontStyle="{TemplateBinding FontStyle}"
                FontWeight="{TemplateBinding FontWeight}"
                Foreground="{TemplateBinding Foreground}"
                Text="{TemplateBinding Text}"
                TextAlignment="{TemplateBinding TextAlignment}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="{TemplateBinding TextWrapping}" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="DefaultTextBlockStyle" TargetType="{x:Type local:TextBlock}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
        <!--  图标默认与标题同色（跟随主题令牌）；图标字号沿用 atc:Icon.IconSize 的库级默认 14，
              标题字号大于 14 时需同步设置 atc:Icon.IconSize。两者均可被局部值覆盖。  -->
        <Setter Property="atc:Icon.IconForeground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="Template" Value="{StaticResource DefaultTextBlockTemplate}" />
    </Style>

    <Style BasedOn="{StaticResource DefaultTextBlockStyle}" TargetType="{x:Type local:TextBlock}" />

</ResourceDictionary>
