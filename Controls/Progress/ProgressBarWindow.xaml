<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bt="clr-namespace:Junevy.Controls.Controls.Button"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Progress">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls;component/Resources/Font/IconFont.xaml" />
        <ResourceDictionary Source="/Junevy.Controls;component/Controls/Button/Button.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  对话框右上角关闭按钮：中性悬停  -->
    <Style
        x:Key="ProgressBarWindowCloseButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="{x:Type bt:Button}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Tertiary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type bt:Button}">
                    <Border
                        x:Name="ContentBorder"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource Theme.SmallCornerRadius}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ContentSource="Content"
                            RecognizesAccessKey="True"
                            TextElement.FontFamily="{TemplateBinding FontFamily}"
                            TextElement.FontSize="{TemplateBinding FontSize}"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Pressed}" />
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:ProgressBarWindow}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ProgressBarWindow}">
                    <Border
                        Margin="14"
                        Background="{DynamicResource Theme.Brush.Surface.Base}"
                        BorderBrush="{DynamicResource Theme.Brush.Border.Default}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Theme.ControlCornerRadius}"
                        Effect="{DynamicResource Theme.PopupShadow}"
                        SnapsToDevicePixels="True">
                        <Grid Margin="20,14,14,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  标题与关闭按钮  -->
                            <Grid x:Name="HeaderRow" Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Theme.Brush.Text.Primary}" />
                                <bt:Button
                                    x:Name="CloseButton"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Command="{x:Static SystemCommands.CloseWindowCommand}"
                                    Content="&#xE639;"
                                    FontFamily="{StaticResource IconFont}"
                                    FontSize="12"
                                    Style="{StaticResource ProgressBarWindowCloseButtonStyle}" />
                            </Grid>

                            <!--  进度条与说明文本  -->
                            <StackPanel Grid.Row="1" Margin="0,6,0,0">
                                <local:ProgressBar
                                    x:Name="PART_ProgressBar"
                                    HorizontalAlignment="Center"
                                    ShowProgressText="True"
                                    IsIndeterminate="{TemplateBinding IsIndeterminate}"
                                    ShapeMode="{TemplateBinding ShapeMode}"
                                    RingThickness="{TemplateBinding RingThickness}"
                                    Minimum="{TemplateBinding Minimum}"
                                    Maximum="{TemplateBinding Maximum}"
                                    Value="{TemplateBinding Value}" />
                                <TextBlock
                                    x:Name="MessageHost"
                                    Margin="0,14,0,0"
                                    HorizontalAlignment="Center"
                                    Text="{TemplateBinding Message}"
                                    FontSize="14"
                                    Foreground="{DynamicResource Theme.Brush.Text.Primary}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="DetailHost"
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    Text="{TemplateBinding Detail}"
                                    FontSize="12"
                                    Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="CloseButtonEnabled" Value="False">
                            <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Message" Value="{x:Null}">
                            <Setter TargetName="MessageHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Detail" Value="{x:Null}">
                            <Setter TargetName="DetailHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <DataTrigger Binding="{Binding ShapeMode, RelativeSource={RelativeSource TemplatedParent}}" Value="Rectangular">
                            <Setter TargetName="PART_ProgressBar" Property="Width" Value="380" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
