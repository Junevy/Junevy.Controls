<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Image">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls.Resources;component/Pictures/Image.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:ImageViewer}">
        <Setter Property="Background" Value="{DynamicResource Theme.BackgroundBrush}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ImageViewer}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource Theme.BorderBrush}"
                        BorderThickness="1"
                        ClipToBounds="True"
                        CornerRadius="{DynamicResource Theme.LargeCornerRadius}">
                        <Grid>
                            <Image
                                x:Name="BackgroundPattern"
                                Opacity="0.25"
                                Source="{TemplateBinding BackgroundImage}"
                                Stretch="UniformToFill" />
                            <Image
                                x:Name="PART_Image"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                SnapsToDevicePixels="True"
                                Source="{TemplateBinding Source}"
                                Stretch="Uniform" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="BackgroundImage" Value="{x:Null}">
                            <Setter TargetName="BackgroundPattern" Property="Source" Value="{StaticResource whiteCheckBoard}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
