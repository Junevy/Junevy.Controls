<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cvt="clr-namespace:Junevy.Controls.Converters"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Image">

    <cvt:ImageInfoValueConverter x:Key="ImageInfoValue" />

    <!--  Icon-only button used by the built-in toolbar  -->
    <Style x:Key="ViewerToolButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource Theme.SmallCornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Info-bar text styles  -->
    <Style x:Key="ViewerInfoLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Secondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,4,0" />
    </Style>

    <Style x:Key="ViewerInfoValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="ViewerInfoUnitStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Tertiary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="2,1,8,0" />
    </Style>

    <Style TargetType="{x:Type local:ImageViewer}">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Background.App}" />
        <Setter Property="CheckerboardBrush" Value="{DynamicResource Theme.Brush.ImageViewer.Checkerboard}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ImageViewer}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource Theme.Brush.Border.Default}"
                        BorderThickness="1"
                        ClipToBounds="True"
                        CornerRadius="{DynamicResource Theme.LargeCornerRadius}">
                        <Grid>
                            <!--  Checkerboard drawn with geometry — shows through transparent pixels  -->
                            <Border Background="{TemplateBinding CheckerboardBrush}" />

                            <Image
                                x:Name="PART_Image"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                SnapsToDevicePixels="True"
                                Source="{TemplateBinding Source}"
                                Stretch="None" />

                            <!--  Toolbar — backdrop at 0.5 opacity, content fully opaque  -->
                            <Grid
                                x:Name="PART_ToolBar"
                                Margin="8"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                                <Border
                                    Background="{DynamicResource Theme.Brush.Surface.Base}"
                                    BorderBrush="{DynamicResource Theme.Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Theme.ControlCornerRadius}"
                                    Opacity="0.5" />
                                <StackPanel Margin="2,1" Orientation="Horizontal">
                                    <Button
                                        Command="{Binding ZoomInCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                        Style="{StaticResource ViewerToolButtonStyle}"
                                        ToolTip="放大">
                                        <Path
                                            Width="16"
                                            Height="16"
                                            Data="M3.5,10.5 A7,7 0 1 1 17.5,10.5 A7,7 0 1 1 3.5,10.5 Z M10.5,7.2 V13.8 M7.2,10.5 H13.8 M15.9,15.9 L20.3,20.3"
                                            Stretch="Uniform"
                                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="2" />
                                    </Button>
                                    <Button
                                        Command="{Binding ZoomOutCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                        Style="{StaticResource ViewerToolButtonStyle}"
                                        ToolTip="缩小">
                                        <Path
                                            Width="16"
                                            Height="16"
                                            Data="M3.5,10.5 A7,7 0 1 1 17.5,10.5 A7,7 0 1 1 3.5,10.5 Z M7.2,10.5 H13.8 M15.9,15.9 L20.3,20.3"
                                            Stretch="Uniform"
                                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="2" />
                                    </Button>
                                    <Border
                                        Width="1"
                                        Height="14"
                                        Margin="2,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Theme.Brush.Border.Default}" />
                                    <TextBlock
                                        MinWidth="40"
                                        Margin="4,0,6,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{DynamicResource Theme.Brush.Text.Primary}"
                                        Text="{Binding Zoom, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0%}}"
                                        TextAlignment="Center" />
                                    <Border
                                        Width="1"
                                        Height="14"
                                        Margin="2,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Theme.Brush.Border.Default}" />
                                    <Button
                                        Command="{Binding SaveCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                        Style="{StaticResource ViewerToolButtonStyle}"
                                        ToolTip="保存图像">
                                        <Path
                                            Width="16"
                                            Height="16"
                                            Data="M4.5,5.5 A2,2 0 0 1 6.5,3.5 H15 L19.5,8 V18.5 A2,2 0 0 1 17.5,20.5 H6.5 A2,2 0 0 1 4.5,18.5 Z M8,3.5 V8.5 H14.5 V3.5 M8,20.5 V13 H16 V20.5"
                                            Stretch="Uniform"
                                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="2" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!--  Info bar — fixed height, backdrop at 0.5 opacity, content fully opaque  -->
                            <Grid
                                x:Name="PART_InfoBar"
                                Height="26"
                                Margin="8,0,8,8"
                                VerticalAlignment="Bottom">
                                <Border
                                    Background="{DynamicResource Theme.Brush.Surface.Base}"
                                    BorderBrush="{DynamicResource Theme.Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Theme.SmallCornerRadius}"
                                    Opacity="0.5" />
                                <StackPanel Margin="10,0" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ViewerInfoLabelStyle}" Text="宽" />
                                    <TextBlock Style="{StaticResource ViewerInfoValueStyle}" Text="{Binding ImageWidth, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ImageInfoValue}, ConverterParameter=0}" />
                                    <TextBlock Style="{StaticResource ViewerInfoLabelStyle}" Text="高" />
                                    <TextBlock Style="{StaticResource ViewerInfoValueStyle}" Text="{Binding ImageHeight, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ImageInfoValue}, ConverterParameter=0}" />
                                    <Border
                                        Width="1"
                                        Height="12"
                                        Margin="2,0,10,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Theme.Brush.Border.Default}" />
                                    <TextBlock Style="{StaticResource ViewerInfoLabelStyle}" Text="分辨率" />
                                    <TextBlock
                                        Margin="0,0,2,0"
                                        Style="{StaticResource ViewerInfoValueStyle}"
                                        Text="{Binding ResolutionX, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ImageInfoValue}, ConverterParameter=0.#}" />
                                    <TextBlock Style="{StaticResource ViewerInfoUnitStyle}" Text="×" />
                                    <TextBlock Style="{StaticResource ViewerInfoValueStyle}" Text="{Binding ResolutionY, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ImageInfoValue}, ConverterParameter=0.#}" />
                                    <TextBlock Style="{StaticResource ViewerInfoUnitStyle}" Text="dpi" />
                                    <Border
                                        Width="1"
                                        Height="12"
                                        Margin="2,0,10,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Theme.Brush.Border.Default}" />
                                    <TextBlock Style="{StaticResource ViewerInfoLabelStyle}" Text="帧率" />
                                    <TextBlock
                                        Margin="0,0,2,0"
                                        Style="{StaticResource ViewerInfoValueStyle}"
                                        Text="{Binding FrameRate, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ImageInfoValue}, ConverterParameter=0.#}" />
                                    <TextBlock Style="{StaticResource ViewerInfoUnitStyle}" Text="fps" />
                                    <Border
                                        Width="1"
                                        Height="12"
                                        Margin="2,0,10,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Theme.Brush.Border.Default}" />
                                    <TextBlock Style="{StaticResource ViewerInfoLabelStyle}" Text="格式" />
                                    <TextBlock Style="{StaticResource ViewerInfoValueStyle}" Text="{Binding ImageFormat, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ImageInfoValue}}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowToolBar" Value="False">
                            <Setter TargetName="PART_ToolBar" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowInfoBar" Value="False">
                            <Setter TargetName="PART_InfoBar" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
