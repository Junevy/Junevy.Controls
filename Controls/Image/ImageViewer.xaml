<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Image">


    <Style TargetType="{x:Type local:ImageViewer}">
        <Setter Property="Background" Value="Black" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ImageViewer}">
                    <Border Background="{TemplateBinding Background}" ClipToBounds="True">
                        <Grid>
                            <!--  背景图  -->
                            <Image
                                Opacity="0.5"
                                Source="{StaticResource whiteCheckBoard}"
                                Stretch="UniformToFill" />
                            <Image
                                x:Name="PART_Image"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                SnapsToDevicePixels="True"
                                Source="{TemplateBinding Source}"
                                Stretch="Uniform" />
                        </Grid>

                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>