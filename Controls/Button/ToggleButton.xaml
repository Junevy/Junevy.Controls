<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cvt="clr-namespace:Junevy.Controls.Converters"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Button">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls;component/Resources/Font/IconFont.xaml" />
        <ResourceDictionary Source="/Junevy.Controls;component/Generic/Style/FeedbackOpacity.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <cvt:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <QuadraticEase x:Key="EaseOut" EasingMode="EaseOut" />

    <ControlTemplate x:Key="ExpanderControlTemplate" TargetType="{x:Type local:ToggleButton}">
        <Border x:Name="Host">
            <ContentControl
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Content="{TemplateBinding Content}"
                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                FontFamily="{TemplateBinding FontFamily}"
                FontSize="{TemplateBinding FontSize}"
                Foreground="{TemplateBinding Foreground}" />
        </Border>

        <ControlTemplate.Triggers>
            <!--  Hover：整体降透明度，不覆盖底色（鲜艳背景悬停不再变色）  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="{StaticResource Control.Hover.Opacity}" />
            </Trigger>

            <!--  Pressed（按住鼠标）：整体降透明度  -->
            <Trigger Property="IsMouseCaptured" Value="True">
                <Setter Property="Opacity" Value="{StaticResource Control.Pressed.Opacity}" />
            </Trigger>

            <!--  Disabled（最后声明，保证覆盖所有状态）  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <ControlTemplate x:Key="SwitchToggleButton_Rect" TargetType="{x:Type local:ToggleButton}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  轨道：宽 = 2 × SwitchSize，高 = SwitchSize，尺寸与圆角均由控件按 SwitchSize 推导  -->
            <Border
                x:Name="ToggleHost"
                Grid.Column="0"
                Width="{TemplateBinding TrackWidth}"
                Height="{TemplateBinding SwitchSize}"
                Padding="1"
                Background="Transparent"
                BorderBrush="{DynamicResource Theme.Brush.Border.Strong}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Theme.SmallCornerRadius}">
                <!--  滑块：边长 = SwitchSize - 4，与边框、内边距严丝合缝；Checked 时由控件代码驱动滑动动画  -->
                <Border
                    x:Name="PART_Thumb"
                    Width="{TemplateBinding ThumbSize}"
                    Height="{TemplateBinding ThumbSize}"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource Theme.Brush.Border.Strong}"
                    CornerRadius="2">
                    <!--  内圆角 2 = 外圆角(Theme.SmallCornerRadius 4) - 内缩量 2，保证内外圆角视觉吻合  -->
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="PART_ThumbTranslate" />
                    </Border.RenderTransform>
                </Border>
            </Border>

            <Grid Grid.Column="1">
                <ContentControl
                    Margin="10,0,0,0"
                    Background="{TemplateBinding Background}"
                    Content="{TemplateBinding Content}"
                    ContentStringFormat="{TemplateBinding ContentStringFormat}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                    FontFamily="{TemplateBinding FontFamily}"
                    FontSize="{TemplateBinding FontSize}"
                    Foreground="{TemplateBinding Foreground}"
                    Visibility="{TemplateBinding Content,
                                                 Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="PART_Thumb" Property="Background" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
            </Trigger>

            <!--  Hover  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ToggleHost" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent.PrimaryHover}" />
                <Setter TargetName="ToggleHost" Property="Background" Value="{DynamicResource Theme.Brush.Accent.PrimarySubtle}" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ToggleHost" Property="BorderBrush" Value="{DynamicResource Theme.Brush.State.DisabledBorder}" />
                <Setter TargetName="ToggleHost" Property="Background" Value="{DynamicResource Theme.Brush.State.DisabledSurface}" />
                <Setter TargetName="PART_Thumb" Property="Background" Value="{DynamicResource Theme.Brush.State.DisabledBorder}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Secondary}" />
                <Setter Property="Opacity" Value="0.8" />
            </Trigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True" />
                    <Condition Property="IsEnabled" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="ToggleHost" Property="Background" Value="{DynamicResource Theme.Brush.State.DisabledBorder}" />
                <Setter TargetName="ToggleHost" Property="BorderBrush" Value="{DynamicResource Theme.Brush.State.DisabledSurface}" />
                <Setter TargetName="PART_Thumb" Property="Background" Value="{DynamicResource Theme.Brush.Text.Secondary}" />
                <Setter Property="Opacity" Value="0.8" />
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <ControlTemplate x:Key="SwitchToggleButton_Radius" TargetType="{x:Type local:ToggleButton}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  轨道：宽 = 2 × SwitchSize，高 = SwitchSize，胶囊圆角 = SwitchSize / 2，由控件按 SwitchSize 推导  -->
            <Border
                x:Name="ToggleHost"
                Grid.Column="0"
                Width="{TemplateBinding TrackWidth}"
                Height="{TemplateBinding SwitchSize}"
                Padding="1"
                Background="Transparent"
                BorderBrush="{DynamicResource Theme.Brush.Border.Strong}"
                BorderThickness="1"
                CornerRadius="{TemplateBinding TrackCornerRadius}">

                <!--  滑块：直径 = SwitchSize - 4，与边框、内边距严丝合缝；Checked 时由控件代码驱动滑动动画  -->
                <Border
                    x:Name="PART_Thumb"
                    Width="{TemplateBinding ThumbSize}"
                    Height="{TemplateBinding ThumbSize}"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource Theme.Brush.Border.Strong}"
                    CornerRadius="{TemplateBinding ThumbCornerRadius}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="PART_ThumbTranslate" />
                    </Border.RenderTransform>
                </Border>
            </Border>

            <Grid Grid.Column="1">
                <ContentControl
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{TemplateBinding Background}"
                    Content="{TemplateBinding Content}"
                    ContentStringFormat="{TemplateBinding ContentStringFormat}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                    FontFamily="{TemplateBinding FontFamily}"
                    FontSize="{TemplateBinding FontSize}"
                    Foreground="{TemplateBinding Foreground}"
                    Visibility="{TemplateBinding Content,
                                                 Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="PART_Thumb" Property="Background" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
            </Trigger>

            <!--  Hover  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ToggleHost" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent.PrimaryHover}" />
                <Setter TargetName="ToggleHost" Property="Background" Value="{DynamicResource Theme.Brush.Accent.PrimarySubtle}" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ToggleHost" Property="BorderBrush" Value="{DynamicResource Theme.Brush.State.DisabledBorder}" />
                <Setter TargetName="ToggleHost" Property="Background" Value="{DynamicResource Theme.Brush.State.DisabledSurface}" />
                <Setter TargetName="PART_Thumb" Property="Background" Value="{DynamicResource Theme.Brush.State.DisabledBorder}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Secondary}" />
                <Setter Property="Opacity" Value="0.8" />
            </Trigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True" />
                    <Condition Property="IsEnabled" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="ToggleHost" Property="Background" Value="{DynamicResource Theme.Brush.State.DisabledBorder}" />
                <Setter TargetName="ToggleHost" Property="BorderBrush" Value="{DynamicResource Theme.Brush.State.DisabledSurface}" />
                <Setter TargetName="PART_Thumb" Property="Background" Value="{DynamicResource Theme.Brush.Text.Secondary}" />
                <Setter Property="Opacity" Value="0.8" />
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <ControlTemplate x:Key="ArrowToggleButtonTemplate" TargetType="{x:Type local:ToggleButton}">
        <Border
            x:Name="Border"
            Background="Transparent"
            BorderThickness="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>

                <!--  左侧透明区域（用于点击触发）  -->
                <Border Grid.Column="0" Background="Transparent" />

                <!--  箭头图标  -->
                <Path
                    x:Name="Arrow"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Data="M 0 0 L 5 5 L 10 0"
                    Fill="Transparent"
                    RenderTransformOrigin="0.5,0.5"
                    Stroke="{DynamicResource Theme.Brush.Text.Secondary}"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="1.5">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="ArrowRotate" Angle="0" />
                    </Path.RenderTransform>
                </Path>
            </Grid>
        </Border>

        <ControlTemplate.Triggers>
            <!--  展开时箭头旋转  -->
            <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                EasingFunction="{StaticResource EaseOut}"
                                Storyboard.TargetName="ArrowRotate"
                                Storyboard.TargetProperty="Angle"
                                To="180"
                                Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                EasingFunction="{StaticResource EaseOut}"
                                Storyboard.TargetName="ArrowRotate"
                                Storyboard.TargetProperty="Angle"
                                To="0"
                                Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <!--  Hover：箭头加深  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource Theme.Brush.Text.Primary}" />
            </Trigger>

            <!--  Disabled（最后声明，保证覆盖所有状态）  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <Style x:Key="DefaultToggleButton" TargetType="{x:Type local:ToggleButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
        <Setter Property="Margin" Value="5,5,0,5" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template" Value="{StaticResource SwitchToggleButton_Radius}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="SwitchSize" Value="20" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
    </Style>


    <Style
        x:Key="ExpanderButton"
        BasedOn="{StaticResource DefaultToggleButton}"
        TargetType="{x:Type local:ToggleButton}">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="Content" Value="&#xe650;" />
        <Setter Property="Template" Value="{StaticResource ExpanderControlTemplate}" />

        <Style.Triggers>
            <Trigger Property="DisplayMode" Value="Circular">
                <Setter Property="Template" Value="{StaticResource SwitchToggleButton_Radius}" />
            </Trigger>

            <Trigger Property="DisplayMode" Value="Rectangular">
                <Setter Property="Template" Value="{StaticResource SwitchToggleButton_Rect}" />
            </Trigger>
        </Style.Triggers>
    </Style>


    <Style BasedOn="{StaticResource DefaultToggleButton}" TargetType="{x:Type local:ToggleButton}" />
</ResourceDictionary>
