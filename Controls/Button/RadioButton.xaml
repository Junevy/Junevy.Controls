<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Button">


    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls;component/Generic/Style/DefaultFocusStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate x:Key="DefaultRadioButtonDataTemplate">
        <TextBlock Margin="10,0,0,0" Text="{Binding}" />
    </DataTemplate>

    <ControlTemplate x:Key="DefaultRadioButtonTemplate_Rect" TargetType="{x:Type local:RadioButton}">
        <Border
            x:Name="RootBorder"
            Padding="5,3"
            Background="Transparent"
            CornerRadius="{DynamicResource Theme.SmallCornerRadius}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  外框  -->
                <Border
                    x:Name="CheckBorder"
                    Grid.Column="0"
                    Width="18"
                    Height="18"
                    Background="Transparent"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource Theme.SmallCornerRadius}">

                    <!--  选中标记：矢量圆点，几何中心即元素中心，不像字形那样受 em 盒留白影响  -->
                    <Path
                        x:Name="CheckMark"
                        Width="8"
                        Height="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Fill="{DynamicResource Theme.Brush.Text.OnAccent}"
                        Opacity="0">
                        <Path.Data>
                            <EllipseGeometry
                                Center="4,4"
                                RadiusX="4"
                                RadiusY="4" />
                        </Path.Data>
                    </Path>
                </Border>

                <!--  ── 内容区域：自动使用 Style 中设置的 ContentTemplate ──  -->
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ControlTemplate.Triggers>
            <!--  Hover  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
                <Setter TargetName="CheckBorder" Property="Background" Value="Transparent" />
            </Trigger>

            <!--  Checked  -->
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent.PrimaryHover}" />
                <Setter TargetName="CheckMark" Property="Opacity" Value="1" />
            </Trigger>

            <!--  Checked + Hover  -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource Theme.Brush.Accent.PrimaryHover}" />
                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent.PrimaryHover}" />
            </MultiTrigger>

            <!--  Pressed（按下反馈：未勾选时边框加深 + 底色浮现）  -->
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent.PrimaryHover}" />
                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource Theme.Brush.Accent.PrimarySubtle}" />
            </Trigger>

            <!--  Checked + Pressed（按下反馈：勾选底色加深）  -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True" />
                    <Condition Property="IsPressed" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource Theme.Brush.Accent.PrimaryPressed}" />
                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent.PrimaryPressed}" />
            </MultiTrigger>

            <!--  Disabled（最后声明，保证覆盖所有状态）  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.State.DisabledBorder}" />
                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource Theme.Brush.State.DisabledSurface}" />
                <Setter TargetName="CheckMark" Property="Fill" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <ControlTemplate x:Key="DefaultRadioButtonTemplate_Circular" TargetType="{x:Type local:RadioButton}">
        <Border
            x:Name="RootBorder"
            Padding="5,3"
            Background="Transparent"
            CornerRadius="{DynamicResource Theme.SmallCornerRadius}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  外框  -->
                <Border
                    x:Name="CheckBorder"
                    Grid.Column="0"
                    Width="18"
                    Height="18"
                    Background="Transparent"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="45">

                    <!--  选中标记：矢量圆点，几何中心即元素中心，不像字形那样受 em 盒留白影响  -->
                    <Path
                        x:Name="CheckMark"
                        Width="8"
                        Height="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Fill="{DynamicResource Theme.Brush.Text.OnAccent}"
                        Opacity="0">
                        <Path.Data>
                            <EllipseGeometry
                                Center="4,4"
                                RadiusX="4"
                                RadiusY="4" />
                        </Path.Data>
                    </Path>
                </Border>

                <!--  ── 内容区域：自动使用 Style 中设置的 ContentTemplate ──  -->
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ControlTemplate.Triggers>
            <!--  Hover  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
                <Setter TargetName="CheckBorder" Property="Background" Value="Transparent" />
            </Trigger>

            <!--  Checked  -->
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent.PrimaryHover}" />
                <Setter TargetName="CheckMark" Property="Opacity" Value="1" />
            </Trigger>

            <!--  Checked + Hover  -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource Theme.Brush.Accent.PrimaryHover}" />
                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent.PrimaryHover}" />
            </MultiTrigger>

            <!--  Pressed（按下反馈：未勾选时边框加深 + 底色浮现）  -->
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent.PrimaryHover}" />
                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource Theme.Brush.Accent.PrimarySubtle}" />
            </Trigger>

            <!--  Checked + Pressed（按下反馈：勾选底色加深）  -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True" />
                    <Condition Property="IsPressed" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource Theme.Brush.Accent.PrimaryPressed}" />
                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent.PrimaryPressed}" />
            </MultiTrigger>

            <!--  Disabled（最后声明，保证覆盖所有状态）  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.State.DisabledBorder}" />
                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource Theme.Brush.State.DisabledSurface}" />
                <Setter TargetName="CheckMark" Property="Fill" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <Style x:Key="DefaultRadioButtonStyle" TargetType="{x:Type local:RadioButton}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Secondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextElement.FontSize" Value="14" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.Brush.Text.Secondary}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <!--  选中标记外框的默认色与粗细：两种 DisplayMode 的模板都改为 TemplateBinding 消费这两项。
              默认观感不变，宿主写 BorderBrush="Transparent" / BorderThickness="0" 可去掉标记描边。
              Border.CornerRadius 保留不动，理由与 CheckBox.xaml 同款注释一致：标记模板不读它，
              通用焦点环读它但离屏探针目测不到，删掉只可能把环的圆角从 4 变成 0。  -->
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Border.CornerRadius" Value="{DynamicResource Theme.SmallCornerRadius}" />
        <Setter Property="ContentTemplate" Value="{StaticResource DefaultRadioButtonDataTemplate}" />

        <Style.Triggers>
            <Trigger Property="DisplayMode" Value="Rectangular">
                <Setter Property="Template" Value="{StaticResource DefaultRadioButtonTemplate_Rect}" />
            </Trigger>

            <Trigger Property="DisplayMode" Value="Circular">
                <Setter Property="Template" Value="{StaticResource DefaultRadioButtonTemplate_Circular}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource DefaultRadioButtonStyle}" TargetType="{x:Type local:RadioButton}" />

</ResourceDictionary>
