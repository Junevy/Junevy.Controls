<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties"
    xmlns:cvt="clr-namespace:Junevy.Controls.Converters"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Button"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls;component/Generic/Style/DefaultFocusStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <cvt:NullToCollapsedConverter x:Key="NullToVisibility" />

    <!--
        状态反馈（状态层 / state layer）：悬停/按压不再替换固定底色，也不再降低整体透明度
        （整体变淡会让文字跟着模糊、鲜艳背景反馈微弱），而是在任意底色上叠一层固定透明度的
        纱（Theme.Brush.State.HoverScrim / PressedScrim，浅色墨纱、深色白纱）——
        红按钮悬停只是「同色相深一档」，用户自定义背景同样成立；文字图标全程保持实色。
        模板触发器靠后者生效——按压覆盖悬停，禁用覆盖按压（禁用仍走透明度 + 禁用表面）。
    -->
    <sys:Double x:Key="Button.Disabled.Opacity">0.5</sys:Double>

    <!--  官方 Button 模板  -->
    <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
        <Border
            x:Name="ContentBorder"
            MinWidth="{TemplateBinding MinWidth}"
            MinHeight="{TemplateBinding MinHeight}"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding Border.CornerRadius}"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--
                    图标区域：内容呈现使用 ContentPresenter 而非 ContentControl。
                    IconSize 是 int，而 Width / FontSize 是 double——TemplateBinding 不做类型转换，
                    写成 TemplateBinding 会静默失效（槽宽退化为 Auto），故这里与库内其他模板一致
                    用 RelativeSource=TemplatedParent 绑定（不是 AncestorType 查找，无额外开销）。
                -->
                <ContentPresenter
                    x:Name="IconPresenter"
                    Grid.Column="0"
                    Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(atc:Icon.IconSize)}"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    Content="{TemplateBinding atc:Icon.Icon}"
                    Focusable="False"
                    TextElement.FontFamily="{TemplateBinding atc:Icon.FontFamily}"
                    TextElement.FontSize="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(atc:Icon.IconSize)}"
                    TextElement.Foreground="{TemplateBinding Foreground}"
                    Visibility="{TemplateBinding atc:Icon.Icon, Converter={StaticResource NullToVisibility}}" />

                <ContentPresenter
                    x:Name="ContentPresenter"
                    Grid.Column="1"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    ContentSource="Content"
                    RecognizesAccessKey="True"
                    TextElement.FontFamily="{TemplateBinding FontFamily}"
                    TextElement.FontSize="{TemplateBinding FontSize}"
                    TextElement.Foreground="{TemplateBinding Foreground}" />

                <!--  状态层：悬停/按压的纱色叠在内容之上（IsHitTestVisible=False 不挡点击）  -->
                <Border
                    x:Name="StateLayer"
                    Grid.ColumnSpan="2"
                    Background="Transparent"
                    CornerRadius="{TemplateBinding Border.CornerRadius}"
                    IsHitTestVisible="False" />
            </Grid>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="StateLayer" Property="Background" Value="{DynamicResource Theme.Brush.State.HoverScrim}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="StateLayer" Property="Background" Value="{DynamicResource Theme.Brush.State.PressedScrim}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <!--  禁用态：用齐 State.DisabledSurface / DisabledBorder / DisabledForeground 三色，
                      不再用整体 Opacity 冲淡（冲淡会把自定义底色连同文字一起洗白）。
                      前景直接改到内容呈现器上：触发器若给 Button 本体的 Foreground 赋值，优先级低于宿主
                      本地设的 Foreground，压不住「彩色底 + 浅色字」这类配对，改呈现器才生效。  -->
                <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource Theme.Brush.State.DisabledSurface}" />
                <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.State.DisabledBorder}" />
                <Setter TargetName="ContentPresenter" Property="TextElement.Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
                <Setter TargetName="IconPresenter" Property="TextElement.Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--
        jv:Button 专属模板：背景层与内容层拆分（阴影只挂背景层、禁用变淡作用于根宿主），
        状态层纱色叠在内容之上；内容始终以固定字号排版（与官方 Button 一致）。
    -->
    <ControlTemplate x:Key="JvButtonTemplate" TargetType="{x:Type local:Button}">
        <!--
            根 Grid 承载「整体变淡」的状态反馈；背景层 Border 不含任何子元素，阴影只挂在它身上，
            避免位图特效让按钮文字退出 ClearType。MinWidth/MinHeight 移到根 Grid。
            内容层用一层无刷 Border 复现「Padding + BorderThickness」的内缩，
            使拆分后的测量结果与拆分前完全一致（Border 即使无边框画也保留边框占位）。
            阴影默认关闭（ShowShadow 默认 false，与 ComboBox 等同级控件贴平一致），需要浮起感的实例设 ShowShadow=True 打开。
        -->
        <Grid
            x:Name="RootHost"
            MinWidth="{TemplateBinding MinWidth}"
            MinHeight="{TemplateBinding MinHeight}"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
            <Border
                x:Name="ContentBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding Border.CornerRadius}"
                Effect="{DynamicResource Theme.ButtonShadow}"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True" />

            <Border
                x:Name="ContentHost"
                Padding="{TemplateBinding Padding}"
                BorderThickness="{TemplateBinding BorderThickness}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ContentPresenter
                        x:Name="IconPresenter"
                        Grid.Column="0"
                        Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(atc:Icon.IconSize)}"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding atc:Icon.Icon}"
                        Focusable="False"
                        TextElement.FontFamily="{TemplateBinding atc:Icon.FontFamily}"
                        TextElement.FontSize="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(atc:Icon.IconSize)}"
                        TextElement.Foreground="{TemplateBinding Foreground}"
                        Visibility="{TemplateBinding atc:Icon.Icon, Converter={StaticResource NullToVisibility}}" />

                    <ContentPresenter
                        x:Name="ContentPresenter"
                        Grid.Column="1"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        ContentSource="Content"
                        RecognizesAccessKey="True"
                        TextElement.FontFamily="{TemplateBinding FontFamily}"
                        TextElement.FontSize="{TemplateBinding FontSize}"
                        TextElement.Foreground="{TemplateBinding Foreground}" />
                </Grid>
            </Border>

            <!--  状态层：悬停/按压的纱色覆盖背景与边框（不挡点击、文字保持实色）  -->
            <Border
                x:Name="StateLayer"
                Background="Transparent"
                CornerRadius="{TemplateBinding Border.CornerRadius}"
                IsHitTestVisible="False" />
        </Grid>

        <ControlTemplate.Triggers>
            <!--  ShowShadow=False 时清掉常态阴影（DP 默认即 false）；需要浮起感的实例显式设 True，触发器不命中即保留阴影  -->
            <Trigger Property="ShowShadow" Value="False">
                <Setter TargetName="ContentBorder" Property="Effect" Value="{x:Null}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="StateLayer" Property="Background" Value="{DynamicResource Theme.Brush.State.HoverScrim}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="StateLayer" Property="Background" Value="{DynamicResource Theme.Brush.State.PressedScrim}" />
                <!--  按压即「贴回地面」：阴影随浮起感一起消失  -->
                <Setter TargetName="ContentBorder" Property="Effect" Value="{x:Null}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <!--  禁用态：同 ButtonTemplate——用齐 Disabled* 三色、去掉整体 Opacity；
                      前景改到两个呈现器上，才能压住宿主本地设的 Foreground。  -->
                <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource Theme.Brush.State.DisabledSurface}" />
                <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.State.DisabledBorder}" />
                <Setter TargetName="ContentPresenter" Property="TextElement.Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
                <Setter TargetName="IconPresenter" Property="TextElement.Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
                <Setter TargetName="ContentBorder" Property="Effect" Value="{x:Null}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  官方 Button 无边框模板  -->
    <ControlTemplate x:Key="NoBorderButtonTemplate" TargetType="Button">
        <Border
            x:Name="ContentBorder"
            MinWidth="{TemplateBinding MinWidth}"
            MinHeight="{TemplateBinding MinHeight}"
            Padding="{TemplateBinding Padding}"
            Background="Transparent"
            CornerRadius="{TemplateBinding Border.CornerRadius}"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
            <ContentPresenter
                x:Name="ContentPresenter"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                ContentSource="Content"
                RecognizesAccessKey="True"
                TextElement.FontFamily="{TemplateBinding FontFamily}"
                TextElement.FontSize="{TemplateBinding FontSize}"
                TextElement.Foreground="{TemplateBinding Foreground}" />
        </Border>

        <ControlTemplate.Triggers>
            <!--  透明背景（幽灵按钮）：悬停/按压以纱色填充出「色块」affordance，
                  文字全程实色（不再整体变淡）；背景为透明，纱色直接落在按钮矩形上  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource Theme.Brush.State.HoverScrim}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource Theme.Brush.State.PressedScrim}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ContentBorder" Property="Opacity" Value="{StaticResource Button.Disabled.Opacity}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="DefaultButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface.Base}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Secondary}" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="{DynamicResource Theme.ControlPadding}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Default}" />
        <Setter Property="Border.CornerRadius" Value="{DynamicResource Theme.ControlCornerRadius}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
    </Style>

    <!--  jv:Button 专属样式：使用背景/内容拆分模板（ShowShadow 与状态层）  -->
    <Style
        x:Key="JvButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="{x:Type local:Button}">
        <Setter Property="Template" Value="{StaticResource JvButtonTemplate}" />
    </Style>

    <Style
        x:Key="NoBorderButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Template" Value="{StaticResource NoBorderButtonTemplate}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    </Style>

    <!--  隐式样式（官方类型）：App 合并字典后 <Button> 自动生效  -->
    <Style BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button" />

    <!--  隐式样式（派生类型）：jv:Button 使用拆分模板  -->
    <Style BasedOn="{StaticResource JvButtonStyle}" TargetType="{x:Type local:Button}" />

</ResourceDictionary>
