<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties"
    xmlns:cvt="clr-namespace:Junevy.Controls.Converters"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Button"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls;component/Generic/Style/DefaultFocusStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <cvt:NullToCollapsedConverter x:Key="NullToVisibility" />
    <cvt:IncreaseFontsizeConverter x:Key="IncreaseFontSize" />

    <!--
        状态反馈透明度：悬停/按压不再替换固定底色（避免鲜艳背景色被主题色覆盖），
        统一降低整体不透明度；模板触发器靠后者生效——按压覆盖悬停，禁用覆盖按压。
    -->
    <sys:Double x:Key="Button.Hover.Opacity">0.8</sys:Double>
    <sys:Double x:Key="Button.Pressed.Opacity">0.65</sys:Double>
    <sys:Double x:Key="Button.Disabled.Opacity">0.5</sys:Double>

    <!--  官方 Button 模板：固定字号，无缩放宿主（官方类型没有 IsTextScaled 属性）  -->
    <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
        <Border
            x:Name="ContentBorder"
            MinWidth="{TemplateBinding MinWidth}"
            MinHeight="{TemplateBinding MinHeight}"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding Border.CornerRadius}"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--
                    图标区域：模板内一律使用 TemplateBinding 读取附加属性，
                    避免 AncestorType 查找（更慢且在 Popup/嵌套模板中脆弱）；
                    内容呈现使用 ContentPresenter 而非 ContentControl。
                -->
                <ContentPresenter
                    x:Name="IconPresenter"
                    Grid.Column="0"
                    Width="{TemplateBinding atc:Icon.IconSize}"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    Content="{TemplateBinding atc:Icon.Icon}"
                    Focusable="False"
                    TextElement.FontFamily="{TemplateBinding atc:Icon.FontFamily}"
                    TextElement.FontSize="{TemplateBinding atc:Icon.IconSize}"
                    TextElement.Foreground="{TemplateBinding Foreground}"
                    Visibility="{TemplateBinding atc:Icon.Icon, Converter={StaticResource NullToVisibility}}" />

                <ContentPresenter
                    x:Name="ContentPresenter"
                    Grid.Column="1"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    ContentSource="Content"
                    RecognizesAccessKey="True"
                    TextElement.FontFamily="{TemplateBinding FontFamily}"
                    TextElement.FontSize="{TemplateBinding FontSize}"
                    TextElement.Foreground="{TemplateBinding Foreground}" />
            </Grid>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ContentBorder" Property="Opacity" Value="{StaticResource Button.Hover.Opacity}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ContentBorder" Property="Opacity" Value="{StaticResource Button.Pressed.Opacity}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ContentBorder" Property="Opacity" Value="{StaticResource Button.Disabled.Opacity}" />
                <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Base}" />
                <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.State.DisabledBorder}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--
        jv:Button 专属模板：双内容宿主。
        NormalHost 固定字号；IsTextScaled=True 时切换到 ScaledHost（ShrinkBox 钳制 Viewbox）：
        缩放系数以 1 为上限——空间充足时保持原始字号（与官方 Button 一致），
        仅在按钮被挤压（显式尺寸或布局约束小于内容自然尺寸）时等比缩小（只缩小不放大）。
        注意：模板触发器中 DataTrigger + TemplatedParent 绑定不生效，这里必须用
        TargetType=local:Button 的 Property 触发器直接读依赖属性。
    -->
    <ControlTemplate x:Key="JvButtonTemplate" TargetType="{x:Type local:Button}">
        <!--
            根 Grid 承载「整体变淡」的状态反馈；背景层 Border 不含任何子元素，阴影只挂在它身上，
            避免位图特效让按钮文字退出 ClearType。MinWidth/MinHeight 移到根 Grid。
            内容层用一层无刷 Border 复现「Padding + BorderThickness」的内缩，
            使拆分后的测量结果与拆分前完全一致（Border 即使无边框画也保留边框占位）。
            阴影可由 ShowShadow=False（逐实例或样式 Setter）整体关掉。
        -->
        <Grid
            x:Name="RootHost"
            MinWidth="{TemplateBinding MinWidth}"
            MinHeight="{TemplateBinding MinHeight}"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
            <Border
                x:Name="ContentBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding Border.CornerRadius}"
                Effect="{DynamicResource Theme.ButtonShadow}"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True" />

            <Border
                x:Name="ContentHost"
                Padding="{TemplateBinding Padding}"
                BorderThickness="{TemplateBinding BorderThickness}">
                <Grid>
                    <Grid x:Name="NormalHost">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ContentPresenter
                            x:Name="IconPresenter"
                            Grid.Column="0"
                            Width="{TemplateBinding atc:Icon.IconSize}"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding atc:Icon.Icon}"
                            Focusable="False"
                            TextElement.FontFamily="{TemplateBinding atc:Icon.FontFamily}"
                            TextElement.FontSize="{TemplateBinding atc:Icon.IconSize}"
                            TextElement.Foreground="{TemplateBinding Foreground}"
                            Visibility="{TemplateBinding atc:Icon.Icon, Converter={StaticResource NullToVisibility}}" />

                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Grid.Column="1"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            ContentSource="Content"
                            RecognizesAccessKey="True"
                            TextElement.FontFamily="{TemplateBinding FontFamily}"
                            TextElement.FontSize="{TemplateBinding FontSize}"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>

                    <!--
                        缩放宿主：ShrinkBox 把 Viewbox 的可用尺寸钳制在内容自然尺寸内，
                        使 Viewbox 的等比缩放系数恒不超过 1（只缩小不放大，详见 ShrinkBox 注释）。
                    -->
                    <local:ShrinkBox>
                        <Viewbox
                            x:Name="ScaledHost"
                            Stretch="Uniform"
                            Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter
                                    x:Name="ScaledIconPresenter"
                                    Grid.Column="0"
                                    Width="{TemplateBinding atc:Icon.IconSize}"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding atc:Icon.Icon}"
                                    Focusable="False"
                                    TextElement.FontFamily="{TemplateBinding atc:Icon.FontFamily}"
                                    TextElement.FontSize="{TemplateBinding atc:Icon.IconSize}"
                                    TextElement.Foreground="{TemplateBinding Foreground}"
                                    Visibility="{TemplateBinding atc:Icon.Icon, Converter={StaticResource NullToVisibility}}" />

                                <ContentPresenter
                                    x:Name="ScaledContentPresenter"
                                    Grid.Column="1"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    ContentSource="Content"
                                    RecognizesAccessKey="True"
                                    TextElement.FontFamily="{TemplateBinding FontFamily}"
                                    TextElement.FontSize="{TemplateBinding FontSize}"
                                    TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Viewbox>
                    </local:ShrinkBox>
                </Grid>
            </Border>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsTextScaled" Value="True">
                <Setter TargetName="NormalHost" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="ScaledHost" Property="Visibility" Value="Visible" />
            </Trigger>
            <!--  逐实例/样式级关掉浮起阴影：与 ComboBox 等同排控件搭配时不再突兀  -->
            <Trigger Property="ShowShadow" Value="False">
                <Setter TargetName="ContentBorder" Property="Effect" Value="{x:Null}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RootHost" Property="Opacity" Value="{StaticResource Button.Hover.Opacity}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="RootHost" Property="Opacity" Value="{StaticResource Button.Pressed.Opacity}" />
                <!--  按压即「贴回地面」：阴影随浮起感一起消失  -->
                <Setter TargetName="ContentBorder" Property="Effect" Value="{x:Null}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RootHost" Property="Opacity" Value="{StaticResource Button.Disabled.Opacity}" />
                <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Base}" />
                <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.State.DisabledBorder}" />
                <Setter TargetName="ContentBorder" Property="Effect" Value="{x:Null}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  官方 Button 无边框模板：固定字号  -->
    <ControlTemplate x:Key="NoBorderButtonTemplate" TargetType="Button">
        <Border
            x:Name="ContentBorder"
            MinWidth="{TemplateBinding MinWidth}"
            MinHeight="{TemplateBinding MinHeight}"
            Padding="{TemplateBinding Padding}"
            Background="Transparent"
            CornerRadius="{TemplateBinding Border.CornerRadius}"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
            <ContentPresenter
                x:Name="ContentPresenter"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                ContentSource="Content"
                RecognizesAccessKey="True"
                TextElement.FontFamily="{TemplateBinding FontFamily}"
                TextElement.FontSize="{TemplateBinding FontSize}"
                TextElement.Foreground="{TemplateBinding Foreground}" />
        </Border>

        <ControlTemplate.Triggers>
            <!--  透明背景：悬停/按压的反馈为内容整体变淡  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ContentBorder" Property="Opacity" Value="{StaticResource Button.Hover.Opacity}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ContentBorder" Property="Opacity" Value="{StaticResource Button.Pressed.Opacity}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ContentBorder" Property="Opacity" Value="{StaticResource Button.Disabled.Opacity}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="DefaultButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface.Base}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="{DynamicResource Theme.ControlPadding}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Default}" />
        <Setter Property="Border.CornerRadius" Value="{DynamicResource Theme.ControlCornerRadius}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
    </Style>

    <!--  jv:Button 专属样式：切换到等比缩放模板  -->
    <Style
        x:Key="JvButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="{x:Type local:Button}">
        <Setter Property="Template" Value="{StaticResource JvButtonTemplate}" />
    </Style>

    <Style
        x:Key="NoBorderButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Template" Value="{StaticResource NoBorderButtonTemplate}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    </Style>

    <!--  隐式样式（官方类型）：App 合并字典后 <Button> 自动生效  -->
    <Style BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button" />

    <!--  隐式样式（派生类型）：jv:Button 使用等比缩放模板  -->
    <Style BasedOn="{StaticResource JvButtonStyle}" TargetType="{x:Type local:Button}" />

</ResourceDictionary>
