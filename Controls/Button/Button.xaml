<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties"
    xmlns:cvt="clr-namespace:Junevy.Controls.Converters"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Button">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls;component/Generic/Style/DefaultFocusStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <cvt:NullToCollapsedConverter x:Key="NullToVisibility" />
    <cvt:IncreaseFontsizeConverter x:Key="IncreaseFontSize" />

    <!--  官方 Button 模板：固定字号，无缩放宿主（官方类型没有 IsTextScaled 属性）  -->
    <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
        <Border
            x:Name="ContentBorder"
            MinWidth="{TemplateBinding MinWidth}"
            MinHeight="{TemplateBinding MinHeight}"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding Border.CornerRadius}"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--
                    图标区域：模板内一律使用 TemplateBinding 读取附加属性，
                    避免 AncestorType 查找（更慢且在 Popup/嵌套模板中脆弱）；
                    内容呈现使用 ContentPresenter 而非 ContentControl。
                -->
                <ContentPresenter
                    x:Name="IconPresenter"
                    Grid.Column="0"
                    Width="{TemplateBinding atc:Icon.IconSize}"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    Content="{TemplateBinding atc:Icon.Icon}"
                    Focusable="False"
                    TextElement.FontFamily="{TemplateBinding atc:Icon.FontFamily}"
                    TextElement.FontSize="{TemplateBinding atc:Icon.IconSize}"
                    TextElement.Foreground="{TemplateBinding Foreground}"
                    Visibility="{TemplateBinding atc:Icon.Icon, Converter={StaticResource NullToVisibility}}" />

                <ContentPresenter
                    x:Name="ContentPresenter"
                    Grid.Column="1"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    ContentSource="Content"
                    RecognizesAccessKey="True"
                    TextElement.FontFamily="{TemplateBinding FontFamily}"
                    TextElement.FontSize="{TemplateBinding FontSize}"
                    TextElement.Foreground="{TemplateBinding Foreground}" />
            </Grid>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ContentBorder" Property="Opacity" Value="0.5" />
                <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Base}" />
                <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.State.DisabledBorder}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--
        jv:Button 专属模板：双内容宿主。
        NormalHost 固定字号；IsTextScaled=True 时切换到 ScaledHost（Viewbox 等比缩放），
        文字/图标作为整体随按钮尺寸缩放且始终居中；按钮自适应内容大小时缩放系数为 1。
        注意：模板触发器中 DataTrigger + TemplatedParent 绑定不生效，这里必须用
        TargetType=local:Button 的 Property 触发器直接读依赖属性。
    -->
    <ControlTemplate x:Key="JvButtonTemplate" TargetType="{x:Type local:Button}">
        <Border
            x:Name="ContentBorder"
            MinWidth="{TemplateBinding MinWidth}"
            MinHeight="{TemplateBinding MinHeight}"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding Border.CornerRadius}"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">

            <Grid>
                <Grid x:Name="NormalHost">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ContentPresenter
                        x:Name="IconPresenter"
                        Grid.Column="0"
                        Width="{TemplateBinding atc:Icon.IconSize}"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding atc:Icon.Icon}"
                        Focusable="False"
                        TextElement.FontFamily="{TemplateBinding atc:Icon.FontFamily}"
                        TextElement.FontSize="{TemplateBinding atc:Icon.IconSize}"
                        TextElement.Foreground="{TemplateBinding Foreground}"
                        Visibility="{TemplateBinding atc:Icon.Icon, Converter={StaticResource NullToVisibility}}" />

                    <ContentPresenter
                        x:Name="ContentPresenter"
                        Grid.Column="1"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        ContentSource="Content"
                        RecognizesAccessKey="True"
                        TextElement.FontFamily="{TemplateBinding FontFamily}"
                        TextElement.FontSize="{TemplateBinding FontSize}"
                        TextElement.Foreground="{TemplateBinding Foreground}" />
                </Grid>

                <Viewbox
                    x:Name="ScaledHost"
                    Stretch="Uniform"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ContentPresenter
                            x:Name="ScaledIconPresenter"
                            Grid.Column="0"
                            Width="{TemplateBinding atc:Icon.IconSize}"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding atc:Icon.Icon}"
                            Focusable="False"
                            TextElement.FontFamily="{TemplateBinding atc:Icon.FontFamily}"
                            TextElement.FontSize="{TemplateBinding atc:Icon.IconSize}"
                            TextElement.Foreground="{TemplateBinding Foreground}"
                            Visibility="{TemplateBinding atc:Icon.Icon, Converter={StaticResource NullToVisibility}}" />

                        <ContentPresenter
                            x:Name="ScaledContentPresenter"
                            Grid.Column="1"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            ContentSource="Content"
                            RecognizesAccessKey="True"
                            TextElement.FontFamily="{TemplateBinding FontFamily}"
                            TextElement.FontSize="{TemplateBinding FontSize}"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </Viewbox>
            </Grid>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsTextScaled" Value="True">
                <Setter TargetName="NormalHost" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="ScaledHost" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ContentBorder" Property="Opacity" Value="0.5" />
                <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Base}" />
                <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.State.DisabledBorder}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  官方 Button 无边框模板：固定字号  -->
    <ControlTemplate x:Key="NoBorderButtonTemplate" TargetType="Button">
        <Border
            x:Name="ContentBorder"
            MinWidth="{TemplateBinding MinWidth}"
            MinHeight="{TemplateBinding MinHeight}"
            Padding="{TemplateBinding Padding}"
            Background="Transparent"
            CornerRadius="{TemplateBinding Border.CornerRadius}"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
            <ContentPresenter
                x:Name="ContentPresenter"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                ContentSource="Content"
                RecognizesAccessKey="True"
                TextElement.FontFamily="{TemplateBinding FontFamily}"
                TextElement.FontSize="{TemplateBinding FontSize}"
                TextElement.Foreground="{TemplateBinding Foreground}" />
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource Theme.Brush.Status.Warning}" />
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource Theme.Brush.Status.Danger}" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ContentBorder" Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="DefaultButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface.Base}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="{DynamicResource Theme.ControlPadding}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Default}" />
        <Setter Property="Border.CornerRadius" Value="{DynamicResource Theme.ControlCornerRadius}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
    </Style>

    <!--  jv:Button 专属样式：切换到等比缩放模板  -->
    <Style
        x:Key="JvButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="{x:Type local:Button}">
        <Setter Property="Template" Value="{StaticResource JvButtonTemplate}" />
    </Style>

    <Style
        x:Key="NoBorderButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Template" Value="{StaticResource NoBorderButtonTemplate}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    </Style>

    <!--  隐式样式（官方类型）：App 合并字典后 <Button> 自动生效  -->
    <Style BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button" />

    <!--  隐式样式（派生类型）：jv:Button 使用等比缩放模板  -->
    <Style BasedOn="{StaticResource JvButtonStyle}" TargetType="{x:Type local:Button}" />

</ResourceDictionary>
