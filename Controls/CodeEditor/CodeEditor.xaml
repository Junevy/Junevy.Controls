<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:cc="clr-namespace:ICSharpCode.AvalonEdit.CodeCompletion;assembly=ICSharpCode.AvalonEdit"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.CodeEditor">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls;component/Controls/Box/ListBox.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        代码编辑器（CodeEditor）：内部封装 AvalonEdit TextEditor（模板部件 PART_Editor）。
        语法着色不走 XAML——AvalonEdit 的高亮颜色是运行时对象（HighlightingColor），
        由 ThemedHighlightingProvider 在代码中映射到 Theme.Brush.* 主题画刷；
        本文件只负责表面/边框/行号/禁用态等外观，取值口径与 TextBox 一致。
    -->

    <ControlTemplate x:Key="DefaultCodeEditorTemplate" TargetType="{x:Type local:CodeEditor}">
        <Border
            x:Name="Border"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding Border.CornerRadius}"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
            <avalonedit:TextEditor
                x:Name="PART_Editor"
                Background="Transparent"
                Foreground="{TemplateBinding Foreground}"
                Padding="{TemplateBinding Padding}"
                LineNumbersForeground="{DynamicResource Theme.Brush.Text.Tertiary}"
                ShowLineNumbers="{TemplateBinding ShowLineNumbers}"
                IsReadOnly="{TemplateBinding IsReadOnly}"
                WordWrap="{TemplateBinding WordWrap}"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto" />
        </Border>
        <ControlTemplate.Triggers>
            <!--  焦点落在内部编辑区（TextArea 接管键盘焦点，外层 Control 默认不可聚焦）时提亮边框，
                  与 TextBox 的 IsFocused 提亮口径一致  -->
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Focused}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Strong}" />
            </Trigger>
            <!--  只读态：底色下沉（区别于可编辑态）；光标仍为文本光标，仅禁编辑  -->
            <Trigger Property="IsReadOnly" Value="True">
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Sunken}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource Theme.Brush.State.DisabledSurface}" />
                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Theme.Brush.State.DisabledBorder}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--
        补全弹窗（CompletionWindow 内嵌 CompletionList）主题化：
        AvalonEdit 的默认模板把 SystemColors 高亮色硬编码在键控样式 CompletionListBoxItem 里
        （模板内 StaticResource，隐式样式盖不过），故整体重写 CompletionList 模板 + 条目样式，
        映射到 Theme.Brush.*；条目样式独立成键（CodeEditorCompletionItemStyle），弹层紧凑化
        （MinHeight 24 / 小圆角 / 悬停一档 / 选中 Cobalt 强调）。
    -->
    <Style x:Key="CodeEditorCompletionItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border
                        x:Name="ItemBorder"
                        Margin="2,0"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource Theme.SmallCornerRadius}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Selected}" />
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type cc:CompletionList}">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface.Overlay}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type cc:CompletionList}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource Theme.Brush.Border.Divider}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Theme.SmallCornerRadius}"
                        SnapsToDevicePixels="True">
                        <cc:CompletionListBox
                            x:Name="PART_ListBox"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource CodeEditorCompletionItemStyle}"
                            TextBlock.Foreground="{TemplateBinding Foreground}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Image}" Width="16" Height="16" Margin="0,0,4,0" />
                                        <ContentPresenter Content="{Binding Content}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </cc:CompletionListBox>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultCodeEditorStyle" TargetType="{x:Type local:CodeEditor}">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface.Base}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="{DynamicResource Theme.ControlCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource Theme.ControlPadding}" />
        <!--  代码字体：等宽字体族串，缺字体时按列表逐个回退  -->
        <Setter Property="FontFamily" Value="Consolas, Courier New" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template" Value="{StaticResource DefaultCodeEditorTemplate}" />
    </Style>

    <!--  隐式样式：CodeEditor 无原生对应类型，仅派生类型一份  -->
    <Style BasedOn="{StaticResource DefaultCodeEditorStyle}" TargetType="{x:Type local:CodeEditor}" />

</ResourceDictionary>
