<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties"
    xmlns:bt="clr-namespace:Junevy.Controls.Controls.Button"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Bar"
    xmlns:menu="clr-namespace:Junevy.Controls.Controls.Menu"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls.Resources;component/Font/IconFont.xaml" />
        <ResourceDictionary Source="/Junevy.Controls;component/Themes/AppColors.xaml" />
        <ResourceDictionary Source="/Junevy.Controls;component/Controls/Button/Button.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <ControlTemplate x:Key="DefaultAppBar" TargetType="{x:Type local:AppBar}">
        <Grid
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{TemplateBinding Background}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition MaxWidth="120" />
            </Grid.ColumnDefinitions>

            <!--  icon  -->
            <ContentControl
                Grid.Column="0"
                Width="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.IconSize)}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.IconSize)}"
                Margin="8"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Content="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.Icon)}"
                FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.FontFamily)}"
                FontSize="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.IconSize)}"
                Foreground="{StaticResource TextFillColor}" />

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition MaxHeight="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  title  -->
                <Grid Grid.Row="0">
                    <TextBlock
                        Margin="0,3,0,3"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="{TemplateBinding FontSize}"
                        Foreground="{StaticResource TextFillColor}"
                        Text="{TemplateBinding Content}" />
                </Grid>

                <!--  seperator  -->
                <Border
                    Grid.Row="1"
                    BorderBrush="{StaticResource BorderBrushColor}"
                    BorderThickness="1" />

                <!--  tools bar  -->
                <Grid Grid.Row="2">
                    <menu:ToolBar
                        Width="auto"
                        Margin="0,3,0,3"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.FontFamily)}"
                        ItemsSource="{TemplateBinding Items}"
                        Orientation="Horizontal" />
                </Grid>
            </Grid>

            <Grid Grid.Column="2" WindowChrome.IsHitTestVisibleInChrome="True">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <bt:Button
                    Grid.Column="0"
                    Background="Red"
                    Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Content="&#xe60e;"
                    FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.FontFamily)}"
                    FontSize="20"
                    Style="{StaticResource NoBorderButtonStyle}"
                    WindowChrome.IsHitTestVisibleInChrome="True" />
                <bt:Button
                    Grid.Column="1"
                    Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Content="&#xe691;"
                    FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.FontFamily)}"
                    FontSize="20"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <bt:Button.Style>
                        <Style BasedOn="{StaticResource NoBorderButtonStyle}" TargetType="bt:Button">
                            <Setter Property="Content" Value="&#xe691;" />
                            <!--  默认最大化图标  -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                    <Setter Property="Content" Value="&#xe772;" />
                                    <!--  换成你的还原图标（请替换成正确的 Unicode）  -->
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </bt:Button.Style>
                </bt:Button>
                <bt:Button
                    Grid.Column="2"
                    Command="{x:Static SystemCommands.CloseWindowCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Content="&#xe639;"
                    FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.FontFamily)}"
                    FontSize="20"
                    Style="{StaticResource NoBorderButtonStyle}" />
            </Grid>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="SimpleAppBar" TargetType="{x:Type local:AppBar}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <ContentControl
                Grid.Column="0"
                Width="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.IconSize)}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.IconSize)}"
                Margin="15,8,15,8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Content="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.Icon)}"
                FontSize="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.IconSize)}"
                Foreground="{TemplateBinding Foreground}" />

        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type local:AppBar}">
        <Setter Property="Height" Value="60" />
        <Setter Property="Background" Value="{StaticResource SubBackground}" />
        <Setter Property="Template" Value="{StaticResource DefaultAppBar}" />
        <Setter Property="atc:Icon.FontFamily" Value="{StaticResource IconFont}" />

        <!--<Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.7" />
            </Trigger>
        -->
        <!--<Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="Red" />
            </Trigger>-->
        <!--<DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False">
                <Setter Property="Foreground" Value="Red" />
            </DataTrigger>-->
        <!--
        </Style.Triggers>-->
    </Style>
</ResourceDictionary>