<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties"
    xmlns:bt="clr-namespace:Junevy.Controls.Controls.Button"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Bar"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls;component/Resources/Font/IconFont.xaml" />
        <ResourceDictionary Source="/Junevy.Controls;component/Controls/Button/Button.xaml" />
        <ResourceDictionary Source="/Junevy.Controls;component/Controls/Menu/MenuBar.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        标题栏图标字形字号。图标字体已统一为满幅 em(墨迹边长=字号)，
        18 会让窗口操作按钮的字形贴满 40x32 按钮边缘，故取 15。
    -->
    <sys:Double x:Key="AppBarCaptionIconSize">15</sys:Double>

    <Style
        x:Key="CaptionButtonStyle"
        BasedOn="{StaticResource NoBorderButtonStyle}"
        TargetType="{x:Type bt:Button}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Secondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style
        x:Key="CloseCaptionButtonStyle"
        BasedOn="{StaticResource CaptionButtonStyle}"
        TargetType="{x:Type bt:Button}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Secondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type bt:Button}">
                    <Border
                        x:Name="ContentBorder"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Background="{TemplateBinding Background}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ContentSource="Content"
                            RecognizesAccessKey="True"
                            TextElement.FontFamily="{TemplateBinding FontFamily}"
                            TextElement.FontSize="{TemplateBinding FontSize}"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource Theme.Brush.Status.Danger}" />
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.OnAccent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource Theme.Brush.Status.DangerHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.OnAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <ControlTemplate x:Key="DefaultAppBar" TargetType="{x:Type local:AppBar}">
        <Grid
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{TemplateBinding Background}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition MaxWidth="120" />
            </Grid.ColumnDefinitions>

            <!--  icon：高度固定 IconSize、最小宽度 IconSize；内容宽于 IconSize（宽幅 Logo 图）时图标区自动加宽  -->
            <ContentControl
                Grid.Column="0"
                MinWidth="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.IconSize)}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.IconSize)}"
                Margin="8"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Content="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.Icon)}"
                FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.FontFamily)}"
                FontSize="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.IconSize)}"
                Foreground="{TemplateBinding Foreground}" />

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition MaxHeight="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  title  -->
                <Grid Grid.Row="0">
                    <ContentPresenter
                        Margin="0,5,0,5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        ContentSource="Content"
                        RecognizesAccessKey="True"
                        TextElement.FontSize="{TemplateBinding FontSize}"
                        TextElement.Foreground="{TemplateBinding Foreground}" />
                </Grid>

                <!--  seperator  -->
                <Border
                    Grid.Row="1"
                    BorderBrush="{DynamicResource Theme.Brush.Border.Subtle}"
                    BorderThickness="1" />

                <!--  tools bar  -->
                <Grid Grid.Row="2">
                    <ContentPresenter
                        Margin="3"
                        VerticalAlignment="Top"
                        Content="{TemplateBinding ToolBar}" />
                </Grid>
            </Grid>

            <Grid Grid.Column="2" WindowChrome.IsHitTestVisibleInChrome="True">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <bt:Button
                    Grid.Column="0"
                    Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Content="&#xe60e;"
                    FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.FontFamily)}"
                    FontSize="{StaticResource AppBarCaptionIconSize}"
                    Style="{StaticResource CaptionButtonStyle}"
                    ToolTip="Minimize"
                    WindowChrome.IsHitTestVisibleInChrome="True" />
                <!--
                    Content/Command/ToolTip come only from the style so the
                    Maximized trigger can retarget them; a local value here
                    would outrank the trigger and pin the button to Maximize.
                -->
                <bt:Button
                    Grid.Column="1"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.FontFamily)}"
                    FontSize="{StaticResource AppBarCaptionIconSize}"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <bt:Button.Style>
                        <Style BasedOn="{StaticResource CaptionButtonStyle}" TargetType="{x:Type bt:Button}">
                            <Setter Property="Content" Value="&#xe691;" />
                            <Setter Property="Command" Value="{x:Static SystemCommands.MaximizeWindowCommand}" />
                            <Setter Property="ToolTip" Value="Maximize" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                    <Setter Property="Content" Value="&#xe772;" />
                                    <Setter Property="Command" Value="{x:Static SystemCommands.RestoreWindowCommand}" />
                                    <Setter Property="ToolTip" Value="Restore" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </bt:Button.Style>
                </bt:Button>
                <bt:Button
                    Grid.Column="2"
                    Command="{x:Static SystemCommands.CloseWindowCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Content="&#xe639;"
                    FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.FontFamily)}"
                    FontSize="{StaticResource AppBarCaptionIconSize}"
                    Style="{StaticResource CloseCaptionButtonStyle}"
                    ToolTip="Close" />
            </Grid>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="SimpleAppBar" TargetType="{x:Type local:AppBar}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <ContentControl
                Grid.Column="0"
                MinWidth="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.IconSize)}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.IconSize)}"
                Margin="15,8,15,8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Content="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.Icon)}"
                FontSize="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.IconSize)}"
                Foreground="{TemplateBinding Foreground}" />
        </Grid>
    </ControlTemplate>

    <!--
        Single-row title bar: icon, application name, menu bar, then the system
        buttons.  Dragging is left to the host WindowChrome caption area, so the
        only regions opted out of hit-test-visible chrome are the menu and the
        caption buttons.
    -->
    <ControlTemplate x:Key="MenuBarAppBar" TargetType="{x:Type local:AppBar}">
        <Grid
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{TemplateBinding Background}">

            <Grid.Resources>
                <!--
                    Scoped to this template: the library never injects a global
                    implicit Menu style.
                -->
                <Style BasedOn="{StaticResource JunevyMenuBarStyle}" TargetType="{x:Type Menu}" />
            </Grid.Resources>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <!--  icon  -->
            <ContentControl
                Grid.Column="0"
                MinWidth="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.IconSize)}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.IconSize)}"
                Margin="8,0,4,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Content="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.Icon)}"
                FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.FontFamily)}"
                FontSize="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.IconSize)}"
                Foreground="{TemplateBinding Foreground}" />

            <!--  application name  -->
            <ContentPresenter
                Grid.Column="1"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                ContentSource="Content"
                RecognizesAccessKey="True"
                TextElement.FontSize="{TemplateBinding FontSize}"
                TextElement.Foreground="{TemplateBinding Foreground}" />

            <!--  menu bar  -->
            <ContentPresenter
                Grid.Column="2"
                VerticalAlignment="Center"
                Content="{TemplateBinding Menu}"
                WindowChrome.IsHitTestVisibleInChrome="True" />

            <!--  drag spacer, owned by the WindowChrome caption  -->
            <Border Grid.Column="3" Background="Transparent" />

            <!--  caption buttons  -->
            <Grid
                Grid.Column="4"
                VerticalAlignment="Center"
                WindowChrome.IsHitTestVisibleInChrome="True">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <bt:Button
                    Grid.Column="0"
                    Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Content="&#xe60e;"
                    FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.FontFamily)}"
                    FontSize="{StaticResource AppBarCaptionIconSize}"
                    Style="{StaticResource CaptionButtonStyle}"
                    ToolTip="Minimize"
                    WindowChrome.IsHitTestVisibleInChrome="True" />
                <!--
                    Content/Command/ToolTip come only from the style so the
                    Maximized trigger can retarget them; a local value here
                    would outrank the trigger and pin the button to Maximize.
                -->
                <bt:Button
                    Grid.Column="1"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.FontFamily)}"
                    FontSize="{StaticResource AppBarCaptionIconSize}"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <bt:Button.Style>
                        <Style BasedOn="{StaticResource CaptionButtonStyle}" TargetType="{x:Type bt:Button}">
                            <Setter Property="Content" Value="&#xe691;" />
                            <Setter Property="Command" Value="{x:Static SystemCommands.MaximizeWindowCommand}" />
                            <Setter Property="ToolTip" Value="Maximize" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                    <Setter Property="Content" Value="&#xe772;" />
                                    <Setter Property="Command" Value="{x:Static SystemCommands.RestoreWindowCommand}" />
                                    <Setter Property="ToolTip" Value="Restore" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </bt:Button.Style>
                </bt:Button>
                <bt:Button
                    Grid.Column="2"
                    Command="{x:Static SystemCommands.CloseWindowCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Content="&#xe639;"
                    FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.FontFamily)}"
                    FontSize="{StaticResource AppBarCaptionIconSize}"
                    Style="{StaticResource CloseCaptionButtonStyle}"
                    ToolTip="Close" />
            </Grid>
        </Grid>
    </ControlTemplate>

    <!--
        可展开标题栏（Mode=Expandable）：抽屉开关（最左） + 居中标题 + 系统按钮（最右）。
        标题跨三列真居中（不是"剩余空间居中"——左右两侧宽度不等时依然居中）；
        拖动交由宿主 WindowChrome caption 区，标题层不做命中豁免，
        因此在标题上按下即可拖动；抽屉开关与系统按钮所在的区域
        WindowChrome.IsHitTestVisibleInChrome=True，点击不被 caption 吞掉。
        抽屉为 Popup：从标题栏下缘向下展开悬浮于宿主内容之上（AppBar 是布局元素，
        无法把展开区塞进宿主的行里，ExpanderPanel / SidePanel 均不适合在此复用），
        点外部收起由 StaysOpen=False 的鼠标捕获保证；开关上的「收起后放行 Click」
        由 AppBar 代码侧的时间窗守卫去抖，不会重复展开。
    -->
    <ControlTemplate x:Key="ExpandableAppBar" TargetType="{x:Type local:AppBar}">
        <Grid Background="{TemplateBinding Background}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <!--  标题：跨全部三列水平居中  -->
            <ContentPresenter
                Grid.ColumnSpan="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ContentSource="Content"
                RecognizesAccessKey="True"
                TextElement.FontSize="{TemplateBinding FontSize}"
                TextElement.Foreground="{TemplateBinding Foreground}" />

            <!--  抽屉开关（最左侧）：无 Drawer 内容时隐藏  -->
            <bt:Button
                x:Name="PART_DrawerToggle"
                Grid.Column="0"
                Width="40"
                Height="32"
                Margin="2,0,0,0"
                VerticalAlignment="Center"
                Content="{TemplateBinding DrawerToggleIcon}"
                FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.FontFamily)}"
                FontSize="{StaticResource AppBarCaptionIconSize}"
                Style="{StaticResource NoBorderButtonStyle}"
                ToolTip="Menu"
                Visibility="{TemplateBinding Drawer,
                                             Converter={StaticResource NullToVisibility}}"
                WindowChrome.IsHitTestVisibleInChrome="True" />

            <!--  系统按钮（最右侧）：与 DefaultAppBar 相同的 SystemCommands 三件套  -->
            <Grid Grid.Column="2" WindowChrome.IsHitTestVisibleInChrome="True">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <bt:Button
                    Grid.Column="0"
                    Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Content="&#xe60e;"
                    FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.FontFamily)}"
                    FontSize="{StaticResource AppBarCaptionIconSize}"
                    Style="{StaticResource CaptionButtonStyle}"
                    ToolTip="Minimize"
                    WindowChrome.IsHitTestVisibleInChrome="True" />
                <bt:Button
                    Grid.Column="1"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.FontFamily)}"
                    FontSize="{StaticResource AppBarCaptionIconSize}"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <bt:Button.Style>
                        <Style BasedOn="{StaticResource CaptionButtonStyle}" TargetType="{x:Type bt:Button}">
                            <Setter Property="Content" Value="&#xe691;" />
                            <Setter Property="Command" Value="{x:Static SystemCommands.MaximizeWindowCommand}" />
                            <Setter Property="ToolTip" Value="Maximize" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                    <Setter Property="Content" Value="&#xe772;" />
                                    <Setter Property="Command" Value="{x:Static SystemCommands.RestoreWindowCommand}" />
                                    <Setter Property="ToolTip" Value="Restore" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </bt:Button.Style>
                </bt:Button>
                <bt:Button
                    Grid.Column="2"
                    Command="{x:Static SystemCommands.CloseWindowCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Content="&#xe639;"
                    FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.FontFamily)}"
                    FontSize="{StaticResource AppBarCaptionIconSize}"
                    Style="{StaticResource CloseCaptionButtonStyle}"
                    ToolTip="Close"
                    WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>

            <!--
                抽屉：标题栏下方向下展开的浮层，尺寸由内容决定；
                IsOpen 双向绑定 IsDrawerOpen——StaysOpen=False 点外部自动关闭时同步写回
            -->
            <Popup
                x:Name="PART_Popup"
                AllowsTransparency="True"
                Focusable="False"
                IsOpen="{Binding IsDrawerOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                Placement="Bottom"
                PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                PopupAnimation="Slide"
                StaysOpen="False">
                <Border
                    x:Name="PART_DrawerHost"
                    MinWidth="180"
                    Margin="0,2,10,10"
                    Background="{DynamicResource Theme.Brush.Surface.Base}"
                    BorderBrush="{DynamicResource Theme.Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Theme.ControlCornerRadius}"
                    Effect="{DynamicResource Theme.PopupShadow}">
                    <ContentPresenter
                        Margin="6"
                        Content="{TemplateBinding Drawer}"
                        TextElement.Foreground="{DynamicResource Theme.Brush.Text.Secondary}" />
                </Border>
            </Popup>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type local:AppBar}">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface.Base}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Secondary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource DefaultAppBar}" />
        <Setter Property="atc:Icon.FontFamily" Value="{StaticResource IconFont}" />
        <Style.Triggers>
            <Trigger Property="Mode" Value="MenuBar">
                <Setter Property="Template" Value="{StaticResource MenuBarAppBar}" />
            </Trigger>
            <Trigger Property="Mode" Value="Expandable">
                <Setter Property="Template" Value="{StaticResource ExpandableAppBar}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
