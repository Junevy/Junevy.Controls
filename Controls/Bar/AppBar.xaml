<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties"
    xmlns:bt="clr-namespace:Junevy.Controls.Controls.Button"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Bar"
    xmlns:menu="clr-namespace:Junevy.Controls.Controls.Menu"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls;component/Resources/Font/IconFont.xaml" />
        <ResourceDictionary Source="/Junevy.Controls;component/Controls/Button/Button.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style
        x:Key="CaptionButtonStyle"
        BasedOn="{StaticResource NoBorderButtonStyle}"
        TargetType="{x:Type bt:Button}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style
        x:Key="CloseCaptionButtonStyle"
        BasedOn="{StaticResource CaptionButtonStyle}"
        TargetType="{x:Type bt:Button}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type bt:Button}">
                    <Border
                        x:Name="ContentBorder"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Background="{TemplateBinding Background}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            TextElement.FontFamily="{TemplateBinding FontFamily}"
                            TextElement.FontSize="{TemplateBinding FontSize}"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource Theme.Brush.Status.Danger}" />
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.OnAccent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource Theme.Brush.Status.DangerHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.OnAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <ControlTemplate x:Key="DefaultAppBar" TargetType="{x:Type local:AppBar}">
        <Grid
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{TemplateBinding Background}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition MaxWidth="120" />
            </Grid.ColumnDefinitions>

            <!--  icon  -->
            <ContentControl
                Grid.Column="0"
                Width="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.IconSize)}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.IconSize)}"
                Margin="8"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Content="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.Icon)}"
                FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.FontFamily)}"
                FontSize="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.IconSize)}"
                Foreground="{DynamicResource Theme.Brush.Text.Primary}" />

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition MaxHeight="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  title  -->
                <Grid Grid.Row="0">
                    <TextBlock
                        Margin="0,3,0,3"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="{TemplateBinding FontSize}"
                        Foreground="{DynamicResource Theme.Brush.Text.Primary}"
                        Text="{TemplateBinding Content}" />
                </Grid>

                <!--  seperator  -->
                <Border
                    Grid.Row="1"
                    BorderBrush="{DynamicResource Theme.Brush.Border.Default}"
                    BorderThickness="1" />

                <!--  tools bar  -->
                <Grid Grid.Row="2">
                    <ContentPresenter
                        Margin="3"
                        VerticalAlignment="Top"
                        Content="{TemplateBinding ToolBar}" />
                </Grid>
            </Grid>

            <Grid Grid.Column="2" WindowChrome.IsHitTestVisibleInChrome="True">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <bt:Button
                    Grid.Column="0"
                    Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Content="&#xe60e;"
                    FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.FontFamily)}"
                    FontSize="18"
                    Style="{StaticResource CaptionButtonStyle}"
                    ToolTip="Minimize"
                    WindowChrome.IsHitTestVisibleInChrome="True" />
                <bt:Button
                    Grid.Column="1"
                    Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Content="&#xe691;"
                    FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.FontFamily)}"
                    FontSize="18"
                    ToolTip="Maximize"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <bt:Button.Style>
                        <Style BasedOn="{StaticResource CaptionButtonStyle}" TargetType="{x:Type bt:Button}">
                            <Setter Property="Content" Value="&#xe691;" />
                            <Setter Property="Command" Value="{x:Static SystemCommands.MaximizeWindowCommand}" />
                            <Setter Property="ToolTip" Value="Maximize" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                    <Setter Property="Content" Value="&#xe772;" />
                                    <Setter Property="Command" Value="{x:Static SystemCommands.RestoreWindowCommand}" />
                                    <Setter Property="ToolTip" Value="Restore" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </bt:Button.Style>
                </bt:Button>
                <bt:Button
                    Grid.Column="2"
                    Command="{x:Static SystemCommands.CloseWindowCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Content="&#xe639;"
                    FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.FontFamily)}"
                    FontSize="18"
                    Style="{StaticResource CloseCaptionButtonStyle}"
                    ToolTip="Close" />
            </Grid>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="SimpleAppBar" TargetType="{x:Type local:AppBar}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <ContentControl
                Grid.Column="0"
                Width="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.IconSize)}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.IconSize)}"
                Margin="15,8,15,8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Content="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.Icon)}"
                FontSize="{Binding RelativeSource={RelativeSource AncestorType=local:AppBar}, Path=(atc:Icon.IconSize)}"
                Foreground="{TemplateBinding Foreground}" />

        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type local:AppBar}">
        <Setter Property="Height" Value="70" />
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface.Base}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource DefaultAppBar}" />
        <Setter Property="atc:Icon.FontFamily" Value="{StaticResource IconFont}" />
    </Style>
</ResourceDictionary>
