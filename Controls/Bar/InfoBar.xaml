<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties"
    xmlns:bt="clr-namespace:Junevy.Controls.Controls.Button"
    xmlns:cvt="clr-namespace:Junevy.Controls.Converters"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Bar"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls;component/Controls/Button/Button.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <cvt:BoolToVisibilityConverter x:Key="InfoBarBoolToVisibility" />
    <cvt:NullToCollapsedConverter x:Key="InfoBarNullToVisibility" />

    <!--
        用户信息条：头像（图片 / 名称首字符圆形字标）+ 名称 + 可选设置按钮；
        DisplayMode=AvatarOnly 时仅头像、名称经 ToolTip 悬停显示。
        点击整行弹出与控件等宽的菜单（Items 可在 XAML 中编写，或经 ItemsSource 绑定列表；
        项模板用 ItemTemplate 定制）。菜单经 Popup 向上展开悬浮（适合侧栏 / 标题栏底部），
        点外部或再次点击收起；AutoCloseOnMenuClick=True 时菜单内按钮项点击自动收起。
        悬停整行走状态层纱色（与新交互反馈方案一致）。
        根 Border 标记 IsHitTestVisibleInChrome=True：放在 WindowChrome caption 区
        （如 AppBar 下方）时整行可点，普通布局中该附加属性无副作用。
    -->
    <ControlTemplate x:Key="DefaultInfoBar" TargetType="{x:Type local:InfoBar}">
        <Grid>
            <Border
                x:Name="PART_Root"
                Padding="6,4"
                Background="Transparent"
                CornerRadius="{DynamicResource Theme.SmallCornerRadius}"
                Cursor="Hand"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                SnapsToDevicePixels="True">
                <Grid x:Name="HeaderGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <!--  头像：有图片显示圆形裁切的图片，否则显示名称首字符字标  -->
                    <Border
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        Background="{DynamicResource Theme.Brush.Text.Primary}"
                        CornerRadius="16">
                        <Grid>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Theme.Brush.Text.Inverse}"
                                Text="{TemplateBinding AvatarLetter}" />
                            <!--  头像尺寸固定 32x32，静态圆角矩形裁切即可  -->
                            <Image
                                Width="32"
                                Height="32"
                                Source="{TemplateBinding AvatarSource}"
                                Stretch="UniformToFill"
                                Visibility="{TemplateBinding AvatarSource, Converter={StaticResource InfoBarNullToVisibility}}">
                                <Image.Clip>
                                    <RectangleGeometry RadiusX="16" RadiusY="16" Rect="0,0,32,32" />
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>

                    <!--  名称（Text 布局）  -->
                    <TextBlock
                        x:Name="NameText"
                        Grid.Column="1"
                        Margin="8,0,4,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                        Text="{TemplateBinding UserName}"
                        TextTrimming="CharacterEllipsis" />

                    <!--  设置按钮（Text 布局，可关）：Click 由 InfoBar 冒泡 SettingsClick  -->
                    <bt:Button
                        x:Name="PART_SettingsButton"
                        Grid.Column="2"
                        Width="28"
                        Height="28"
                        Padding="0"
                        VerticalAlignment="Center"
                        Content="&#xE60F;"
                        FontFamily="{Binding RelativeSource={RelativeSource AncestorType=local:InfoBar}, Path=(atc:Icon.FontFamily)}"
                        FontSize="14"
                        Style="{StaticResource NoBorderButtonStyle}"
                        ToolTip="Settings"
                        Visibility="{TemplateBinding ShowSettingsButton, Converter={StaticResource InfoBarBoolToVisibility}}" />
                </Grid>
            </Border>

            <!--  菜单：与控件等宽（Width 绑定 ActualWidth），默认向上展开；
                  IsOpen 双向绑定 IsMenuOpen——StaysOpen=False 点外部自动关闭时同步写回；
                  Items 既是 XAML 编写的菜单项，也承载 ItemsSource 绑定的列表  -->
            <Popup
                x:Name="PART_MenuPopup"
                AllowsTransparency="True"
                Focusable="False"
                IsOpen="{Binding IsMenuOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                Placement="{TemplateBinding MenuPlacement}"
                PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                PopupAnimation="Fade"
                StaysOpen="False">
                <Border
                    x:Name="PART_MenuHost"
                    Margin="10,10,10,10"
                    Background="{DynamicResource Theme.Brush.Surface.Base}"
                    BorderBrush="{DynamicResource Theme.Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Theme.ControlCornerRadius}"
                    Effect="{DynamicResource Theme.PopupShadow}">
                    <Grid>
                        <!--  面板模式：MenuContent（ListBox / UserControl / 复杂布局等任意内容）  -->
                        <ContentPresenter x:Name="MenuContentPresenter" Content="{TemplateBinding MenuContent}">
                            <ContentPresenter.Style>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MenuContent, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentPresenter.Style>
                        </ContentPresenter>
                        <!--  菜单项模式：Items / ItemsSource（MenuContent 为空时呈现）  -->
                        <ItemsPresenter Margin="4">
                            <ItemsPresenter.Style>
                                <Style TargetType="ItemsPresenter">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MenuContent, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsPresenter.Style>
                        </ItemsPresenter>
                    </Grid>
                </Border>
            </Popup>
        </Grid>

        <ControlTemplate.Triggers>
                <!--  悬停：整行走状态层纱色  -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="PART_Root" Property="Background" Value="{DynamicResource Theme.Brush.State.HoverScrim}" />
                </Trigger>
                <!--  AvatarOnly：仅头像（指定宽度时居中显示），名称经 ToolTip 显示  -->
                <Trigger Property="DisplayMode" Value="AvatarOnly">
                    <Setter TargetName="NameText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="PART_SettingsButton" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="HeaderGrid" Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="ToolTip" Value="{Binding UserName, RelativeSource={RelativeSource TemplatedParent}}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="PART_Root" Property="Opacity" Value="0.5" />
                </Trigger>
            </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type local:InfoBar}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Secondary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource DefaultInfoBar}" />
        <Setter Property="atc:Icon.FontFamily" Value="{StaticResource IconFont}" />
        <!--  菜单项纵向排列  -->
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <!--  数据项（ItemsSource 绑定的字符串 / 模型）默认包装为整行按钮：
              全宽左对齐、悬停纱色；点击冒泡 ButtonBase.Click 触发自动收起  -->
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="Button" BasedOn="{StaticResource NoBorderButtonStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="Padding" Value="10,7" />
                    <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Secondary}" />
                    <Setter Property="FontWeight" Value="Normal" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
