<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bt="clr-namespace:Junevy.Controls.Controls.Button">

    <!--  NoBorderButtonTemplate 之外的 jv:Button 模板以 StaticResource 引用，需 Button.xaml 先解析。
          本字典只提供确认对话框页脚区的按钮样式与模板，窗框本体复用 DialogWindow.xaml（DefaultStyleKey 指过去）。  -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Junevy.Controls;component/Controls/Button/Button.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  页脚次要按钮（取消）：与 jv:Button 默认外观一致，仅固定一个舒适的最小宽度  -->
    <Style
        x:Key="ConfirmDialogFooterButtonStyle"
        BasedOn="{StaticResource JvButtonStyle}"
        TargetType="{x:Type bt:Button}">
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
    </Style>

    <!--  页脚主要按钮（确定）：accent 底色 + OnAccent 前景（深色主题下 OnAccent 是墨色，不是写死白字）  -->
    <Style
        x:Key="ConfirmDialogPrimaryButtonStyle"
        BasedOn="{StaticResource ConfirmDialogFooterButtonStyle}"
        TargetType="{x:Type bt:Button}">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.OnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
    </Style>

    <!--  页脚模板：右对齐按钮行。显隐与默认按钮由 ConfirmDialogWindow.SyncFooter 按 Buttons 驱动，
          因此模板本身不带触发器——触发器条件在对话框上，而模板的 TemplatedParent 就是对话框。  -->
    <ControlTemplate x:Key="ConfirmDialogFooterTemplate" TargetType="{x:Type ContentControl}">
        <StackPanel Margin="24,0,24,20" HorizontalAlignment="Right" Orientation="Horizontal">

            <bt:Button
                x:Name="PART_ConfirmButton"
                AutomationProperties.Name="确定"
                Content="确定"
                IsDefault="True"
                Style="{StaticResource ConfirmDialogPrimaryButtonStyle}" />

            <bt:Button
                x:Name="PART_CancelButton"
                AutomationProperties.Name="取消"
                Content="取消"
                Margin="12,0,0,0"
                Style="{StaticResource ConfirmDialogFooterButtonStyle}" />

        </StackPanel>
    </ControlTemplate>

</ResourceDictionary>