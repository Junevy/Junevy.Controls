<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:local="clr-namespace:Junevy.Controls.Controls.Dialog">

    <!--  标题栏按钮图形（描边风格，不依赖图标字体）  -->
    <Geometry x:Key="DialogWindowMinimizeGeometry">M 0,5 L 10,5</Geometry>
    <Geometry x:Key="DialogWindowMaximizeGeometry">M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z</Geometry>
    <Geometry x:Key="DialogWindowRestoreGeometry">M 3,3 L 3,0.5 L 9.5,0.5 L 9.5,7 L 7,7 M 0.5,3 L 7,3 L 7,9.5 L 0.5,9.5 Z</Geometry>
    <Geometry x:Key="DialogWindowCloseGeometry">M 0,0 L 8,8 M 8,0 L 0,8</Geometry>

    <!--  标题栏按钮  -->
    <ControlTemplate x:Key="DialogWindowCaptionButtonTemplate" TargetType="{x:Type Button}">
        <Border
            x:Name="BackgroundBorder"
            Background="{TemplateBinding Background}"
            CornerRadius="0">
            <Path
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Data="{TemplateBinding Tag}"
                Stretch="None"
                Stroke="{TemplateBinding Foreground}"
                StrokeThickness="1"
                UseLayoutRounding="True" />
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="BackgroundBorder" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="BackgroundBorder" Property="Background" Value="{DynamicResource Theme.Brush.Surface.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
                <Setter TargetName="BackgroundBorder" Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="DialogWindowCaptionButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Secondary}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template" Value="{StaticResource DialogWindowCaptionButtonTemplate}" />
    </Style>

    <!--  关闭按钮：悬停/按下使用危险色  -->
    <Style
        x:Key="DialogWindowCloseButtonStyle"
        BasedOn="{StaticResource DialogWindowCaptionButtonStyle}"
        TargetType="{x:Type Button}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="BackgroundBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="0">
                        <Path
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{TemplateBinding Tag}"
                            Stretch="None"
                            Stroke="{TemplateBinding Foreground}"
                            StrokeThickness="1"
                            UseLayoutRounding="True" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BackgroundBorder" Property="Background" Value="{DynamicResource Theme.Brush.Status.Danger}" />
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.OnAccent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BackgroundBorder" Property="Background" Value="{DynamicResource Theme.Brush.Status.DangerHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.OnAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.State.DisabledForeground}" />
                            <Setter TargetName="BackgroundBorder" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  主题化无边框对话框窗口：窗框属性（WindowStyle/AllowsTransparency/Background 等）在窗口构造函数中设置  -->
    <Style TargetType="{x:Type local:DialogWindow}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Primary}" />
        <Setter Property="TitleBarHeight" Value="40" />
        <Setter Property="ShadowMargin" Value="16" />
        <Setter Property="CornerRadius" Value="{DynamicResource Theme.ControlCornerRadius}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DialogWindow}">
                    <!--  WindowChrome 会把模板根元素的 Margin 改写为框架补偿值，
                          因此阴影外边距不能放在根元素上，由内层 RootBorder 承担  -->
                    <Grid>
                        <Border
                            x:Name="RootBorder"
                            Margin="{TemplateBinding ShadowMargin}"
                            Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource Theme.Brush.Surface.Base}"
                            BorderBrush="{DynamicResource Theme.Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Effect="{DynamicResource Theme.PopupShadow}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                            <Grid x:Name="PART_ClipGrid">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  标题栏  -->
                                <Border
                                    Grid.Row="0"
                                    Height="{TemplateBinding TitleBarHeight}"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource Theme.Brush.Border.Subtle}"
                                    BorderThickness="0,0,0,1">
                                    <Grid>
                                        <StackPanel
                                            Margin="14,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <Image
                                                x:Name="PART_Icon"
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Source="{TemplateBinding Icon}" />
                                            <TextBlock
                                                x:Name="TitleText"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{TemplateBinding Foreground}"
                                                Text="{TemplateBinding Title}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                            <Button
                                                x:Name="MinimizeButton"
                                                Height="{TemplateBinding TitleBarHeight}"
                                                Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                                                Style="{StaticResource DialogWindowCaptionButtonStyle}"
                                                Tag="{StaticResource DialogWindowMinimizeGeometry}" />
                                            <Button
                                                x:Name="MaximizeButton"
                                                Height="{TemplateBinding TitleBarHeight}"
                                                Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                                                Style="{StaticResource DialogWindowCaptionButtonStyle}"
                                                Tag="{StaticResource DialogWindowMaximizeGeometry}" />
                                            <Button
                                                x:Name="CloseButton"
                                                Height="{TemplateBinding TitleBarHeight}"
                                                Command="{x:Static SystemCommands.CloseWindowCommand}"
                                                Style="{StaticResource DialogWindowCloseButtonStyle}"
                                                Tag="{StaticResource DialogWindowCloseGeometry}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!--  对话框内容（由宿主注入，如 Prism DialogService）  -->
                                <ContentPresenter Grid.Row="1" x:Name="PART_ContentHost" Content="{TemplateBinding Content}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="PART_Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="ShowMinimizeButton" Value="False">
                            <Setter TargetName="MinimizeButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowMaximizeButton" Value="False">
                            <Setter TargetName="MaximizeButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowCloseButton" Value="False">
                            <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!--  窗口未激活时弱化标题  -->
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Tertiary}" />
                        </Trigger>

                        <!--  最大化：去阴影与圆角，切换还原图标  -->
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="RootBorder" Property="Margin" Value="0" />
                            <Setter TargetName="RootBorder" Property="CornerRadius" Value="0" />
                            <Setter TargetName="RootBorder" Property="Effect" Value="{x:Null}" />
                            <Setter TargetName="MaximizeButton" Property="Command" Value="{x:Static SystemCommands.RestoreWindowCommand}" />
                            <Setter TargetName="MaximizeButton" Property="Tag" Value="{StaticResource DialogWindowRestoreGeometry}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
