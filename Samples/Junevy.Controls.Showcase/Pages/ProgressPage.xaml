<UserControl
    x:Class="Junevy.Controls.Showcase.Pages.ProgressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:demo="clr-namespace:Junevy.Controls.Showcase.Controls"
    xmlns:jv="github.com.junevy"
    xmlns:sample="clr-namespace:Junevy.Controls.Showcase">

    <Border
        Padding="10"
        Background="{DynamicResource Theme.Brush.Background.App}"
        BorderBrush="{DynamicResource Theme.Brush.Border.Subtle}"
        BorderThickness="1"
        CornerRadius="15,0,0,15">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1080" HorizontalAlignment="Center">

                <TextBlock Style="{StaticResource DemoPageTitle}" Text="进度条" />
                <TextBlock
                    Style="{StaticResource DemoPageSubtitle}"
                    Text="jv:ProgressBar（线性 / 环形、确定 / 不确定、进度文本）与 ProgressBarWindow（进度对话框，线程安全汇报与取消）。" />

                <demo:DemoSection
                    Title="jv:ProgressBar 线性（确定模式）"
                    Description="继承 WPF ProgressBar 的 Value / Minimum / Maximum 标准管线（拖动下方 Slider 联动）；ShowProgressText=True 时右侧显示进度文本，不设 ProgressTextFormat 时形如 45%。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.ProgressBarLinearDemo}">
                    <StackPanel>
                        <jv:ProgressBar ShowProgressText="True" Value="{Binding Value, ElementName=ProgressSlider}" />
                        <Slider x:Name="ProgressSlider" Margin="0,12,0,0" Maximum="100" Value="45" />
                    </StackPanel>
                </demo:DemoSection>

                <demo:DemoSection
                    Title="线性不确定模式（IsIndeterminate）"
                    Description="IsIndeterminate=True 时隐藏填充指示器，播放来回扫动动画，用于无法给出百分比的等待场景。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.ProgressBarIndeterminateDemo}">
                    <jv:ProgressBar IsIndeterminate="True" />
                </demo:DemoSection>

                <demo:DemoSection
                    Title="环形进度（ShapeMode=Circular）"
                    Description="ShapeMode=Circular 切换环形：确定模式按值绘制圆弧、进度文本显示在圆环中心，RingThickness 控制圆弧线宽；不确定模式为持续旋转的四分之一圆弧。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.ProgressBarCircularDemo}">
                    <WrapPanel>
                        <jv:ProgressBar
                            Width="56"
                            Height="56"
                            RingThickness="5"
                            ShapeMode="Circular"
                            ShowProgressText="True"
                            Value="{Binding Value, ElementName=ProgressSlider}" />
                        <jv:ProgressBar
                            Width="32"
                            Height="32"
                            Margin="24,0,0,0"
                            RingThickness="3"
                            ShapeMode="Circular"
                            Value="{Binding Value, ElementName=ProgressSlider}" />
                        <jv:ProgressBar
                            Width="32"
                            Height="32"
                            Margin="24,0,0,0"
                            IsIndeterminate="True"
                            RingThickness="3"
                            ShapeMode="Circular" />
                    </WrapPanel>
                </demo:DemoSection>

                <demo:DemoSection
                    Title="自定义进度文本（ProgressTextFormat）"
                    Description="ProgressTextFormat 中 {0} 为 0-100 的整数百分比；格式非法时控件自动回退为默认 45% 形式。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.ProgressBarTextFormatDemo}">
                    <jv:ProgressBar
                        ProgressTextFormat="已完成 {0}%"
                        ShowProgressText="True"
                        Value="{Binding Value, ElementName=ProgressSlider}" />
                </demo:DemoSection>

                <demo:DemoSection
                    Title="ProgressBarWindow（进度对话框）"
                    Description="无系统标题栏的进度对话框，默认环形、可拖动。「确定模式」演示后台任务经 Report / UpdateDetail 线程安全汇报、完成后 RequestClose 关闭、用户可取消（取消经 Cancelled 事件感知）；「不确定模式」演示 CloseButtonEnabled=False 禁止用户取消、由代码延时关闭。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.ProgressBarWindowDemo}">
                    <WrapPanel>
                        <jv:Button Click="OnDeployWindowClick" Content="确定模式（可取消）" />
                        <jv:Button Margin="12,0,0,0" Click="OnWaitingWindowClick" Content="不确定模式（禁止取消）" />
                    </WrapPanel>
                </demo:DemoSection>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
