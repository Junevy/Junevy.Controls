<UserControl
    x:Class="Junevy.Controls.Showcase.Pages.WindowPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:demo="clr-namespace:Junevy.Controls.Showcase.Controls"
    xmlns:jv="github.com.junevy"
    xmlns:sample="clr-namespace:Junevy.Controls.Showcase">

    <Border
        Padding="10"
        Background="{DynamicResource Theme.Brush.Background.App}"
        BorderBrush="{DynamicResource Theme.Brush.Border.Subtle}"
        BorderThickness="1"
        CornerRadius="15,0,0,15">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1080" HorizontalAlignment="Center">

                <TextBlock Style="{StaticResource DemoPageTitle}" Text="窗口与对话框" />
                <TextBlock
                    Style="{StaticResource DemoPageSubtitle}"
                    Text="jv:DialogWindow（无边框圆角对话框宿主）/ ConfirmDialogService（静态确认对话框，直接拿到操作结果）/ ProgressBarWindow（进度对话框，线程安全汇报与取消）。三者都经代码弹出。" />

                <demo:DemoSection
                    Title="jv:DialogWindow（代码实例化弹出）"
                    Description="未启用 SizeToContent 覆盖时窗口尺寸完全跟随内容；标题栏可拖动、边缘可缩放、Esc 可关闭；内容按窗口圆角裁剪。经代码实例化：new DialogWindow { Title = ..., Content = ... } 后 ShowDialog()。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.DialogWindowDemo}">
                    <jv:Button
                        HorizontalAlignment="Left"
                        Click="OnOpenDialogClick"
                        Content="打开对话框（无边框、圆角、主题化标题栏）" />
                </demo:DemoSection>

                <demo:DemoSection
                    Title="ConfirmDialogService（静态确认对话框，返回操作结果）"
                    Description="await ConfirmDialogService.ShowAsync(...) 一行弹出模态确认框并拿到 ConfirmDialogResult：点确定为 Confirm，点取消或按 Esc / ✕ / Alt+F4 一律为 Cancel。Owner 按当前活动窗口自动推断、后台线程调用会自动切回 UI 线程。Buttons 可选 Ok（仅确定）/ OkCancel（确定+取消，默认）/ Cancel（仅取消）。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.ConfirmDialogDemo}">
                    <WrapPanel>
                        <jv:Button Click="OnConfirmOkCancelClick" Content="确定 + 取消（默认）" />
                        <jv:Button Margin="12,0,0,0" Click="OnConfirmOkClick" Content="仅确定（Ok）" />
                        <jv:Button Margin="12,0,0,0" Click="OnConfirmCancelClick" Content="仅取消（Cancel）" />
                    </WrapPanel>
                </demo:DemoSection>

                <demo:DemoSection
                    Title="ProgressBarWindow（进度对话框）"
                    Description="无系统标题栏的进度对话框，默认环形、可拖动。「确定模式」演示后台任务经 Report / UpdateDetail 线程安全汇报、完成后 RequestClose 关闭、用户可取消（取消经 Cancelled 事件感知）；「不确定模式」演示 CloseButtonEnabled=False 禁止用户取消、由代码延时关闭。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.ProgressBarWindowDemo}">
                    <WrapPanel>
                        <jv:Button Click="OnDeployWindowClick" Content="确定模式（可取消）" />
                        <jv:Button Margin="12,0,0,0" Click="OnWaitingWindowClick" Content="不确定模式（禁止取消）" />
                    </WrapPanel>
                </demo:DemoSection>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
