<UserControl
    x:Class="Junevy.Controls.Showcase.Pages.MenusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties;assembly=Junevy.Controls"
    xmlns:demo="clr-namespace:Junevy.Controls.Showcase.Controls"
    xmlns:jv="github.com.junevy"
    xmlns:sample="clr-namespace:Junevy.Controls.Showcase">

    <Border
        Padding="10"
        Background="{DynamicResource Theme.Brush.Background.App}"
        BorderBrush="{DynamicResource Theme.Brush.Border.Subtle}"
        BorderThickness="1"
        CornerRadius="15,0,0,15">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1080" HorizontalAlignment="Center">

                <TextBlock Style="{StaticResource DemoPageTitle}" Text="菜单与导航" />
                <TextBlock
                    Style="{StaticResource DemoPageSubtitle}"
                    Text="jv:SideMenu / 原生 Menu 菜单栏样式 / jv:ContextMenu / jv:TreeView（原 jv:TreeMenu，官方 &lt;TreeView&gt; 合并 Generic.xaml 后自动继承本库样式）/ jv:TabControl。ToolBar / Toolbox / AppBar / InfoBar 请见「栏与工具」演示页。" />

                <demo:DemoSection
                    Title="jv:SideMenu（分类导航菜单）"
                    Description="本程序左侧导航即此控件（DisplayMode=Horizontal：图标与标题横向排列）。DisplayMode=Vertical 时图标在上、标题在下，配合 Orientation=Vertical 组成紧凑图标栏（默认宽度 60）；ItemHeight 调整行高，ItemHoverBackground / SelectedItemBackground 可逐实例定制（默认取中性灰 / Surface.Selected）；菜单项为 jv:MenuItem（Title + Icon，Icon 走 atc:Icon.FontFamily 图标字体）。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.SideMenuDemo}">
                    <StackPanel>
                        <jv:SideMenu
                            Width="240"
                            HorizontalAlignment="Left"
                            ItemHeight="40"
                            SelectionChanged="OnSideMenuSelectionChanged"
                            atc:Icon.FontFamily="{DynamicResource IconFont}"
                            atc:Icon.IconSize="18">
                            <jv:MenuItem Icon="&#xE66B;" Title="数据采集" />
                            <jv:MenuItem Icon="&#xE646;" Title="报表中心" />
                            <jv:MenuItem Icon="&#xE60A;" Title="系统设置" />
                            <jv:MenuItem Icon="&#xE932;" Title="告警记录" IsEnabled="False" />
                        </jv:SideMenu>
                        <TextBlock
                            Margin="0,12,0,6"
                            Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                            Text="DisplayMode=Vertical + Orientation=Vertical（紧凑图标栏）："
                            FontSize="12" />
                        <jv:SideMenu
                            Width="60"
                            HorizontalAlignment="Left"
                            DisplayMode="Vertical"
                            ItemHeight="52"
                            SelectionChanged="OnSideMenuSelectionChanged"
                            atc:Icon.FontFamily="{DynamicResource IconFont}"
                            atc:Icon.IconSize="20">
                            <jv:MenuItem Icon="&#xE66B;" Title="采集" />
                            <jv:MenuItem Icon="&#xE646;" Title="报表" />
                            <jv:MenuItem Icon="&#xE60A;" Title="设置" />
                        </jv:SideMenu>
                    </StackPanel>
                </demo:DemoSection>

                <demo:DemoSection
                    Title="原生 Menu 菜单栏（JunevyMenuBarStyle）"
                    Description="Controls/Menu/MenuBar.xaml 为原生 &lt;Menu&gt; 提供顶栏样式：JunevyMenuBarStyle（菜单栏容器）+ JunevyMenuBarItemStyle（顶层菜单项），合并 Generic.xaml 后按样式键引用即可获得主题化菜单栏；更深层的子菜单项经 ItemContainerStyleSelector 按条目类型分发渲染（Separator 是自带容器，走选择器避免样式类型不匹配），悬停画刷由宿主注入的 atc:MenuAssist.ItemHoverBackground 提供。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.MenuBarDemo}">
                    <Menu
                        HorizontalAlignment="Left"
                        Style="{StaticResource JunevyMenuBarStyle}">
                        <MenuItem Header="文件">
                            <MenuItem Header="新建" InputGestureText="Ctrl+N" />
                            <MenuItem Header="打开" InputGestureText="Ctrl+O" />
                            <Separator />
                            <MenuItem Header="退出" />
                        </MenuItem>
                        <MenuItem Header="视图">
                            <MenuItem Header="放大" InputGestureText="Ctrl+Plus" />
                            <MenuItem Header="缩小" InputGestureText="Ctrl+Minus" />
                            <MenuItem Header="适应窗口" IsChecked="True" />
                        </MenuItem>
                    </Menu>
                </demo:DemoSection>

                <demo:DemoSection
                    Title="jv:ContextMenu（右键按钮打开）"
                    Description="附加到任意元素的 ContextMenu；菜单项请使用原生 MenuItem 或 jv:ContextMenuItem（jv:MenuItem 是 SideMenu 的导航数据控件，不是 WPF 菜单项）；Separator 分组、IsCheckable 复选、InputGestureText 快捷键提示、Icon 图标字体字符均支持。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.ContextMenuDemo}">
                    <StackPanel>
                        <jv:Button Content="右键打开上下文菜单" HorizontalAlignment="Left">
                            <jv:Button.ContextMenu>
                                <jv:ContextMenu>
                                    <jv:ContextMenuItem
                                        Command="{Binding PanelToggleCommand, Source={x:Static sample:SampleData.Instance}}"
                                        Header="打开"
                                        Icon="&#xE60F;"
                                        InputGestureText="Ctrl+O" />
                                    <jv:ContextMenuItem Header="保存" Icon="&#xE611;" InputGestureText="Ctrl+S" />
                                    <Separator />
                                    <jv:ContextMenuItem Header="自动滚动" IsCheckable="True" IsChecked="True" />
                                    <jv:ContextMenuItem Header="导出">
                                        <jv:ContextMenuItem Header="导出为 PNG" />
                                        <jv:ContextMenuItem Header="导出为 JPEG" />
                                    </jv:ContextMenuItem>
                                </jv:ContextMenu>
                            </jv:Button.ContextMenu>
                        </jv:Button>
                    </StackPanel>
                </demo:DemoSection>

                <demo:DemoSection
                    Title="jv:TreeView + TreeMenuItem（数据模型驱动）"
                    Description="TreeMenuItem 为 POCO 数据模型（Title/Icon/Children），由默认 HierarchicalDataTemplate 渲染，可在任意线程构建；TreeViewItem 容器不复用（框架默认 Standard），展开/选中状态保存在 TreeMenuItem 数据模型上。默认容器样式已启用 atc:ExpanderBehavior.Enable：双击/Enter 切换分支展开；NavigateCommand 为选中驱动——选中节点即执行（本页以 MessageBar 反馈导航目标），双击另有 ItemDoubleClick 事件（本页以 MessageBar 反馈双击打开，携带数据项 e.Item，双击展开箭头不触发）；展开图标为 ExpanderPanel 同款旋转箭头。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.TreeViewDemo}">
                    <jv:TreeView
                        x:Name="MainTree"
                        Width="400"
                        Height="420"
                        atc:Icon.FontFamily="{DynamicResource IconFont}"
                        atc:Icon.IconSize="16" />
                </demo:DemoSection>

                <demo:DemoSection
                    Title="DisplayMode=Indicator（左侧层级指示器模式）"
                    Description="Indicator 模式隐藏展开箭头；蓝色 accent 指示条仅标示「选中的带子项节点」（蓝色提示 = 真实选中，非选中分支不显示，行宽经隐藏占位预留、选中时不跳动）。节点图标字号取 atc:Icon.IconSize，标题仍正常显示。DisplayMode 经 atc:TreeViewAssist.DisplayMode 附加属性承载，官方 &lt;TreeView&gt; 上同样可用。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.TreeViewIndicatorDemo}">
                    <jv:TreeView
                        x:Name="IndicatorTree"
                        Width="400"
                        Height="300"
                        DisplayMode="Indicator"
                        atc:Icon.FontFamily="{DynamicResource IconFont}"
                        atc:Icon.IconSize="18" />
                </demo:DemoSection>

                <demo:DemoSection
                    Title="官方 TreeView 自动继承样式（无需 jv: 前缀）"
                    Description="合并 Themes/Generic.xaml 后，官方 &lt;TreeView&gt; 自动获得同一外观（卡片容器、展开箭头、悬停/选中态；容器不复用，展开/选中状态在数据模型上）。jv 专有能力经附加属性同样可用：atc:Icon.FontFamily 提供图标字体，atc:TreeViewAssist.SelectedItemBackground 定制选中画刷（本例改为强调蓝），atc:TreeViewAssist.NavigateCommand 提供叶激活导航（官方树的旧语义，代码设置，见片段注释）。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.TreeViewNativeDemo}">
                    <TreeView
                        x:Name="NativeTree"
                        Width="400"
                        Height="300"
                        atc:Icon.FontFamily="{DynamicResource IconFont}"
                        atc:Icon.IconSize="16"
                        atc:TreeViewAssist.SelectedItemBackground="{DynamicResource Theme.Brush.Surface.Selected}" />
                </demo:DemoSection>

                <demo:DemoSection
                    Title="代码控制展开/选中 + 自定义悬停与选中画刷"
                    Description="TreeMenuItem.IsExpanded / IsSelected 与容器双向绑定：代码直接赋值即可展开/收起、选中节点（选中已生成的容器时库自动展开其祖先；若目标在收起分支里、容器尚未生成，宿主需先沿自己查到的路径展开祖先），递归展开/收起整树用 jv:TreeView.ExpandAll / CollapseAll（收起记住被 WPF 原生语义上提的选中，紧随的展开还原回原节点）；容器不复用（框架默认 Standard），状态保存在数据模型上。悬停与选中背景画刷可逐实例自定义（jv:TreeView 实例属性，或官方实例上的 atc:TreeViewAssist.* 附加属性），默认取 Surface.Hover / Surface.Sunken 中性灰。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.TreeViewInteractionDemo}">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,12">
                            <jv:Button Click="OnExpandAllClick" Content="展开全部" />
                            <jv:Button
                                Margin="8,0,0,0"
                                Click="OnCollapseAllClick"
                                Content="收起全部" />
                            <jv:Button
                                Margin="8,0,0,0"
                                Click="OnSelectCalibrationClick"
                                Content="选中「九点标定」" />
                        </WrapPanel>
                        <jv:TreeView
                            x:Name="ControlledTree"
                            Width="400"
                            Height="260"
                            ItemHoverBackground="{DynamicResource Theme.Brush.Surface.Hover}"
                            SelectedItemBackground="{DynamicResource Theme.Brush.Surface.Selected}"
                            atc:Icon.FontFamily="{DynamicResource IconFont}"
                            atc:Icon.IconSize="16" />
                    </StackPanel>
                </demo:DemoSection>

                <demo:DemoSection
                    Title="jv:TabControl（可关闭页签 + TabClosing 拦截）"
                    Description="IsClosable 控制是否显示关闭按钮（默认 True）；双击文字标题可重命名（CanRename）；CanCloseLastTab=False 保护最后一个页签；TabClosing 事件可取消关闭。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.TabControlDemo}">
                    <jv:TabControl
                        Height="220"
                        CanCloseLastTab="False"
                        CanRename="True"
                        TabClosing="OnTabClosing">
                        <jv:TabControlItem Header="相机 1" Icon="&#xE66B;">
                            <TextBlock Margin="16" Text="相机 1 的内容区域（虚拟数据演示页签内容）。" />
                        </jv:TabControlItem>
                        <jv:TabControlItem Header="日志">
                            <TextBlock Margin="16" Text="日志页签内容。" />
                        </jv:TabControlItem>
                        <jv:TabControlItem Header="保护页">
                            <TextBlock Margin="16" Text="尝试关闭此页签：TabClosing 事件会取消并弹出提示。" />
                        </jv:TabControlItem>
                    </jv:TabControl>
                </demo:DemoSection>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
