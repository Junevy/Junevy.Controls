<UserControl
    x:Class="Junevy.Controls.Showcase.Pages.IconsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties;assembly=Junevy.Controls"
    xmlns:demo="clr-namespace:Junevy.Controls.Showcase.Controls"
    xmlns:jv="github.com.junevy"
    xmlns:sample="clr-namespace:Junevy.Controls.Showcase">

    <Border
        Padding="10"
        Background="{DynamicResource Theme.Brush.Background.App}"
        BorderBrush="{DynamicResource Theme.Brush.Border.Subtle}"
        BorderThickness="1"
        CornerRadius="15,0,0,15">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1080" HorizontalAlignment="Center">

                <TextBlock Style="{StaticResource DemoPageTitle}" Text="图标字体" />
                <TextBlock
                    Style="{StaticResource DemoPageSubtitle}"
                    Text="iconfont（线性/描边）与 iconfont-filled（面性/填充）双风格图标字体，67 个图标码点完全一致，切换 FontFamily 即可整套换风格。" />

                <demo:DemoSection
                    Title="图标总览（67 个）"
                    Description="线性版统一 2/24 描边、圆头圆角；面性版统一实心剪影 + 镂空细节。拖动滑块预览不同尺寸下的可读性，支持按名称/码点过滤。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.IconFontUsage}">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <jv:RadioButton
                                    Checked="OnStyleChanged"
                                    Content="线性（描边）"
                                    GroupName="IconStyle"
                                    IsChecked="True"
                                    IsThreeState="False" />
                                <jv:RadioButton
                                    x:Name="FilledRadio"
                                    Margin="8,0,0,0"
                                    Checked="OnStyleChanged"
                                    Content="面性（填充）"
                                    GroupName="IconStyle"
                                    IsThreeState="False"
                                    Unchecked="OnStyleChanged" />
                            </StackPanel>
                            <jv:TextBox
                                x:Name="FilterBox"
                                Width="220"
                                Margin="20,0,0,0"
                                atc:PlaceholderAssist.Placeholder="按名称 / 码点过滤..."
                                TextChanged="OnFilterChanged" />
                            <jv:Slider
                                x:Name="SizeSlider"
                                Width="180"
                                Margin="20,0,0,0"
                                Maximum="56"
                                Minimum="14"
                                TickFrequency="2"
                                Value="32"
                                ValueChanged="OnSizeChanged"
                                ValueFormatString="F0" />
                        </WrapPanel>

                        <ItemsControl x:Name="IconHost">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Width="106"
                                        Margin="3"
                                        Background="{DynamicResource Theme.Brush.Background.Second}"
                                        BorderBrush="{DynamicResource Theme.Brush.Border.Subtle}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <StackPanel Margin="6,10">
                                            <TextBlock
                                                x:Name="GlyphText"
                                                Height="52"
                                                HorizontalAlignment="Center"
                                                FontFamily="{Binding Font}"
                                                FontSize="{Binding Size}"
                                                Foreground="{DynamicResource Theme.Brush.Text.Primary}"
                                                Text="{Binding Glyph}" />
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                FontSize="10.5"
                                                Foreground="{DynamicResource Theme.Brush.Text.Primary}"
                                                Text="{Binding Name}"
                                                TextAlignment="Center"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding Name}" />
                                            <TextBlock
                                                FontSize="9.5"
                                                Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                                                Text="{Binding Cp}"
                                                TextAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </demo:DemoSection>

                <demo:DemoSection
                    Title="在控件中使用"
                    Description="attached property atc:Icon.Icon 传图标字符，atc:Icon.FontFamily 指定字体（默认线性版）；同一个码点在两种字体下即可得到线性/面性两种视觉。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.IconFontApply}">
                    <StackPanel>
                        <WrapPanel>
                            <jv:Button
                                Margin="0,0,12,0"
                                atc:Icon.Icon="&#xE63F;"
                                atc:Icon.IconSize="16"
                                Content="保存（线性）" />
                            <jv:Button
                                Margin="0,0,12,0"
                                atc:Icon.FontFamily="{StaticResource IconFontFilled}"
                                atc:Icon.Icon="&#xE63F;"
                                atc:Icon.IconSize="16"
                                Content="保存（面性）" />
                            <jv:Button
                                Margin="0,0,12,0"
                                atc:Icon.FontFamily="{StaticResource IconFontFilled}"
                                atc:Icon.Icon="&#xE7DC;"
                                atc:Icon.IconSize="16"
                                Content="运行" />
                            <jv:Button
                                atc:Icon.FontFamily="{StaticResource IconFontFilled}"
                                atc:Icon.Icon="&#xE67D;"
                                atc:Icon.IconSize="16"
                                Content="停止" />
                        </WrapPanel>
                        <WrapPanel Margin="0,12,0,0">
                            <jv:ToggleButton
                                Margin="0,0,12,0"
                                atc:Icon.FontFamily="{StaticResource IconFontFilled}"
                                atc:Icon.Icon="&#xE67E;"
                                atc:Icon.IconSize="16"
                                Content="设置" />
                            <jv:Button
                                Margin="0,0,12,0"
                                atc:Icon.FontFamily="{StaticResource IconFontFilled}"
                                atc:Icon.Icon="&#xE932;"
                                atc:Icon.IconSize="16"
                                Content="警告" />
                            <jv:Button
                                atc:Icon.FontFamily="{StaticResource IconFontFilled}"
                                atc:Icon.Icon="&#xE613;"
                                atc:Icon.IconSize="16"
                                Content="确认" />
                        </WrapPanel>
                    </StackPanel>
                </demo:DemoSection>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
