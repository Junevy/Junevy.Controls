<UserControl
    x:Class="Junevy.Controls.Showcase.Pages.LayoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties;assembly=Junevy.Controls"
    xmlns:demo="clr-namespace:Junevy.Controls.Showcase.Controls"
    xmlns:jv="github.com.junevy"
    xmlns:sample="clr-namespace:Junevy.Controls.Showcase">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1080" HorizontalAlignment="Center">

            <TextBlock Style="{StaticResource DemoPageTitle}" Text="布局控件" />
            <TextBlock
                Style="{StaticResource DemoPageSubtitle}"
                Text="jv:GroupBox（单击标题折叠）/ jv:ExpanderPanel（四方向展开 + 动画）/ Border.CornerRadius 附加用法。" />

            <demo:DemoSection
                Title="jv:GroupBox（可折叠卡片）"
                Description="单击标题折叠/展开（IsCollapsible 默认 True），IsCollapsed 控制初始状态（双向绑定可从代码控制）；IsCollapsible=False 时仅作展示；标题区的按钮、复选框等交互元素不受点击折叠影响。"
                XamlCode="{x:Static sample:ShowcaseSnippets.GroupBoxDemo}">
                <StackPanel>
                    <StackPanel.Resources>
                        <Style x:Key="DemoBox" BasedOn="{StaticResource {x:Type jv:GroupBox}}" TargetType="{x:Type jv:GroupBox}">
                            <Setter Property="Margin" Value="0,6,0,0" />
                        </Style>
                    </StackPanel.Resources>
                    <jv:GroupBox Header="默认：单击标题折叠 / 展开（IsCollapsible=True）">
                        <StackPanel>
                            <jv:TextBox Width="220" HorizontalAlignment="Left" atc:PlaceholderAssist.Placeholder="采集名称" />
                        </StackPanel>
                    </jv:GroupBox>
                    <jv:GroupBox
                        Header="初始折叠（IsCollapsed=True，双向绑定可从代码控制）"
                        IsCollapsed="True">
                        <TextBlock Text="折叠后内容区域完全隐藏，不占布局空间。" />
                    </jv:GroupBox>
                    <jv:GroupBox Header="不可折叠（IsCollapsible=False，仅展示）" IsCollapsible="False">
                        <TextBlock Text="标题仅作展示，悬停无高亮。" />
                    </jv:GroupBox>
                    <jv:GroupBox>
                        <jv:GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <jv:CheckBox Content="启用采集（标题内交互元素不受点击折叠影响）" IsChecked="True" />
                            </StackPanel>
                        </jv:GroupBox.Header>
                        <TextBlock Text="标题区的按钮、复选框等交互元素照常响应。" />
                    </jv:GroupBox>
                </StackPanel>
            </demo:DemoSection>

            <demo:DemoSection
                Title="jv:ExpanderPanel（四方向展开 + 过渡动画）"
                Description="ExpandDirection 支持 Down（默认）/ Up / Left / Right；头部使用 ToggleButton，按 Space 也可切换；动画基于 LayoutTransform，折叠后不留占位空间；第一个面板绑定了 ToggleCommand（切换时经 MessageBarService 弹出通知）；AnimationDuration=0 表示无过渡动画直接切换。"
                XamlCode="{x:Static sample:ShowcaseSnippets.ExpanderPanelDemo}">
                <StackPanel>
                    <jv:ExpanderPanel
                        Header="展开方向 Down（默认，已展开）"
                        AnimationDuration="0:0:0.25"
                        ToggleCommand="{Binding PanelToggleCommand, Source={x:Static sample:SampleData.Instance}}">
                        <Border
                            Padding="12"
                            Background="{DynamicResource Theme.Brush.Surface.Base}"
                            BorderBrush="{DynamicResource Theme.Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <TextBlock Text="头部使用 ToggleButton，按 Space 也可切换；动画基于 LayoutTransform，折叠后不留占位空间。" />
                        </Border>
                    </jv:ExpanderPanel>

                    <jv:ExpanderPanel
                        Margin="0,8,0,0"
                        Header="展开方向 Up（初始折叠，内容向上展开）"
                        AnimationDuration="0:0:0.25"
                        IsExpanded="False">
                        <TextBlock Margin="8" Text="Up：头部在下、内容向上展开。" />
                    </jv:ExpanderPanel>

                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <jv:ExpanderPanel
                            Width="360"
                            Header="Left（内容向左展开）"
                            AnimationDuration="0:0:0.25"
                            ExpandDirection="Left">
                            <StackPanel Width="240" Margin="4">
                                <TextBlock Text="Left：头部在右、内容向左展开。" />
                            </StackPanel>
                        </jv:ExpanderPanel>
                        <jv:ExpanderPanel
                            Width="360"
                            Margin="12,0,0,0"
                            Header="Right（内容向右展开）"
                            AnimationDuration="0:0:0.25"
                            ExpandDirection="Right">
                            <StackPanel Width="240" Margin="4">
                                <TextBlock Text="Right：头部在左、内容向右展开。" />
                            </StackPanel>
                        </jv:ExpanderPanel>
                    </StackPanel>
                </StackPanel>
            </demo:DemoSection>

            <demo:DemoSection
                Title="Border.CornerRadius 附加用法（Button 圆角示例，经样式 Setter 设置）"
                Description="Border.CornerRadius 是 System.Windows.Control 的附加属性用法：逐实例 attribute 写法会被编译器拒绝，需经样式 Setter 设置。"
                XamlCode="{x:Static sample:ShowcaseSnippets.CornerRadiusDemo}">
                <StackPanel>
                    <StackPanel.Resources>
                        <Style x:Key="Corner0Button" BasedOn="{StaticResource {x:Type jv:Button}}" TargetType="{x:Type jv:Button}">
                            <Setter Property="Border.CornerRadius" Value="0" />
                        </Style>
                        <Style x:Key="Corner8Button" BasedOn="{StaticResource {x:Type jv:Button}}" TargetType="{x:Type jv:Button}">
                            <Setter Property="Border.CornerRadius" Value="8" />
                        </Style>
                        <Style x:Key="Corner16Button" BasedOn="{StaticResource {x:Type jv:Button}}" TargetType="{x:Type jv:Button}">
                            <Setter Property="Border.CornerRadius" Value="16" />
                        </Style>
                    </StackPanel.Resources>
                    <WrapPanel>
                        <jv:Button Content="圆角 0" Style="{StaticResource Corner0Button}" />
                        <jv:Button Content="圆角 8" Style="{StaticResource Corner8Button}" />
                        <jv:Button Content="圆角 16" Style="{StaticResource Corner16Button}" />
                    </WrapPanel>
                </StackPanel>
            </demo:DemoSection>

        </StackPanel>
    </ScrollViewer>
</UserControl>
