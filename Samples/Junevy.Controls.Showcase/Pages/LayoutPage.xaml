<UserControl
    x:Class="Junevy.Controls.Showcase.Pages.LayoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties;assembly=Junevy.Controls"
    xmlns:demo="clr-namespace:Junevy.Controls.Showcase.Controls"
    xmlns:jv="github.com.junevy"
    xmlns:sample="clr-namespace:Junevy.Controls.Showcase">

    <Border
        Padding="10"
        Background="{DynamicResource Theme.Brush.Background.App}"
        BorderBrush="{DynamicResource Theme.Brush.Border.Subtle}"
        BorderThickness="1"
        CornerRadius="15,0,0,15">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1080" HorizontalAlignment="Center">

                <TextBlock Style="{StaticResource DemoPageTitle}" Text="布局控件" />
                <TextBlock
                    Style="{StaticResource DemoPageSubtitle}"
                    Text="jv:ExpanderPanel（四方向展开 + 动画）/ jv:SidePanel（滑出面板）/ Border.CornerRadius 附加用法。GroupBox 已归入「输入与选择」演示页。" />

                <demo:DemoSection
                    Title="jv:ExpanderPanel（四方向展开 + 过渡动画）"
                    Description="ExpandDirection 支持 Down（默认）/ Up / Left / Right；头部使用 ToggleButton，按 Space 也可切换；动画基于 LayoutTransform，折叠后不留占位空间；第一个面板绑定了 ToggleCommand（切换时经 MessageBarService 弹出通知）；AnimationDuration=0 表示无过渡动画直接切换。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.ExpanderPanelDemo}">
                    <StackPanel>
                        <jv:ExpanderPanel
                            Header="展开方向 Down（默认，已展开）"
                            AnimationDuration="0:0:0.25"
                            ToggleCommand="{Binding PanelToggleCommand, Source={x:Static sample:SampleData.Instance}}">
                            <Border
                                Padding="12"
                                Background="{DynamicResource Theme.Brush.Surface.Base}"
                                BorderBrush="{DynamicResource Theme.Brush.Border.Default}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <TextBlock Text="头部使用 ToggleButton，按 Space 也可切换；动画基于 LayoutTransform，折叠后不留占位空间。" />
                            </Border>
                        </jv:ExpanderPanel>

                        <jv:ExpanderPanel
                            Margin="0,8,0,0"
                            Header="展开方向 Up（初始折叠，内容向上展开）"
                            AnimationDuration="0:0:0.25"
                            IsExpanded="False">
                            <TextBlock Margin="8" Text="Up：头部在下、内容向上展开。" />
                        </jv:ExpanderPanel>

                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <jv:ExpanderPanel
                                Width="360"
                                Header="Left（内容向左展开）"
                                AnimationDuration="0:0:0.25"
                                ExpandDirection="Left">
                                <StackPanel Width="240" Margin="4">
                                    <TextBlock Text="Left：头部在右、内容向左展开。" />
                                </StackPanel>
                            </jv:ExpanderPanel>
                            <jv:ExpanderPanel
                                Width="360"
                                Margin="12,0,0,0"
                                Header="Right（内容向右展开）"
                                AnimationDuration="0:0:0.25"
                                ExpandDirection="Right">
                                <StackPanel Width="240" Margin="4">
                                    <TextBlock Text="Right：头部在左、内容向右展开。" />
                                </StackPanel>
                            </jv:ExpanderPanel>
                        </StackPanel>
                    </StackPanel>
                </demo:DemoSection>

                <demo:DemoSection
                    Title="jv:ExpanderPanel —— 卡片模式（DisplayMode=Card）"
                    Description="高头部卡片：图标 + 标题/补充说明 + 右侧扩展槽 + 展开箭头，整卡带底色描边、内容向下展开（ExpandDirection 仅经典模式生效）。Header 复用为标题；右侧控件槽独立命中——其中的开关/按钮不会误触发展开，空白处点击仍切换；无图标/说明时槽位折叠、头部自适应变矮。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.ExpanderPanelCardDemo}">
                    <StackPanel>
                        <jv:ExpanderPanel
                            DisplayMode="Card"
                            Icon="&#xE60C;"
                            Header="采集通道配置"
                            Description="展开后配置各通道的触发模式与采样率">
                            <Border
                                Padding="8"
                                Background="{DynamicResource Theme.Brush.Background.App}"
                                CornerRadius="6">
                                <TextBlock Text="卡片展开后的内容区。整卡带底色与描边，内容向下展开。" />
                            </Border>
                        </jv:ExpanderPanel>

                        <jv:ExpanderPanel
                            DisplayMode="Card"
                            IsExpanded="False"
                            Icon="&#xE60F;"
                            Header="自动曝光"
                            Description="启用后由相机驱动自动调整曝光时间与增益">
                            <jv:ExpanderPanel.HeaderExtra>
                                <StackPanel Orientation="Horizontal">
                                    <jv:ToggleButton IsChecked="True" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="On" />
                                </StackPanel>
                            </jv:ExpanderPanel.HeaderExtra>
                            <TextBlock Margin="4" Text="曝光策略内容区。试着点击右侧开关——它独立于展开切换。" />
                        </jv:ExpanderPanel>

                        <jv:ExpanderPanel
                            DisplayMode="Card"
                            Header="仅标题的卡片"
                            IsExpanded="False">
                            <TextBlock Margin="4" Text="无图标、无说明、无右侧控件。" />
                        </jv:ExpanderPanel>
                    </StackPanel>
                </demo:DemoSection>

                <demo:DemoSection
                    Title="jv:SidePanel（滑出面板）"
                    Description="作为浮层放入 Grid 等布局容器，经 IsOpen / Toggle() 控制滑出收回，Side 指定停靠边（Left / Right / Top / Bottom）；收起时不占布局空间，展开时叠加在兄弟内容上方。CloseOnOutsideClick 默认开启（点击面板外部、宿主窗口失焦或最小化时自动收回），IsBackdropEnabled=True 显示半透明遮罩；Opened / Closed 事件可感知开合。主窗口右上角齿轮打开的设置抽屉即本控件。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.SidePanelDemo}">
                    <StackPanel>
                        <WrapPanel>
                            <jv:Button Click="OnLeftPanelClick" Content="从左侧滑出" />
                            <jv:Button Margin="12,0,0,0" Click="OnRightPanelClick" Content="从右侧滑出（带遮罩）" />
                        </WrapPanel>
                        <Grid Height="220" Margin="0,12,0,0">
                            <Border
                                Background="{DynamicResource Theme.Brush.Surface.Base}"
                                BorderBrush="{DynamicResource Theme.Brush.Border.Default}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                                    Text="面板滑出层的宿主区域（模拟页面内容）。" />
                            </Border>
                            <jv:SidePanel x:Name="LeftPanel" Side="Left">
                                <StackPanel Width="240" Margin="20,16">
                                    <TextBlock FontWeight="Bold" Text="左侧面板（Side=Left）" />
                                    <TextBlock
                                        Margin="0,6,0,12"
                                        FontSize="12"
                                        Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                                        Text="点面板外部自动收回（CloseOnOutsideClick 默认开启）。"
                                        TextWrapping="Wrap" />
                                    <jv:Button
                                        HorizontalAlignment="Left"
                                        Click="OnClosePanelClick"
                                        Content="关闭面板" />
                                </StackPanel>
                            </jv:SidePanel>
                            <jv:SidePanel
                                x:Name="RightPanel"
                                Side="Right"
                                IsBackdropEnabled="True">
                                <StackPanel Width="240" Margin="20,16">
                                    <TextBlock FontWeight="Bold" Text="右侧面板（带遮罩）" />
                                    <TextBlock
                                        Margin="0,6,0,12"
                                        FontSize="12"
                                        Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                                        Text="IsBackdropEnabled=True 时显示半透明遮罩，点击遮罩同样收回。"
                                        TextWrapping="Wrap" />
                                    <jv:Button
                                        HorizontalAlignment="Left"
                                        Click="OnClosePanelClick"
                                        Content="关闭面板" />
                                </StackPanel>
                            </jv:SidePanel>
                        </Grid>
                    </StackPanel>
                </demo:DemoSection>

                <demo:DemoSection
                    Title="Border.CornerRadius 附加用法（Button 圆角示例，经样式 Setter 设置）"
                    Description="Border.CornerRadius 是 System.Windows.Control 的附加属性用法：逐实例 attribute 写法会被编译器拒绝，需经样式 Setter 设置。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.CornerRadiusDemo}">
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style x:Key="Corner0Button" BasedOn="{StaticResource {x:Type jv:Button}}" TargetType="{x:Type jv:Button}">
                                <Setter Property="Border.CornerRadius" Value="0" />
                            </Style>
                            <Style x:Key="Corner8Button" BasedOn="{StaticResource {x:Type jv:Button}}" TargetType="{x:Type jv:Button}">
                                <Setter Property="Border.CornerRadius" Value="8" />
                            </Style>
                            <Style x:Key="Corner16Button" BasedOn="{StaticResource {x:Type jv:Button}}" TargetType="{x:Type jv:Button}">
                                <Setter Property="Border.CornerRadius" Value="16" />
                            </Style>
                        </StackPanel.Resources>
                        <WrapPanel>
                            <jv:Button Content="圆角 0" Style="{StaticResource Corner0Button}" />
                            <jv:Button Content="圆角 8" Style="{StaticResource Corner8Button}" />
                            <jv:Button Content="圆角 16" Style="{StaticResource Corner16Button}" />
                        </WrapPanel>
                    </StackPanel>
                </demo:DemoSection>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
