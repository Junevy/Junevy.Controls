<UserControl
    x:Class="Junevy.Controls.Showcase.Pages.TextStatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties;assembly=Junevy.Controls"
    xmlns:demo="clr-namespace:Junevy.Controls.Showcase.Controls"
    xmlns:jv="github.com.junevy"
    xmlns:sample="clr-namespace:Junevy.Controls.Showcase">

    <Border
        Padding="10"
        Background="{DynamicResource Theme.Brush.Background.App}"
        BorderBrush="{DynamicResource Theme.Brush.Border.Subtle}"
        BorderThickness="1"
        CornerRadius="15,0,0,15">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1080" HorizontalAlignment="Center">

                <TextBlock Style="{StaticResource DemoPageTitle}" Text="文本与状态" />
                <TextBlock
                    Style="{StaticResource DemoPageSubtitle}"
                    Text="jv:Label（DisplayMode）/ jv:TextBlock / ToolTip（官方控件主题接管）。" />

                <demo:DemoSection
                    Title="jv:Label（DisplayMode 全模式）"
                    Description="各模式通过样式触发器注入默认图标（atc:Icon.Icon），可用局部值覆盖；图标为空时折叠图标区域；Neutral 模式背景跟随 Background。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.LabelDemo}">
                    <StackPanel>
                        <WrapPanel>
                            <jv:Label Content="Error（默认）" DisplayMode="Error" />
                            <jv:Label Content="Success" DisplayMode="Success" />
                            <jv:Label Content="Warning" DisplayMode="Warning" />
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <jv:Label Content="BorderlessError" DisplayMode="BorderlessError" />
                            <jv:Label Content="BorderlessWarning" DisplayMode="BorderlessWarning" />
                            <jv:Label Content="BorderlessNotice" DisplayMode="BorderlessNotice" />
                            <jv:Label
                                atc:Icon.Icon="&#xE651;"
                                Content="Neutral + 自定义图标"
                                DisplayMode="Neutral" />
                        </WrapPanel>
                    </StackPanel>
                </demo:DemoSection>

                <demo:DemoSection
                    Title="jv:TextBlock（左内容 + 右文本）"
                    Description="ContentTemplate 提供左侧任意内容（此处为图标方块），Text 为右侧文本；宽度受限时文本自动省略截断。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.TextBlockDemo}">
                    <StackPanel>
                        <StackPanel.Resources>
                            <DataTemplate x:Key="IconTemplate">
                                <Border
                                    Width="30"
                                    Height="30"
                                    Background="{DynamicResource Theme.Brush.Accent.Primary}"
                                    CornerRadius="6">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{DynamicResource IconFont}"
                                        FontSize="16"
                                        Foreground="{DynamicResource Theme.Brush.Text.OnAccent}"
                                        Text="&#xE66B;" />
                                </Border>
                            </DataTemplate>
                        </StackPanel.Resources>
                        <jv:TextBlock
                            Width="320"
                            ContentTemplate="{StaticResource IconTemplate}"
                            Text="Inspection Station"
                            FontSize="16" />
                        <jv:TextBlock
                            Width="320"
                            Margin="0,8,0,0"
                            ContentTemplate="{StaticResource IconTemplate}"
                            Text="标题超宽时以省略号截断显示 Inspect"
                            FontSize="14" />
                    </StackPanel>
                </demo:DemoSection>

                <demo:DemoSection
                    Title="ToolTip（合并 Generic.xaml 后任意元素自动生效）"
                    Description="库主题字典合并后，原生 ToolTip 全局自动应用主题样式，无需逐元素设置。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.ToolTipDemo}">
                    <WrapPanel>
                        <TextBlock
                            Margin="0,4"
                            Text="悬浮到我这里查看原生 ToolTip"
                            ToolTip="取值范围 1.0 - 16.0，调整后立即生效" />
                        <jv:Button
                            Margin="16,0,0,0"
                            Content="按钮 ToolTip"
                            ToolTip="jv:Button 上的 ToolTip 同样获得主题样式" />
                        <jv:CheckBox
                            Margin="16,0,0,0"
                            Content="复选框 ToolTip"
                            ToolTip="任意 FrameworkElement 的 ToolTip 属性" />
                    </WrapPanel>
                </demo:DemoSection>
                <demo:DemoSection
                    Title="jv:CodeEditor（代码编辑器）"
                    Description="内部封装 AvalonEdit：SyntaxLanguage 运行时可切换，语法着色统一映射主题画刷（点右上角按钮切主题即可验证）；本页已挂关键词补全（输入如 ret / name 触发，Ctrl+Space 强制弹出），完整系统类 IntelliSense 见伴生包 Junevy.Controls.CodeCompletion。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.CodeEditorDemo}">
                    <jv:CodeEditor
                        x:Name="CodeEditorInstance"
                        Height="320"
                        SyntaxLanguage="CSharp"
                        ShowLineNumbers="True" />
                </demo:DemoSection>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
