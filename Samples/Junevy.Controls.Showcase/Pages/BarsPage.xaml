<UserControl
    x:Class="Junevy.Controls.Showcase.Pages.BarsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties;assembly=Junevy.Controls"
    xmlns:demo="clr-namespace:Junevy.Controls.Showcase.Controls"
    xmlns:jv="github.com.junevy"
    x:Name="PageRoot"
    xmlns:sample="clr-namespace:Junevy.Controls.Showcase">

    <UserControl.Resources>
        <!--  InfoBar ItemsSource 列表项的呈现模板  -->
        <DataTemplate x:Key="InfoBarMenuItemTemplate">
            <TextBlock
                Margin="8,7"
                FontSize="13"
                Text="{Binding}" />
        </DataTemplate>
    </UserControl.Resources>

    <Border
        Padding="10"
        Background="{DynamicResource Theme.Brush.Background.App}"
        BorderBrush="{DynamicResource Theme.Brush.Border.Subtle}"
        BorderThickness="1"
        CornerRadius="15,0,0,15">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1080" HorizontalAlignment="Center">

                <TextBlock Style="{StaticResource DemoPageTitle}" Text="栏与工具" />
                <TextBlock
                    Style="{StaticResource DemoPageSubtitle}"
                    Text="jv:ToolBar / jv:Toolbox / jv:AppBar / jv:InfoBar——应用壳层的各种栏与工具箱控件（AppBar 默认模板已作为本程序标题栏使用）。" />

                <demo:DemoSection
                    Title="jv:ToolBar（横向 / 纵向）"
                    Description="ToolBarItem.Icon 是按钮自身属性；ToolBar 继承 WPF ItemsControl，也支持 ItemsSource + ItemContainerStyle 绑定；Orientation=Vertical 切换纵向。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.ToolBarDemo}">
                    <StackPanel>
                        <jv:ToolBar
                            HorizontalAlignment="Left"
                            FontFamily="{DynamicResource IconFont}"
                            FontSize="16"
                            Foreground="{DynamicResource Theme.Brush.Text.Primary}">
                            <jv:ToolBarItem Icon="&#xE60F;" ToolTip="设置" />
                            <jv:ToolBarItem Icon="&#xE611;" ToolTip="刷新" />
                            <jv:ToolBarItem Icon="&#xE932;" ToolTip="告警" />
                            <jv:ToolBarItem Icon="&#xE60C;" ToolTip="截图" />
                        </jv:ToolBar>
                        <jv:ToolBar
                            Width="48"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            FontFamily="{DynamicResource IconFont}"
                            FontSize="16"
                            Foreground="{DynamicResource Theme.Brush.Text.Primary}"
                            Orientation="Vertical">
                            <jv:ToolBarItem Icon="&#xE60F;" ToolTip="设置" />
                            <jv:ToolBarItem Icon="&#xE611;" ToolTip="刷新" />
                            <jv:ToolBarItem Icon="&#xE932;" ToolTip="告警" />
                        </jv:ToolBar>
                    </StackPanel>
                </demo:DemoSection>

                <demo:DemoSection
                    Title="jv:Toolbox（悬浮工具箱：悬停分组打开 Popup，工具可拖放）"
                    Description="任意时刻最多展开一个分组；ToolItem 按住可发起 Copy 拖放（IsDragEnabled 默认 True，十字指针）；图标颜色由 atc:Icon.IconForeground 控制、标题颜色由 Foreground 控制。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.ToolboxDemo}">
                    <jv:Toolbox HorizontalAlignment="Left">
                        <jv:ToolboxItem Icon="&#xE60F;" Title="基础工具">
                            <jv:ToolItem Icon="&#xE611;" Title="刷新" />
                            <jv:ToolItem Icon="&#xE60C;" Title="截图" />
                            <jv:ToolItem Icon="&#xE650;" Title="移动" />
                            <jv:ToolItem Icon="&#xE932;" Title="检测" />
                        </jv:ToolboxItem>
                        <jv:ToolboxItem Icon="&#xE66B;" Title="视觉工具">
                            <jv:ToolItem Icon="&#xE981;" Title="定位" />
                            <jv:ToolItem Icon="&#xE60F;" Title="标定" />
                        </jv:ToolboxItem>
                    </jv:Toolbox>
                </demo:DemoSection>

                <demo:DemoSection
                    Title="jv:Toolbox 紧凑样式（约 25px 窄列：CompactToolboxStyle）"
                    Description="整条约 25 DIP：容器 MaxWidth=25 兜底，实例级 ItemContainerStyle 指定更宽的项样式时窄列也不会被撑宽（条目样式内固定 Width/MinWidth 大于约 21 DIP 会被裁剪，自定义项样式建议 BasedOn CompactToolboxItemStyle）；窄列容不下滚动条，条目溢出时滚动条隐藏、滚轮仍可滚动；弹出面板与工具项尺寸不受窄列影响。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.CompactToolboxDemo}">
                    <jv:Toolbox
                        HorizontalAlignment="Left"
                        ColumnCount="3"
                        PopupWidth="225"
                        Style="{StaticResource CompactToolboxStyle}">
                        <jv:ToolboxItem Icon="&#xE60F;" Title="基础工具">
                            <jv:ToolItem Icon="&#xE611;" Title="刷新" />
                            <jv:ToolItem Icon="&#xE60C;" Title="截图" />
                            <jv:ToolItem Icon="&#xE932;" Title="检测" />
                        </jv:ToolboxItem>
                        <jv:ToolboxItem Icon="&#xE66B;" Title="视觉工具">
                            <jv:ToolItem Icon="&#xE981;" Title="定位" />
                            <jv:ToolItem Icon="&#xE60F;" Title="标定" />
                        </jv:ToolboxItem>
                        <jv:ToolboxItem Icon="&#xE650;" Title="布局工具">
                            <jv:ToolItem Icon="&#xE60C;" Title="对齐" />
                            <jv:ToolItem Icon="&#xE650;" Title="分布" />
                        </jv:ToolboxItem>
                    </jv:Toolbox>
                </demo:DemoSection>

                <demo:DemoSection
                    Title="jv:AppBar Mode=Expandable（可展开标题栏：抽屉 + 居中标题 + 系统按钮）"
                    Description="AppBar 经 Mode 枚举切换布局（Default / MenuBar / Expandable）。Expandable：最左侧为抽屉开关（设置了 Drawer 内容才显示），点击在标题栏下方展开悬浮抽屉——点抽屉外部收起，再次点击开关同样收起（开合防抖）；AutoCloseOnDrawerClick=True 时点击抽屉内的列表项等未处理点击自动收起。标题在整条标题栏内居中；最右侧最小化 / 最大化（还原）/ 关闭按钮经 SystemCommands 作用于所在窗口——即本演示程序，Close 会真的关闭它，请慎点。拖动仍交由宿主 WindowChrome caption 区（建议 CaptionHeight 绑定本控件 ActualHeight）。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.AppBarExpandableDemo}">
                    <jv:AppBar
                        Height="56"
                        Mode="Expandable"
                        AutoCloseOnDrawerClick="True"
                        Content="Junevy Studio"
                        atc:Icon.FontFamily="{DynamicResource IconFont}">
                        <jv:AppBar.Drawer>
                            <ListBox MinWidth="200">
                                <ListBoxItem Content="首页" IsSelected="True" />
                                <ListBoxItem Content="数据采集" />
                                <ListBoxItem Content="报表中心" />
                                <ListBoxItem Content="系统设置" />
                            </ListBox>
                        </jv:AppBar.Drawer>
                    </jv:AppBar>
                </demo:DemoSection>

                <demo:DemoSection
                    Title="jv:InfoBar（用户信息条：头像 + 名称 / 仅头像，点击弹出菜单或面板）"
                    Description="Text 布局：头像（AvatarSource 图片，或名称首字符字标）+ 名称 + 可选设置按钮（SettingsClick 路由事件）；AvatarOnly 布局：仅头像（指定宽度时居中），悬停经 ToolTip 显示名称。点击弹出与控件等宽的菜单：菜单项可在 XAML 中直接编写（作为 Items），也可经 ItemsSource 绑定列表（项外观用 ItemTemplate 定制）；设 MenuContent 后弹层变为任意面板内容（ListBox / UserControl / 复杂布局），宽度用 MenuWidth 指定、高度用 MenuMaxHeight 限制。默认向上展开（MenuPlacement 可换），点菜单外部或再次点击收起，AutoCloseOnMenuClick=True 时点击菜单内按钮项自动收起。"
                    XamlCode="{x:Static sample:ShowcaseSnippets.InfoBarDemo}">
                    <StackPanel>
                        <jv:InfoBar
                            Width="280"
                            HorizontalAlignment="Left"
                            UserName="xuhill07"
                            AutoCloseOnMenuClick="True"
                            SettingsClick="OnInfoBarSettingsClick">
                            <jv:Button
                                HorizontalContentAlignment="Left"
                                Content="&#xE60F; 应用设置"
                                Style="{StaticResource NoBorderButtonStyle}" />
                            <jv:Button
                                HorizontalContentAlignment="Left"
                                Content="&#xE651; 个人资料"
                                Style="{StaticResource NoBorderButtonStyle}" />
                            <jv:Button
                                HorizontalContentAlignment="Left"
                                Content="&#xE639; 退出登录"
                                Style="{StaticResource NoBorderButtonStyle}" />
                        </jv:InfoBar>
                        <jv:InfoBar
                            Width="120"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            DisplayMode="AvatarOnly"
                            UserName="xuhill07"
                            AvatarSource="pack://application:,,,/Junevy.Controls;component/Resources/Pictures/Author.png"
                            ItemsSource="{Binding InfoBarMenuItems, ElementName=PageRoot}"
                            ItemTemplate="{StaticResource InfoBarMenuItemTemplate}"
                            ButtonBase.Click="OnInfoBarMenuItemClick"
                            SettingsClick="OnInfoBarSettingsClick" />
                        <jv:InfoBar
                            Width="280"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            UserName="操作面板"
                            MenuWidth="360"
                            MenuMaxHeight="240"
                            SettingsClick="OnInfoBarSettingsClick">
                            <!--  MenuContent:任意面板内容(ListBox / UserControl / 复杂布局),
                                  等宽约束被 MenuWidth 覆盖;AutoCloseOnMenuClick 只对按钮项生效  -->
                            <jv:InfoBar.MenuContent>
                                <StackPanel>
                                    <TextBlock
                                        Margin="8,8,8,4"
                                        FontWeight="Bold"
                                        Text="快捷操作" />
                                    <ListBox BorderThickness="0">
                                        <ListBoxItem Content="任务 1:导出检测报告" />
                                        <ListBoxItem Content="任务 2:重建索引" />
                                        <ListBoxItem Content="任务 3:清理缓存" />
                                    </ListBox>
                                </StackPanel>
                            </jv:InfoBar.MenuContent>
                        </jv:InfoBar>
                    </StackPanel>
                </demo:DemoSection>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
