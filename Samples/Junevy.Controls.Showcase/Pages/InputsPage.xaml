<UserControl
    x:Class="Junevy.Controls.Showcase.Pages.InputsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties;assembly=Junevy.Controls"
    xmlns:jv="github.com.junevy">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1080">

            <TextBlock FontSize="20" FontWeight="Bold" Text="输入与选择" />
            <TextBlock
                Margin="0,4,0,4"
                FontSize="12"
                Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                Text="jv:CheckBox / jv:TextBox / jv:ComboBox / DatePicker / jv:Slider。本页重点演示附加属性：PlaceholderAssist、TitleAssist、Icon、ShowClear、DatePickerAssist。" />

            <jv:GroupBox Header="jv:CheckBox">
                <WrapPanel>
                    <jv:CheckBox Content="启用检测" IsChecked="True" />
                    <jv:CheckBox Content="未选中" />
                    <jv:CheckBox Content="不确定态" IsChecked="{x:Null}" IsThreeState="True" />
                    <jv:CheckBox Content="禁用" IsChecked="True" IsEnabled="False" />
                </WrapPanel>
            </jv:GroupBox>

            <jv:GroupBox Header="jv:TextBox —— PlaceholderAssist / Icon / ShowClear" Margin="0,16,0,0">
                <StackPanel>
                    <WrapPanel>
                        <jv:TextBox
                            Width="240"
                            atc:PlaceholderAssist.Placeholder="相机名称（纯占位符）" />
                        <jv:TextBox
                            Width="240"
                            atc:Icon.FontFamily="{DynamicResource IconFont}"
                            atc:Icon.Icon="&#xE60C;"
                            atc:PlaceholderAssist.Placeholder="图标 + 占位符 + 清空"
                            ShowClear="True" />
                        <jv:TextBox
                            Width="240"
                            atc:Icon.FontFamily="{DynamicResource IconFont}"
                            atc:Icon.Icon="&#xE60F;"
                            atc:PlaceholderAssist.Placeholder="&#xE60F; 检索设备（iconfont 占位符）"
                            ShowClear="True" />
                        <jv:TextBox
                            Width="240"
                            atc:Icon.FontFamily="{DynamicResource IconFont}"
                            atc:Icon.Icon="&#xE60C;"
                            atc:PlaceholderAssist.Placeholder="ShowClear=False 无清空按钮"
                            ShowClear="False" />
                        <TextBox
                            Width="240"
                            atc:PlaceholderAssist.Placeholder="原生 TextBox 借用外观" />
                        <jv:TextBox Text="有值时占位符自动隐藏" Width="240" />
                    </WrapPanel>
                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                        Text="占位符仅在控件无值时显示（TextBox：文本为空且未聚焦）；占位内容为 object，iconfont 字形时字体族跟随 atc:Icon.FontFamily；原生 TextBox 经附加属性同样生效；Tag 不再被模板消费。" />
                </StackPanel>
            </jv:GroupBox>

            <jv:GroupBox Header="jv:TextBox —— TitleAssist（输入框外侧标题）" Margin="0,16,0,0">
                <StackPanel>
                    <WrapPanel>
                        <jv:TextBox
                            Width="220"
                            atc:TitleAssist.Title="Server IP（Top）" />
                        <jv:TextBox
                            Width="220"
                            atc:TitleAssist.Title="Server IP（Left）"
                            atc:TitleAssist.TitlePlacement="Left" />
                        <jv:TextBox
                            Width="220"
                            atc:TitleAssist.Title="Server IP（Bottom）"
                            atc:TitleAssist.TitlePlacement="Bottom" />
                        <jv:TextBox
                            Width="220"
                            atc:TitleAssist.Title="Server IP（Right）"
                            atc:TitleAssist.TitlePlacement="Right" />
                        <jv:ComboBox
                            Width="220"
                            atc:TitleAssist.Title="&#xE60F; Settings"
                            atc:TitleAssist.TitleFontFamily="{DynamicResource IconFont}"
                            atc:TitleAssist.TitleFontSize="14"
                            atc:TitleAssist.TitleFontWeight="Bold"
                            atc:TitleAssist.TitleForeground="OrangeRed"
                            atc:PlaceholderAssist.Placeholder="iconfont 标题 ComboBox" />
                    </WrapPanel>
                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                        Text="标题内容为 object（可直接设 iconfont 字形）；TitlePlacement 四方位、间距固定 4 DIP；字体族/字号未设置时继承控件自身值，颜色未设置时取主题次级文本色。" />
                </StackPanel>
            </jv:GroupBox>

            <jv:GroupBox Header="jv:ComboBox" Margin="0,16,0,0">
                <StackPanel>
                    <WrapPanel>
                        <jv:ComboBox ItemsSource="{Binding Cameras}" SelectedIndex="0" />
                        <jv:ComboBox atc:PlaceholderAssist.Placeholder="选择采集模式...">
                            <jv:ComboBoxItem Content="Continuous" />
                            <jv:ComboBoxItem Content="Trigger" />
                            <jv:ComboBoxItem Content="Software" />
                        </jv:ComboBox>
                        <jv:ComboBox
                            IsEditable="True"
                            atc:PlaceholderAssist.Placeholder="可编辑 + 占位符" />
                        <jv:ComboBox />
                        <ComboBox atc:PlaceholderAssist.Placeholder="原生 ComboBox 占位" />
                    </WrapPanel>
                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                        Text="不可编辑时单击主体区域与单击箭头等效；jv:ComboBox 未设置占位符时隐式样式保留历史默认文案 “Select an item...”；原生 ComboBox 无默认文案，可经附加属性提供。" />
                </StackPanel>
            </jv:GroupBox>

            <jv:GroupBox Header="DatePicker —— DatePickerAssist.PlaceHolder" Margin="0,16,0,0">
                <StackPanel>
                    <WrapPanel>
                        <DatePicker atc:DatePickerAssist.PlaceHolder="选择开始日期" />
                        <DatePicker SelectedDate="2026-09-20" atc:DatePickerAssist.PlaceHolder="选择结束日期" />
                    </WrapPanel>
                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                        Text="DatePicker 为官方控件完整主题接管；注意占位符是 DatePickerAssist.PlaceHolder（大写 H，string 类型），与 PlaceholderAssist.Placeholder 区分。" />
                </StackPanel>
            </jv:GroupBox>

            <jv:GroupBox Header="jv:Slider（数值框）" Margin="0,16,0,0">
                <StackPanel>
                    <jv:Slider
                        Margin="0,2,0,2"
                        Maximum="100"
                        Minimum="0"
                        TickFrequency="10"
                        TickPlacement="BottomRight"
                        Value="60"
                        ValueBoxSide="Right"
                        ValueFormatString="F0" />
                    <jv:Slider
                        Margin="0,2,0,2"
                        Maximum="16"
                        Minimum="1"
                        TickFrequency="1"
                        TickPlacement="BottomRight"
                        Value="8"
                        ValueBoxSide="Left"
                        ValueFormatString="F1" />
                    <jv:Slider
                        Margin="0,2,0,2"
                        Maximum="100"
                        Minimum="0"
                        Value="45"
                        ValueBoxSide="Bottom"
                        ValueFormatString="p0" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <jv:Slider
                            Width="200"
                            Margin="0,0,32,0"
                            Maximum="100"
                            Minimum="0"
                            ShowValueBox="False"
                            TickPlacement="BottomRight"
                            TickFrequency="10"
                            Value="30" />
                        <jv:Slider
                            Height="180"
                            Orientation="Vertical"
                            TickFrequency="10"
                            TickPlacement="TopLeft"
                            Value="65" />
                        <jv:Slider
                            Height="180"
                            Margin="32,0,0,0"
                            IsEnabled="False"
                            Orientation="Vertical"
                            Value="35" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                        Text="数值框（ShowValueBox/ValueBoxSide/ValueFormatString）为 jv:Slider 专有；回车或失焦提交，越界自动夹取，非法文本还原显示；原生 Slider 仅有外观，数值框自动折叠。" />
                </StackPanel>
            </jv:GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
