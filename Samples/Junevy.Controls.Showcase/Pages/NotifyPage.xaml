<UserControl
    x:Class="Junevy.Controls.Showcase.Pages.NotifyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties;assembly=Junevy.Controls"
    xmlns:jv="github.com.junevy">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1080">
            <StackPanel.Resources>
                <!--  内容自适应场景关闭等比缩放（jv:Button 默认 IsTextScaled=True 会占满可用空间）  -->
                <Style BasedOn="{StaticResource {x:Type jv:Button}}" TargetType="{x:Type jv:Button}">
                    <Setter Property="IsTextScaled" Value="False" />
                </Style>
            </StackPanel.Resources>

            <TextBlock FontSize="20" FontWeight="Bold" Text="通知" />
            <TextBlock
                Margin="0,4,0,4"
                FontSize="12"
                Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                Text="jv:Badge / jv:MessageBar / MessageBarService（宿主已注册在主窗口底部，可通过本页按钮弹出通知）。" />

            <jv:GroupBox Header="jv:Badge（角标）">
                <StackPanel>
                    <WrapPanel>
                    <jv:Badge Count="5">
                        <jv:Button atc:Icon.FontFamily="{DynamicResource IconFont}" atc:Icon.Icon="&#xE932;" Content="消息" />
                    </jv:Badge>
                    <jv:Badge
                        Margin="16,0,0,0"
                        Count="1"
                        IsDot="True">
                        <jv:Button Content="更新" />
                    </jv:Badge>
                    <jv:Badge Margin="16,0,0,0" Count="99" MaxCount="9">
                        <jv:Button Content="MaxCount=9" />
                    </jv:Badge>
                    <jv:Badge Count="3" OffsetX="-4" OffsetY="4">
                        <jv:Button Content="偏移微调" />
                    </jv:Badge>
                    <jv:Badge Margin="16,0,0,0" Count="6" Corner="TopLeft">
                        <Border
                            Padding="10"
                            Background="{DynamicResource Theme.Brush.Surface.Raised}"
                            BorderBrush="{DynamicResource Theme.Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <TextBlock
                                FontFamily="{DynamicResource IconFont}"
                                FontSize="18"
                                Foreground="{DynamicResource Theme.Brush.Text.Primary}"
                                Text="&#xE66B;" />
                        </Border>
                    </jv:Badge>
                    <jv:Badge Margin="16,0,0,0" Count="8" Corner="BottomRight">
                        <Border
                            Padding="10"
                            Background="{DynamicResource Theme.Brush.Surface.Raised}"
                            BorderBrush="{DynamicResource Theme.Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <TextBlock
                                FontFamily="{DynamicResource IconFont}"
                                FontSize="18"
                                Foreground="{DynamicResource Theme.Brush.Text.Primary}"
                                Text="&#xE60C;" />
                        </Border>
                    </jv:Badge>
                </WrapPanel>
                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                        Text="注意：Badge 隐式样式将 Foreground 设为 Text.OnAccent（白色），包裹的内容若依赖继承前景色需显式设置；角标以自身中心对准内容角落，相邻控件的角标可能互相遮挡。" />
                </StackPanel>
            </jv:GroupBox>

            <jv:GroupBox Header="jv:MessageBar（布局内直接声明，IsShown 控制）" Margin="0,16,0,0">
                <StackPanel>
                    <jv:MessageBar
                        x:Name="InlineBar"
                        Appearance="Warning"
                        IsShown="True"
                        Message="场景亮度低于目标值，请检查光源。"
                        Timeout="0"
                        Title="低曝光" />
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <jv:Button Click="OnInlineShowClick" Content="Show()" />
                        <jv:Button Margin="12,0,0,0" Click="OnInlineHideClick" Content="Hide()" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                        Text="Timeout=0 表示禁用自动关闭；请通过 IsShown / Show() / Hide() 控制显隐，不要直接设置 Visibility/Opacity/RenderTransform。" />
                </StackPanel>
            </jv:GroupBox>

            <jv:GroupBox Header="MessageBarService（应用级弹出，宿主在主窗口底部）" Margin="0,16,0,0">
                <WrapPanel>
                    <jv:Button Click="OnServiceInfoClick" Content="Informational" />
                    <jv:Button Margin="12,0,0,0" Click="OnServiceSuccessClick" Content="Success" />
                    <jv:Button Margin="12,0,0,0" Click="OnServiceWarningClick" Content="Warning" />
                    <jv:Button Margin="12,0,0,0" Click="OnServiceDangerClick" Content="Danger（5 秒超时）" />
                    <jv:Button Margin="12,0,0,0" Click="OnServiceClearClick" Content="Clear()" />
                </WrapPanel>
            </jv:GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
