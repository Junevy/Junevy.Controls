<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
		<Nullable>enable</Nullable>
		<LangVersion>14</LangVersion>
		<UseWPF>true</UseWPF>
		<ImplicitUsings>enable</ImplicitUsings>
		<DefaultItemExcludes>$(DefaultItemExcludes);Samples\**\*;Tools\DebugProbe\**\*;Companion\**\*</DefaultItemExcludes>

		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>Junevy.Controls</PackageId>
		<Version>3.2.0</Version>
		<Authors>Junevy</Authors>
		<Company>Junevy</Company>
		<Description>Junevy WPF Controls</Description>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net48'">
		<Reference Include="System.Xaml" />
		<Reference Include="WindowsBase" />
		<Reference Include="PresentationCore" />
		<Reference Include="PresentationFramework" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="Controls\Menu\MenuItem.NodeType.cs" />
		<Compile Remove="Samples\**\*.cs" />
		<Page Remove="Samples\**\*.xaml" />
		<ApplicationDefinition Remove="Samples\**\*.xaml" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Resources\Font\iconfont-filled.ttf" />
	  <None Remove="Resources\Font\iconfont.ttf" />
	  <None Remove="Resources\Pictures\Author.png" />
	  <None Remove="Resources\Pictures\bullseye.png" />
	  <None Remove="Resources\Pictures\camera.png" />
	  <None Remove="Resources\Pictures\github_dark.png" />
	  <None Remove="Resources\Pictures\github_light.png" />
	  <None Remove="Resources\Pictures\whiteCheckBoard_big.png" />
	</ItemGroup>

	<ItemGroup>
	  <Page Remove="Resources\Font\IconFont.xaml" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Controls\Menu\MenuItem.NodeType.cs" />
	</ItemGroup>

	<ItemGroup>
  <Resource Include="Resources\Font\iconfont-filled.ttf">
    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
  </Resource>
  <Resource Include="Resources\Font\iconfont.ttf">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Resource>
  <Resource Include="Resources\Font\IconFont.xaml">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Resource>
	  <Resource Include="Resources\Pictures\Author.png">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Resource>
	  <Resource Include="Resources\Pictures\bullseye.png">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Resource>
	  <Resource Include="Resources\Pictures\camera.png">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Resource>
	  <Resource Include="Resources\Pictures\github_dark.png">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Resource>
	  <Resource Include="Resources\Pictures\github_light.png">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Resource>
	  <Resource Include="Resources\Pictures\whiteCheckBoard_big.png">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Resource>
	</ItemGroup>


	<ItemGroup>
		<Page Update="Themes\Generic.xaml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Page>
	</ItemGroup>


	<ItemGroup>
	  <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
	</ItemGroup>

</Project>
