<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
		<Nullable>enable</Nullable>
		<LangVersion>12</LangVersion>
		<UseWPF>true</UseWPF>
		<ImplicitUsings>enable</ImplicitUsings>

		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>Junevy.Controls</PackageId>
		<Version>1.0.0</Version>
		<Authors>Junevy</Authors>
		<Company>Junevy</Company>
		<Description>Junevy WPF Controls</Description>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net48'">
		<Reference Include="System.Xaml" />
		<Reference Include="WindowsBase" />
		<Reference Include="PresentationCore" />
		<Reference Include="PresentationFramework" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="Controls\Menu\MenuItem.NodeType.cs" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Controls\Menu\MenuItem.NodeType.cs" />
	</ItemGroup>


	<ItemGroup>
		<Page Update="Themes\Generic.xaml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Page>
	</ItemGroup>

</Project>
